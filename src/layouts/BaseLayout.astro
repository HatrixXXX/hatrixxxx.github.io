---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import ProtectedContent from '@/components/ProtectedContent.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import MusicPlayer from '@/components/MusicPlayer.astro';
import SearchOverlay from '@/components/SearchOverlay.astro';
import PageLoader from '@/components/PageLoader.astro';
import SakanaCharacters from '@/components/SakanaCharacters.astro';
import { isConfiguredLockedPage } from '@/config/protected-content';
import { SITE } from '@/config/site';
import { CONTENT_SECURITY_POLICY, REFERRER_POLICY } from '@/config/security';
import { buildSiteStats, formatRunningDurationAt, type BuiltSiteStats } from '@/lib/site-stats';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import ibmPlexMono400Url from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import ibmPlexMono700Url from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-700-normal.woff2?url';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/prose.css';
import '@/styles/protected-content.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  preloadImage?: boolean;
  bodyClass?: string;
  canonicalPath?: string;
  noindex?: boolean;
  locked?: boolean;
  pageKind?: 'default' | 'home';
  showFooter?: boolean;
  showPageLoader?: boolean;
  siteFooterStats?: {
    postCount: BuiltSiteStats['postCount'];
    wordCount: BuiltSiteStats['wordCount'];
    runningDuration: string;
  };
}

const {
  title,
  description = SITE.description,
  image = '/assets/home/cover.webp',
  preloadImage = true,
  bodyClass,
  canonicalPath,
  noindex = false,
  locked = false,
  pageKind = 'default',
  showFooter = false,
  showPageLoader = true,
  siteFooterStats
} = Astro.props;

const posts = await getCollection('posts');
const builtSiteStats = posts.length === 0 ? null : buildSiteStats(posts);
const defaultFooterStats = {
  postCount: builtSiteStats?.postCount ?? 0,
  wordCount: builtSiteStats?.wordCount ?? 0,
  runningDuration: formatRunningDurationAt(new Date())
};
const footerStats = siteFooterStats ?? defaultFooterStats;

const isHome = pageKind === 'home';
const pageBackgroundSrc = '/assets/backgrounds/background.png';
const pageBgStyle = !isHome ? `--page-bg-image: url("${pageBackgroundSrc}")` : undefined;
const isAboutPage = Astro.url.pathname === '/about' || Astro.url.pathname.startsWith('/about/');
const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE.url);
const socialImage = new URL(image, SITE.url);
const pageLocked = locked || isConfiguredLockedPage(Astro.url.pathname);
const excludeFromIndex = pageLocked || noindex;
const showSakanaCharacters = isAboutPage;
---

<!doctype html>
<html lang="zh-CN" data-page-kind={isHome ? 'home' : undefined} data-page-loader={showPageLoader ? undefined : 'disabled'} transition:animate="none">
  <head>
    {
      import.meta.env.PROD && (
        <meta http-equiv="Content-Security-Policy" content={CONTENT_SECURITY_POLICY} />
      )
    }
    <meta name="referrer" content={REFERRER_POLICY} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (root.dataset.pageLoader === 'disabled') return;
        if (root.dataset.pageKind !== 'home') root.dataset.pageBackground = 'loading';
        root.dataset.initialPageLoaderStartedAt = String(Date.now());
        root.dataset.initialPageLoader = 'visible';
        if (root.dataset.pageKind === 'home') return;
        window.setTimeout(() => {
          if (root.dataset.initialPageLoader === 'visible') {
            root.dataset.initialPageLoader = 'expired';
          }
        }, 8_000);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {excludeFromIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#17151d" />
    <meta name="msvalidate.01" content={SITE.verification.bing} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/icons/favicon-transparent.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <link rel="preload" href="/assets/transitions/mecha-shutter-v1.webp" as="image" fetchpriority="low" />
    <link rel="preload" href={ibmPlexMono400Url} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={ibmPlexMono700Url} as="font" type="font/woff2" crossorigin="anonymous" />
    {!isHome && <link rel="preload" href={pageBackgroundSrc} as="image" fetchpriority="high" />}
    {(Astro.url.pathname === '/blogs/' || Astro.url.pathname === '/sanctuary/') && (
      <>
        <link rel="preload" href="/assets/blog-cards/desktop-frame.webp" as="image" media="(min-width: 721px)" />
        <link rel="preload" href="/assets/blog-cards/mobile-frame.webp" as="image" media="(max-width: 720px)" />
        <link rel="preload" href="/assets/blog-cards/guide-rail.webp" as="image" />
        <link rel="preload" href="/assets/blog-cards/locking-clamp.webp" as="image" media="(min-width: 721px)" />
      </>
    )}
    {preloadImage && image !== '/assets/home/cover.webp' && <link rel="preload" href={image} as="image" fetchpriority="high" />}
  </head>
  <body class={bodyClass} style={pageBgStyle}>
    {showPageLoader && <PageLoader />}
    <span data-magnetic-frame aria-hidden="true"></span>
    {!isHome && <SiteHeader />}
    <ProtectedContent locked={pageLocked} route={Astro.url.pathname} title={title}>
      <slot />
    </ProtectedContent>
    {showFooter && <SiteFooter stats={footerStats} />}
    {!isHome && showSakanaCharacters && <SakanaCharacters />}
    <SearchOverlay />
    {!isHome && <MusicPlayer mode="dock" />}
    <span
      id="vercount_value_site_uv"
      data-visitor-count-source
      class="visually-hidden"
      transition:persist="visitor-counter"
    >—</span>
    {import.meta.env.PROD && <script is:inline defer src="https://events.vercount.one/js"></script>}
    <script>
      import '@/scripts/lightbox';
      import '@/scripts/music-player';
      import '@/scripts/navigation';
      import '@/scripts/smooth-scroll';
      import '@/scripts/nested-smooth-scroll';
      import '@/scripts/magnetic-pointer';
      import '@/scripts/twikoo';
      import '@/scripts/protected-content-bootstrap';
      import '@/scripts/search';
      import '@/scripts/search-highlight';
      import '@/scripts/site-stats';
      import '@/scripts/page-loader';
      import '@/scripts/document-title';

      const loadPlanCoverflow = () => {
        if (location.pathname === '/sanctuary/') void import('@/scripts/post-coverflow');
      };
      document.addEventListener('astro:page-load', loadPlanCoverflow);
      loadPlanCoverflow();
    </script>
    {showSakanaCharacters && (
      <script>
        </script>
    )}
  </body>
</html>


