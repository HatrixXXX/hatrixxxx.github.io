---
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import GiscusComments from '@/components/GiscusComments.astro';
import BackButton from '@/components/BackButton.astro';
import PostLink from '@/components/PostLink.astro';
import PostMeta from '@/components/PostMeta.astro';
import ProtectedContent from '@/components/ProtectedContent.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import LatestPostRail from '@/components/LatestPostRail.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { AdjacentPosts, PostEntry } from '@/lib/content';
import { buildSiteStats, formatRunningDurationAt } from '@/lib/site-stats';
import { postPath } from '@/lib/urls';
import { latestPostLimit } from '@/lib/post-layout';
import { SITE } from '@/config/site';
import { POST_TYPE_LINKS } from '@/config/navigation';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  adjacent: AdjacentPosts;
}

const { post, headings, adjacent } = Astro.props;
const canonicalPath = postPath(post.data.legacySlug);
const posts = await getCollection('posts', ({ data }: PostEntry) => !data.draft);
const stats = buildSiteStats(posts);
const parentTypeLink = POST_TYPE_LINKS.find(({ label }) => label === post.data.type)?.href ?? '/blog/';

---

<BaseLayout
  title={post.data.title}
  description={SITE.description}
  image={post.data.cover}
  canonicalPath={canonicalPath}
  bodyClass="post-page"
  noindex={post.data.locked}
  siteFooterStats={{
    postCount: stats.postCount,
    wordCount: stats.wordCount,
    runningDuration: formatRunningDurationAt(new Date())
  }}
>
  <BackButton href={parentTypeLink} label={`返回${post.data.type}`} />
  <article data-post>
    <div class="post-intro container">
      <h1>{post.data.title}</h1>
      <PostMeta post={post} />
    </div>

    <ProtectedContent locked={post.data.locked} route={canonicalPath} title={post.data.title}>
      <div class="post-grid container" data-cursor-trail-region>
        <div class="post-column">
          <div class="prose">
            <slot />
          </div>

          <nav class="adjacent-posts" aria-label="相邻文章" data-adjacent-posts>
            {
              adjacent.previous ? (
                <PostLink post={adjacent.previous} rel="prev" direction="上一篇" />
              ) : (
                <span aria-hidden="true" />
              )
            }
            {
              adjacent.next && (
                <PostLink post={adjacent.next} rel="next" direction="下一篇" />
              )
            }
          </nav>

          <GiscusComments />
        </div>
        <aside class="post-sidebar"><TableOfContents headings={headings} /><LatestPostRail posts={posts} limit={latestPostLimit(headings.length)} /></aside>
      </div>
    </ProtectedContent>
  </article>
</BaseLayout>

<script>
  import '@/scripts/mermaid';
  import '@/scripts/toc';
</script>

<style>
  .post-intro h1 {
    max-width: 900px;
    margin: 0;
    color: var(--color-heading, #fff);
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    margin-top: 1rem;
  }

  .post-intro {
    width: min(calc(100% - 48px), calc(var(--reading-width) + 280px));
    padding-top: 4rem;
    text-align: left;
  }

  .post-intro :global(.post-meta) {
    color: var(--color-muted);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    width: min(calc(100% - 48px), 1440px);
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }

  .post-column {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .post-sidebar { grid-column: 1; grid-row: 2; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 1.75rem; align-content: start; }

  .prose {
    min-width: 0;
  }

  .prose :global(img) {
    margin-inline: auto;
  }

  .prose :global(.katex-display),
  .prose :global(.mermaid) {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .adjacent-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .adjacent-posts :global(a) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: var(--color-surface);
  }

  .adjacent-posts :global(a:last-child) {
    text-align: right;
  }

  .adjacent-posts :global(a > span) {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .adjacent-posts :global(a > strong) {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .adjacent-posts :global(a:hover > strong) {
    color: var(--color-accent);
  }

  @media (min-width: 1280px) {
    .post-grid {
      width: min(calc(100% - 48px), calc(var(--reading-width) + 280px));
      grid-template-columns: minmax(0, var(--reading-width)) minmax(240px, 280px);
    }

    .post-column {
      grid-column: 1;
      grid-row: 1;
    }

    .post-sidebar {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 1.25rem;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      max-height: min(38rem, calc(100vh - 2.5rem));
      overflow: hidden;
    }

    .post-sidebar :global(.toc),
    .post-sidebar :global(.latest-posts) {
      min-height: 0;
    }
  }

  @media (max-width: 768px) {
    .post-intro {
      width: min(calc(100% - 32px), var(--content-width));
      padding-top: 3rem;
    }
    .post-grid {
      width: min(calc(100% - 32px), 1440px);
    }
  }

  @media (max-width: 1279px) {
    .post-sidebar { position: static; max-height: none; overflow: visible; }
  }

  @media (max-width: 600px) {
    .adjacent-posts {
      grid-template-columns: minmax(0, 1fr);
    }

    .adjacent-posts > span {
      display: none;
    }

    .adjacent-posts :global(a:last-child) {
      text-align: left;
    }
  }
</style>
