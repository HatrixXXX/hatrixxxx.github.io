---
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import GiscusComments from '@/components/GiscusComments.astro';
import PostLink from '@/components/PostLink.astro';
import PostMeta from '@/components/PostMeta.astro';
import ProtectedContent from '@/components/ProtectedContent.astro';
import SidebarStack from '@/components/SidebarStack.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { AdjacentPosts, PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  adjacent: AdjacentPosts;
}

const { post, headings, adjacent } = Astro.props;
const canonicalPath = postPath(post.data.legacySlug);
const posts = await getCollection('posts', ({ data }: PostEntry) => !data.draft);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  canonicalPath={canonicalPath}
  bodyClass="post-page"
  noindex={post.data.locked}
>
  <article data-post>
    <header class="post-hero" data-hero>
      <img src={post.data.cover} alt="" width="1600" height="900" decoding="async" />
      <div class="post-hero-overlay"></div>
      <div class="post-hero-content container">
        <h1>{post.data.title}</h1>
      </div>
    </header>

    <div class="post-intro container">
      <Breadcrumbs title={post.data.title} />
      <p>{post.data.description}</p>
      <PostMeta post={post} />
    </div>

    <ProtectedContent locked={post.data.locked} route={canonicalPath} title={post.data.title}>
      <div class="post-grid container" data-cursor-trail-region>
        <TableOfContents headings={headings} />
        <div class="post-column">
          <div class="prose">
            <slot />
          </div>

          <nav class="adjacent-posts" aria-label="相邻文章" data-adjacent-posts>
            {
              adjacent.previous ? (
                <PostLink post={adjacent.previous} rel="prev" direction="上一篇" />
              ) : (
                <span aria-hidden="true" />
              )
            }
            {
              adjacent.next && (
                <PostLink post={adjacent.next} rel="next" direction="下一篇" />
              )
            }
          </nav>

          <GiscusComments />
        </div>
        <SidebarStack posts={posts} />
      </div>
    </ProtectedContent>
  </article>
</BaseLayout>

<script>
  import '@/scripts/mermaid';
  import '@/scripts/toc';
</script>

<style>
  .post-hero {
    position: relative;
    display: grid;
    height: var(--inner-page-banner-height);
    place-items: center;
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .post-hero > img,
  .post-hero-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
  }

  .post-hero > img {
    object-fit: cover;
  }

  .post-hero-overlay {
    background: linear-gradient(to bottom, rgb(10 12 16 / 45%), rgb(22 26 32 / 94%));
    pointer-events: none;
  }

  .post-hero-content {
    position: relative;
    z-index: 1;
    padding-block: calc(var(--header-height) + 1rem) 1rem;
    text-align: center;
    pointer-events: none;
  }

  article :global(img[data-lightbox-image]) {
    cursor: zoom-in;
  }

  h1 {
    max-width: 900px;
    margin: 0 auto;
    color: #fff;
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-shadow: 0 4px 22px rgb(0 0 0 / 55%);
  }

  .post-intro {
    padding-top: 1.5rem;
    text-align: center;
  }

  .post-intro > p {
    max-width: 720px;
    margin: 0.75rem auto;
    color: var(--color-muted);
  }

  .post-intro :global(.breadcrumbs ol),
  .post-intro :global(.breadcrumbs li:not(:last-child)::after),
  .post-intro :global(.post-meta) {
    color: var(--color-muted);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    width: min(calc(100% - 48px), 1440px);
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }

  .post-column {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
  }

  .post-grid :global([data-sidebar-stack]) {
    grid-column: 1;
    grid-row: 3;
  }

  .prose {
    min-width: 0;
  }

  .prose :global(.katex-display),
  .prose :global(.mermaid) {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .adjacent-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .adjacent-posts :global(a) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: var(--color-surface);
  }

  .adjacent-posts :global(a:last-child) {
    text-align: right;
  }

  .adjacent-posts :global(a > span) {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .adjacent-posts :global(a > strong) {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .adjacent-posts :global(a:hover > strong) {
    color: var(--color-accent);
  }

  @media (min-width: 1280px) {
    .post-grid {
      grid-template-columns: minmax(240px, 280px) minmax(0, 1fr) minmax(220px, 280px);
    }

    .post-column {
      grid-column: 2;
      grid-row: 1;
    }

    .post-grid :global([data-sidebar-stack]) {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 768px) {
    .post-grid {
      width: min(calc(100% - 32px), 1440px);
    }
  }

  @media (max-width: 600px) {
    .adjacent-posts {
      grid-template-columns: minmax(0, 1fr);
    }

    .adjacent-posts > span {
      display: none;
    }

    .adjacent-posts :global(a:last-child) {
      text-align: left;
    }
  }
</style>
