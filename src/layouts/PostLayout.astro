---
import 'katex/dist/katex.min.css';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import GiscusComments from '@/components/GiscusComments.astro';
import PostMeta from '@/components/PostMeta.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { AdjacentPosts, PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  adjacent: AdjacentPosts;
}

const { post, headings, adjacent } = Astro.props;
const canonicalPath = postPath(post.data.legacySlug);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  canonicalPath={canonicalPath}
  bodyClass="post-page"
>
  <article data-post>
    <header class="post-hero" data-hero>
      <img src={post.data.cover} alt="" width="1600" height="900" decoding="async" />
      <div class="post-hero-overlay"></div>
      <div class="post-hero-content container">
        <h1>{post.data.title}</h1>
      </div>
    </header>

    <div class="post-intro container">
      <Breadcrumbs title={post.data.title} />
      <p>{post.data.description}</p>
      <PostMeta post={post} />
    </div>

    <div class="post-grid container" data-cursor-trail-region>
      <TableOfContents headings={headings} />
      <div class="post-column">
        <div class="prose">
          <slot />
        </div>

        <nav class="adjacent-posts" aria-label="相邻文章" data-adjacent-posts>
          {
            adjacent.previous ? (
              <a href={postPath(adjacent.previous.data.legacySlug)} rel="prev">
                <span>上一篇</span>
                <strong>{adjacent.previous.data.title}</strong>
              </a>
            ) : (
              <span aria-hidden="true" />
            )
          }
          {
            adjacent.next && (
              <a href={postPath(adjacent.next.data.legacySlug)} rel="next">
                <span>下一篇</span>
                <strong>{adjacent.next.data.title}</strong>
              </a>
            )
          }
        </nav>

        <GiscusComments />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '@/scripts/mermaid';
  import '@/scripts/toc';
</script>

<style>
  .post-hero {
    position: relative;
    display: grid;
    height: var(--inner-page-banner-height);
    place-items: center;
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .post-hero > img,
  .post-hero-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
  }

  .post-hero > img {
    object-fit: cover;
  }

  .post-hero-overlay {
    background: linear-gradient(to bottom, rgb(10 12 16 / 45%), rgb(22 26 32 / 94%));
    pointer-events: none;
  }

  .post-hero-content {
    position: relative;
    z-index: 1;
    padding-block: calc(var(--header-height) + 1rem) 1rem;
    text-align: center;
    pointer-events: none;
  }

  article :global(img[data-lightbox-image]) {
    cursor: zoom-in;
  }

  h1 {
    max-width: 900px;
    margin: 0 auto;
    color: #fff;
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-shadow: 0 4px 22px rgb(0 0 0 / 55%);
  }

  .post-intro {
    padding-top: 1.5rem;
    text-align: center;
  }

  .post-intro > p {
    max-width: 720px;
    margin: 0.75rem auto;
    color: var(--color-muted);
  }

  .post-intro :global(.breadcrumbs ol),
  .post-intro :global(.breadcrumbs li:not(:last-child)::after),
  .post-intro :global(.post-meta) {
    color: var(--color-muted);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }

  .post-column {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .prose {
    min-width: 0;
  }

  .prose :global(.katex-display),
  .prose :global(.mermaid) {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .adjacent-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .adjacent-posts a {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: var(--color-surface);
  }

  .adjacent-posts a:last-child {
    text-align: right;
  }

  .adjacent-posts span {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .adjacent-posts strong {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .adjacent-posts a:hover strong {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-column {
      grid-row: 2;
    }
  }

  @media (max-width: 600px) {
    .adjacent-posts {
      grid-template-columns: minmax(0, 1fr);
    }

    .adjacent-posts > span {
      display: none;
    }

    .adjacent-posts a:last-child {
      text-align: left;
    }
  }
</style>
