---
import 'katex/dist/katex.min.css';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import GiscusComments from '@/components/GiscusComments.astro';
import LockIndicator from '@/components/LockIndicator.astro';
import PostMeta from '@/components/PostMeta.astro';
import ProtectedContent from '@/components/ProtectedContent.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { AdjacentPosts, PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  adjacent: AdjacentPosts;
}

const { post, headings, adjacent } = Astro.props;
const canonicalPath = postPath(post.data.legacySlug);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  canonicalPath={canonicalPath}
  bodyClass="post-page"
  noindex={post.data.locked}
>
  <article data-post>
    <header class="post-hero">
      <img src={post.data.cover} alt="" width="1600" height="900" decoding="async" />
      <div class="post-hero-overlay"></div>
      <div class="post-hero-content container">
        <Breadcrumbs title={post.data.title} />
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <PostMeta post={post} />
      </div>
    </header>

    <ProtectedContent locked={post.data.locked} route={canonicalPath} title={post.data.title}>
      <div class="post-grid container">
        <TableOfContents headings={headings} />
        <div class="post-column">
          <div class="prose">
            <slot />
          </div>

          <nav class="adjacent-posts" aria-label="相邻文章" data-adjacent-posts>
            {
              adjacent.previous ? (
                <a
                  href={postPath(adjacent.previous.data.legacySlug)}
                  rel="prev"
                  data-locked-link={adjacent.previous.data.locked ? '' : undefined}
                >
                  <span>上一篇</span>
                  <strong>
                    {adjacent.previous.data.title}
                    {adjacent.previous.data.locked && <LockIndicator />}
                  </strong>
                </a>
              ) : (
                <span aria-hidden="true" />
              )
            }
            {
              adjacent.next && (
                <a
                  href={postPath(adjacent.next.data.legacySlug)}
                  rel="next"
                  data-locked-link={adjacent.next.data.locked ? '' : undefined}
                >
                  <span>下一篇</span>
                  <strong>
                    {adjacent.next.data.title}
                    {adjacent.next.data.locked && <LockIndicator />}
                  </strong>
                </a>
              )
            }
          </nav>

          <GiscusComments />
        </div>
      </div>
    </ProtectedContent>
  </article>
</BaseLayout>

<script>
  import '@/scripts/mermaid';
  import '@/scripts/toc';
</script>

<style>
  .post-hero {
    position: relative;
    display: grid;
    min-height: clamp(360px, 54vw, 620px);
    place-items: center;
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .post-hero > img,
  .post-hero-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
  }

  .post-hero > img {
    object-fit: cover;
  }

  .post-hero-overlay {
    background: linear-gradient(to bottom, rgb(10 12 16 / 45%), rgb(22 26 32 / 94%));
    pointer-events: none;
  }

  .post-hero-content {
    position: relative;
    z-index: 1;
    padding-block: calc(var(--header-height) + 3rem) 4rem;
    text-align: center;
    pointer-events: none;
  }

  .post-hero-content :global(a) {
    pointer-events: auto;
  }

  article :global(img[data-lightbox-image]) {
    cursor: zoom-in;
  }

  h1 {
    max-width: 900px;
    margin: 0.8rem auto 0;
    color: #fff;
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-shadow: 0 4px 22px rgb(0 0 0 / 55%);
  }

  .post-hero-content > p {
    max-width: 720px;
    margin: 1rem auto;
    color: rgb(255 255 255 / 82%);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .post-column {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .prose {
    min-width: 0;
  }

  .prose :global(.katex-display),
  .prose :global(.mermaid) {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .adjacent-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .adjacent-posts a {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: var(--color-surface);
  }

  .adjacent-posts a:last-child {
    text-align: right;
  }

  .adjacent-posts span {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .adjacent-posts strong {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .adjacent-posts a:hover strong {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-column {
      grid-row: 2;
    }
  }

  @media (max-width: 600px) {
    .adjacent-posts {
      grid-template-columns: minmax(0, 1fr);
    }

    .adjacent-posts > span {
      display: none;
    }

    .adjacent-posts a:last-child {
      text-align: left;
    }
  }
</style>
