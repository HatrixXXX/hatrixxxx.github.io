---
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import TwikooComments from '@/components/TwikooComments.astro';
import BackButton from '@/components/BackButton.astro';
import BackToTop from '@/components/BackToTop.astro';
import PostLink from '@/components/PostLink.astro';
import PostMeta from '@/components/PostMeta.astro';
import ProtectedContent from '@/components/ProtectedContent.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import LatestPostRail from '@/components/LatestPostRail.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { AdjacentPosts, PostEntry } from '@/lib/content';
import { buildSiteStats, formatRunningDurationAt } from '@/lib/site-stats';
import { postPath } from '@/lib/urls';
import { latestPostLimit } from '@/lib/post-layout';
import { SITE } from '@/config/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  adjacent: AdjacentPosts;
}

const { post, headings, adjacent } = Astro.props;
const canonicalPath = postPath(post.data.legacySlug);
const posts = await getCollection('posts');
const stats = buildSiteStats(posts);

---

<BaseLayout
  title={post.data.title}
  description={SITE.description}
  image={post.data.cover}
  showFooter={true}
  canonicalPath={canonicalPath}
  bodyClass="post-page"
  noindex={post.data.locked}
  siteFooterStats={{
    postCount: stats.postCount,
    wordCount: stats.wordCount,
    runningDuration: formatRunningDurationAt(new Date())
  }}
>
  <BackButton href="/blogs/" label="返回博客文章" belowHeader={true} />
  <article data-post>
    <div class="post-intro container">
      <h1>{post.data.title}</h1>
      <PostMeta post={post} />
    </div>

    <ProtectedContent locked={post.data.locked} route={canonicalPath} title={post.data.title}>
      <div class="post-grid container">
        <div class="post-column">
          <div class="prose">
            <slot />
          </div>

          <nav class="adjacent-posts" aria-label="相邻文章" data-adjacent-posts>
            {
              adjacent.previous ? (
                <PostLink post={adjacent.previous} rel="prev" direction="上一篇" />
              ) : (
                <span aria-hidden="true" />
              )
            }
            {
              adjacent.next && (
                <PostLink post={adjacent.next} rel="next" direction="下一篇" />
              )
            }
          </nav>

          <TwikooComments />
        </div>
        <aside class="post-sidebar"><TableOfContents headings={headings} /><LatestPostRail posts={posts} limit={latestPostLimit(headings.length)} /></aside>
      </div>
    </ProtectedContent>
  </article>
  <BackToTop />
</BaseLayout>

<script>
  import '@/scripts/back-to-top';
  import '@/scripts/mermaid';
  import '@/scripts/post-sidebar';
  import '@/scripts/toc';
</script>

<style>
  .post-intro h1 {
    max-width: 900px;
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    font-weight: 650;
    line-height: 1.15;
    overflow-wrap: anywhere;
    margin-top: 1rem;
  }

  .post-intro {
    position: relative;
    width: min(calc(100% - 48px), calc(var(--reading-width) + 280px));
    padding-top: 4rem;
    padding-left: clamp(1rem, 2vw, 1.5rem);
    border-left: 1px solid var(--chassis-edge);
    text-align: left;
  }

  .post-intro::before {
    content: '';
    position: absolute;
    top: 3.35rem;
    left: -1px;
    width: min(46%, 340px);
    height: 3px;
    background: linear-gradient(90deg, var(--color-copper), var(--color-accent) 24%, transparent);
    box-shadow: 0 5px 16px rgb(255 210 0 / 16%);
  }

  .post-intro::after {
    content: '';
    position: absolute;
    top: 3.02rem;
    left: -8px;
    width: 16px;
    height: 16px;
    border: 1px solid var(--chassis-edge);
    background: var(--color-link);
    box-shadow: inset 0 0 0 4px var(--chassis-groove), 0 0 12px rgb(0 221 235 / 32%);
    transform: rotate(45deg);
    pointer-events: none;
  }

  .post-intro h1,
  .post-intro :global(.post-meta) {
    position: relative;
    z-index: 1;
  }

  .post-intro :global(.post-meta) {
    color: var(--color-muted);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    width: min(calc(100% - 48px), 1440px);
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }

  .post-column {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .post-sidebar { grid-column: 1; grid-row: 2; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 1.75rem; align-content: start; }

  .prose {
    min-width: 0;
  }

  .prose :global(img) {
    margin-inline: auto;
  }

  .prose :global(.katex-display),
  .prose :global(.mermaid) {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .adjacent-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .adjacent-posts :global(a) {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    padding: 1rem;
    background: linear-gradient(110deg, rgb(0 221 235 / 6%), transparent 55%), var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset);
    transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .adjacent-posts :global(a::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 1rem;
    width: 65%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-copper), transparent);
    transform: scaleX(0.54);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out), background-color var(--duration-normal) ease;
  }

  .adjacent-posts :global(a:hover),
  .adjacent-posts :global(a:focus-visible) {
    border-color: var(--color-copper);
    background-color: var(--color-surface-raised);
  }

  .adjacent-posts :global(a:is(:hover, :focus-visible)::before) {
    background: linear-gradient(90deg, var(--color-accent), var(--color-link), transparent);
    transform: scaleX(1);
  }

  .adjacent-posts :global(a:last-child) {
    text-align: right;
  }

  .adjacent-posts :global(a > span) {
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .adjacent-posts :global(a > strong) {
    color: var(--color-heading);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .adjacent-posts :global(a:hover > strong) {
    color: var(--color-link);
  }

  @media (min-width: 1280px) {
    .post-grid {
      width: min(calc(100% - 48px), calc(var(--reading-width) + 280px));
      grid-template-columns: minmax(0, var(--reading-width)) minmax(240px, 280px);
    }

    .post-column {
      grid-column: 1;
      grid-row: 1;
    }

    .post-sidebar {
      grid-column: 2;
      grid-row: 1;
    }

    .post-sidebar[data-sidebar-fixed='true'] {
      position: fixed;
      z-index: 20;
      top: var(--post-sidebar-fixed-top);
      left: var(--post-sidebar-fixed-left);
      width: var(--post-sidebar-fixed-width);
    }
  }

  @media (max-width: 1199px) {
    .post-intro {
      padding-top: calc(var(--header-height) + 3.5rem);
    }
  }

  @media (max-width: 768px) {
    .post-intro {
      width: min(calc(100% - 32px), var(--content-width));
    }
    .post-grid {
      width: min(calc(100% - 32px), 1440px);
    }
  }


  @media (max-width: 600px) {
    .adjacent-posts {
      grid-template-columns: minmax(0, 1fr);
    }

    .adjacent-posts > span {
      display: none;
    }

    .adjacent-posts :global(a:last-child) {
      text-align: left;
    }
  }
</style>
