---
import { Image, getImage } from 'astro:assets';
import homeWorkshop from '@/assets/home/liupin-workshop-v5.png';
import homeCharacter from '@/assets/home/hatrix-character-v5.png';
import { SITE } from '@/config/site';
import { HOME_LINKS } from '@/config/navigation';
import { HOME_QUOTES } from '@/data/home-quotes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePanel from '@/components/HomePanel.astro';
import HomeIcon from '@/components/HomeIcon.astro';
import MusicPlayer from '@/components/MusicPlayer.astro';
import { projectPanel, type Point } from '@/lib/home-projection';

const clockTemplate = '0000/00/00 00:00:00';
const homeBackground = await getImage({ src: homeWorkshop, format: 'webp', quality: 65 });
// The left cards retain their subtle inward projection and tighter local gaps.
const leftPanels = {
  search: { width: 44, height: 44, corners: [[14, 16], [58, 16], [58, 60], [14, 60]] },
  identity: { width: 180, height: 180, corners: [[72, 395], [252, 395], [252, 575], [72, 575]] },
  quote: { width: 595, height: 110, corners: [[10, 696], [604.4, 668], [605.9, 762], [12, 775]] },
  music: { width: 380, height: 195, corners: [[12, 785], [387, 768], [392, 948], [15, 976]] },
  friends: { width: 208, height: 88, corners: [[399, 768], [606, 756], [607, 843], [401, 855]] },
  guestbook: { width: 208, height: 80, corners: [[402, 865], [607, 851], [608, 929], [404, 944]] }
} satisfies Record<string, { width: number; height: number; corners: [Point, Point, Point, Point] }>;

// Every right-side card is a rectangle on this ONE plane. Only the parent is projected.
const rightPlane = { width: 930, height: 952, corners: [[970, 120], [1910, 8], [1910, 1068], [970, 958]] } as const;
const rightTransform = `matrix3d(${projectPanel(rightPlane.width, rightPlane.height, rightPlane.corners).join(',')})`;
const rightPanels = {
  clock: { x: 110, y: 0, width: 820, height: 96 },
  blog: { x: 140, y: 108, width: 790, height: 286 },
  projects: { x: 110, y: 406, width: 380, height: 180 },
  about: { x: 502, y: 406, width: 428, height: 180 },
  recommendations: { x: 190, y: 598, width: 740, height: 180 },
  plans: { x: 120, y: 790, width: 399, height: 162 },
  lab: { x: 531, y: 790, width: 399, height: 162 }
};
---

<BaseLayout title={SITE.title} pageKind="home">
  <link rel="preload" href={homeBackground.src} as="image" />
  <main data-home-stage aria-labelledby="home-title" class="home-stage">
    <div class="home-canvas" data-home-canvas style={{ '--home-background-image': `url("${homeBackground.src}")` }}>
      <div class="character-space" data-home-character aria-hidden="true">
        <Image src={homeCharacter} alt="" class="home-character" format="webp" quality={75} width={1640} loading="eager" decoding="async" fetchpriority="high" draggable="false" />
      </div>
      <div class="home-side home-side--left" data-home-side="left">
        <HomePanel name="search" {...leftPanels.search}>
          <button class="search-button" type="button" data-open-search aria-label="搜索文章">
            <HomeIcon name="search" />
          </button>
        </HomePanel>
        <HomePanel name="identity" {...leftPanels.identity}>
          <h1 id="home-title" class="visually-hidden" data-home-title>Hatrix</h1>
          <div class="level-badge" data-home-level role="meter" aria-label="等级年度进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="启用 JavaScript 后显示等级">
            <svg class="level-ring" viewBox="0 0 180 180" aria-hidden="true">
              <circle class="level-track" cx="90" cy="90" r="84" />
              <circle class="level-progress" data-level-progress cx="90" cy="90" r="84" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 90 90)" />
            </svg>
            <div class="level-readout" aria-hidden="true">
              <span class="level-number" data-level-number>—</span>
              <span class="level-label">LV</span>
            </div>
          </div>
          <noscript><p class="level-fallback">启用 JavaScript 后显示等级</p></noscript>
        </HomePanel>
        <HomePanel name="quote" {...leftPanels.quote}>
          <div class="quote-card">
            <button type="button" class="quote-switch" data-home-quote aria-label={`金句：${HOME_QUOTES[0]}。双击切换；键盘按 Enter 或空格切换`} title="双击切换金句">
              <span class="quote-window"><span data-quote-text>{HOME_QUOTES[0]}</span></span>
            </button>
          </div>
        </HomePanel>
        <HomePanel name="music" {...leftPanels.music}>
          <MusicPlayer mode="home" />
        </HomePanel>
        <HomePanel name="friends" {...leftPanels.friends}>
          <a class="tile small-tile" data-astro-prefetch="tap" href={HOME_LINKS.friends.href}><HomeIcon name="friends" /><span>友链</span></a>
        </HomePanel>
        <HomePanel name="guestbook" {...leftPanels.guestbook}>
          <a class="tile small-tile" data-astro-prefetch="tap" href={HOME_LINKS.guestbook.href}><HomeIcon name="guestbook" /><span>留言板</span></a>
        </HomePanel>
      </div>
      <div class="home-side home-side--right" data-home-side="right">
        <div class="right-plane" data-home-plane="right" style={`width:${rightPlane.width}px;height:${rightPlane.height}px;transform:${rightTransform}`}>
          <HomePanel name="clock" {...rightPanels.clock}>
            <div class="clock-card">
              <time data-home-clock aria-label="正在读取本地时间">
                {Array.from(clockTemplate).map((character) => /\d/.test(character)
                  ? <span class="nixie-tube" data-clock-digit aria-hidden="true">—</span>
                  : <span class:list={['clock-separator', { 'clock-space': character === ' ' }]} aria-hidden="true">{character}</span>)}
              </time>
              <noscript><span class="clock-fallback">启用 JavaScript 后显示时间</span></noscript>
            </div>
          </HomePanel>
          <HomePanel name="blog" {...rightPanels.blog}>
            <a class="tile blog-tile" data-astro-prefetch="tap" data-home-blog href={HOME_LINKS.blog.href}>
              <HomeIcon name="blog" /><span>博客文章</span>
              <svg class="blog-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
            </a>
          </HomePanel>
          <HomePanel name="projects" {...rightPanels.projects}>
            <a class="tile" data-astro-prefetch="tap" href={HOME_LINKS.projects.href}><HomeIcon name="projects" /><span>作品橱窗</span></a>
          </HomePanel>
          <HomePanel name="about" {...rightPanels.about}>
            <a class="tile" data-astro-prefetch="tap" href={HOME_LINKS.about.href}><HomeIcon name="about" /><span>关于我</span></a>
          </HomePanel>
          <HomePanel name="recommendations" {...rightPanels.recommendations}>
            <section class="recommendations" aria-labelledby="recommendations-title">
              <h2 id="recommendations-title">工具推荐</h2>
              <a class="tile bookmark-tile" data-astro-prefetch="tap" href={HOME_LINKS.bookmarks.href}><HomeIcon name="bookmark" /><span>书签</span></a>
              <a class="tile software-tile" data-astro-prefetch="tap" href={HOME_LINKS.software.href}><HomeIcon name="software" /><span>软件</span></a>
              <a class="tile gear-tile" data-astro-prefetch="tap" href={HOME_LINKS.gear.href}><HomeIcon name="gear" /><span>装备</span></a>
            </section>
          </HomePanel>
          <HomePanel name="plans" {...rightPanels.plans}>
            <a class="tile" data-astro-prefetch="tap" href={HOME_LINKS.plans.href}><HomeIcon name="plans" /><span>计划</span></a>
          </HomePanel>
          <HomePanel name="lab" {...rightPanels.lab}>
            <a class="tile" data-astro-prefetch="tap" href={HOME_LINKS.lab.href}><HomeIcon name="lab" /><span>实验场</span></a>
          </HomePanel>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  :global(html[data-page-kind='home']), :global(html[data-page-kind='home'] body) {
    width: 100%; height: 100%; overflow: hidden; overscroll-behavior: none;
  }
  .home-stage {
    --home-paper: #17151d;
    --home-surface: #2e2934f2;
    --home-surface-hover: #403746;
    --home-ink: #e9e4dc;
    --home-accent: #c8a16f;
    --home-icon: #c8c0d0;
    position: fixed; inset: 0; overflow: hidden;
    background: var(--home-paper); color: var(--home-ink);
    font-family: 'Microsoft YaHei', 'PingFang SC', sans-serif;
    isolation: isolate;
  }
  .home-canvas {
    position: absolute; left: 50%; top: 50%; width: 1920px; height: 1080px;
    /* atan2 yields a unitless uniform scale, including with JavaScript disabled. */
    --home-scale: tan(atan2(min(100vw, 177.7777778dvh), 1920px));
    /* Compensate for ultrawide letterboxing in design pixels, without resizing either group. */
    --home-side-offset: max(0px, calc((tan(atan2(100vw, 100dvh)) * 1080 - 1920) * .5px));
    transform: translate(-50%, -50%) scale(var(--home-scale));
    transform-origin: center;
  }
  .home-canvas::before {
    content: ''; position: absolute; inset: 0 calc(-1 * var(--home-side-offset)); z-index: -2;
    background: var(--home-background-image) center / cover no-repeat; pointer-events: none;
  }
  .home-side { position: absolute; inset: 0; pointer-events: none; }
  .home-side--left { transform: translateX(calc(-1 * var(--home-side-offset))); }
  .home-side--right { transform: translateX(var(--home-side-offset)); }
  .home-side :global([data-home-panel]) { pointer-events: auto; }
  .right-plane { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
  /* Crop inside the design canvas so portrait letterboxing stays empty. */
  .character-space { position: absolute; z-index: -1; inset: 0; overflow: hidden; pointer-events: none; }
  .home-character { position: absolute; left: 320px; top: 40px; display: block; width: 820px; height: auto; max-width: none; user-select: none; }
  .home-stage :is(button, a, summary) { -webkit-tap-highlight-color: transparent; }
  .home-stage :is(button, a, summary):focus-visible { outline: 4px solid #f6d28e; outline-offset: -7px; }
  .home-stage ::selection { background: var(--home-accent); color: #172329; }
  .tile, .search-button {
    position: relative; display: flex; width: 100%; height: 100%; align-items: center;
    border: 1px solid #b8a6c14d; padding: 24px 32px;
    background: var(--home-surface); color: var(--home-ink);
    border-radius: 3px;
    background-image: linear-gradient(155deg, #f5e0c10a, transparent 48%);
    box-shadow: inset 0 1px #f8e7cf12, inset 0 -1px #0b081833;
    text-decoration: none; cursor: pointer; overflow: hidden;
    transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }
  .tile:hover, .search-button:hover { background-color: var(--home-surface-hover); border-color: #c8a16f8c; }
  .tile:active { box-shadow: inset 0 2px 6px #0b081844; }
  .tile::before { content: ''; position: absolute; left: 12px; top: 18px; bottom: 18px; width: 1px; background: var(--home-accent); }
  .tile span { position: relative; z-index: 1; font-size: 43px; font-weight: 600; line-height: 1.2; white-space: nowrap; }
  .tile :global(svg) { position: absolute; right: 22px; width: 125px; height: 130px; color: var(--home-icon); opacity: .2; pointer-events: none; }
  .search-button { justify-content: center; padding: 0; border: 0; background: transparent; color: var(--home-ink); }
  .search-button:hover { background: transparent; color: #f6d28e; }
  .search-button :global(svg) { width: 24px; height: 24px; }
  .level-badge { position: relative; width: 100%; height: 100%; color: var(--home-ink); }
  .level-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .level-track { fill: #17151dcc; stroke: #adb5ba80; stroke-width: 3; }
  .level-progress { fill: none; stroke: #f6d28e; stroke-width: 5; }
  .level-readout { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'IBM Plex Mono', monospace; }
  .level-number { font-size: 66px; font-weight: 500; line-height: 1.1; font-variant-numeric: tabular-nums; letter-spacing: -.035em; }
  .level-label { width: 84px; margin-top: 9px; padding-top: 6px; border-top: 1px solid #adb5ba80; font-size: 23px; line-height: 1; text-align: center; }
  .level-fallback { margin: 8px -40px 0; font-size: 18px; text-align: center; }
  .quote-card { position: relative; width: 100%; height: 100%; background: #211e29ed; border: 1px solid #b8a6c133; border-radius: 3px; box-shadow: inset 0 1px #f8e7cf0d; }
  .quote-switch { width: 100%; height: 100%; border: 0; padding: 20px 20px 20px 24px; text-align: left; color: var(--home-ink); background: transparent; cursor: pointer; }
  .quote-window { display: flex; overflow: hidden; height: 60px; align-items: center; }
  [data-quote-text] { display: block; font-size: 22px; line-height: 1.65; text-wrap: balance; }
  .small-tile { padding: 14px 20px 14px 65px; }
  .small-tile span { font-size: 32px; }
  .small-tile :global(svg) { width: 42px; height: 45px; left: 15px; right: auto; opacity: .6; }
  .small-tile::before { display: none; }
  .clock-card { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; height: 100%; place-items: center; background: #28232ced; border: 1px solid #c8a16f40; border-radius: 3px; box-shadow: inset 0 1px #f8e7cf12; padding: 8px 22px; }
  [data-home-clock] { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; gap: 5px; white-space: nowrap; }
  .nixie-tube { position: relative; display: grid; flex: 1 1 0; min-width: 0; place-items: center; height: 76px; border: 1px solid #c8b4a575; border-radius: 20px 20px 11px 11px; background: #201a17; box-shadow: inset 3px 0 5px #ffffff14, inset -3px 0 5px #0008; font: 400 51px/1 'IBM Plex Mono', monospace; color: #ffbc79; text-shadow: 0 0 3px #ff7c38, 0 0 12px #ff7929b3; }
  .nixie-tube::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: -5px; height: 5px; border-bottom: 2px solid #b6906f; background: #32251b; }
  .clock-separator { flex: 0 0 auto; color: #f5b47b; font: 36px/1 'IBM Plex Mono', monospace; }
  .clock-space { width: 14px; }
  .clock-fallback { font-size: 17px; }
  .blog-tile { --home-icon: #675c70; padding-left: 44px; background: linear-gradient(155deg, #eee7dc12, #9081740a), #ddd6caf5; color: #322d38; border-color: #f6ecdc8c; box-shadow: inset 0 1px #fff9eb99, inset 0 -1px #50443026; }
  .blog-tile:hover { background-color: #eee7db; }
  .blog-tile span { font-size: 78px; }
  .blog-tile :global(svg) { width: 198px; height: 208px; right: 65px; }
  .blog-tile .blog-chevron { width: 34px; height: 34px; right: 22px; bottom: 20px; opacity: 1; fill: none; stroke: currentColor; stroke-width: 2; }
  .recommendations {
    position: relative; height: 100%; display: grid; gap: 4px;
    grid-template: 'bookmark heading heading' 22fr 'bookmark software gear' 78fr / 32fr 34fr 34fr;
  }
  .recommendations h2 { grid-area: heading; display: flex; align-items: center; margin: 0; padding: 0 17px; color: var(--home-ink); background: #25212ef2; font-size: 26px; font-weight: 400; line-height: 1; }
  .recommendations .tile { --home-icon: #a7d4c8; min-width: 0; min-height: 0; padding: 23px; align-items: flex-end; background: #294641f2; border-color: #94c0b64d; }
  .recommendations .tile:hover { background: #42665e; }
  .recommendations .tile::before { display: none; }
  .recommendations .tile :global(svg) { width: 96px; height: 102px; right: 10px; top: 12px; }
  .recommendations .bookmark-tile { grid-area: bookmark; background: #36574ff2; }
  .recommendations .bookmark-tile:hover { background: #496e64; }
  .software-tile { grid-area: software; }
  .gear-tile { grid-area: gear; }
  .home-stage :global([data-music-player][data-display-mode='home']) { --player-ink: #e9e4dc; --player-muted: #c5bacb; --player-accent: #e9b66c; --player-accent-hover: #ffd28c; --player-on-accent: #241c13; --player-track: #655770; --color-inset: #19161f; --color-surface-raised: #2c2735; --color-copper: #b58c65; --color-line: #b8a6c14d; --color-line-strong: #655770; background: #26232ff2; border-color: #b8a6c14d; }
  @media (prefers-reduced-motion: reduce) { .tile, .search-button { transition: none; } }
</style>

<script is:inline>
  (function () {
    var stage = document.querySelector('[data-home-stage]');
    if (!stage) return;
    var clock = stage.querySelector('[data-home-clock]');
    var digits = clock ? Array.from(clock.querySelectorAll('[data-clock-digit]')) : [];
    var levelBadge = stage.querySelector('[data-home-level]');
    var levelNumber = stage.querySelector('[data-level-number]');
    var levelRing = stage.querySelector('[data-level-progress]');
    if (!clock || !levelBadge || !levelNumber || !levelRing) return;
    var now = new Date();
    // 等级计算（北京时间）
    var beijing = new Date(now.getTime() + 8 * 3600000);
    var year = beijing.getUTCFullYear();
    var bm = 6, bd = 29, by = 2002;
    var todayUTC = Date.UTC(year, beijing.getUTCMonth(), beijing.getUTCDate());
    var birthdayYear = todayUTC < Date.UTC(year, bm, bd) ? year - 1 : year;
    var lastBD = Date.UTC(birthdayYear, bm, bd);
    var nextBD = Date.UTC(birthdayYear + 1, bm, bd);
    var elapsed = (todayUTC - lastBD) / 86400000;
    var yearDays = (nextBD - lastBD) / 86400000;
    var level = birthdayYear - by;
    var progress = elapsed / yearDays;
    var percent = Math.round(progress * 10000) / 100;
    levelNumber.textContent = String(level);
    levelRing.setAttribute('stroke-dashoffset', String(100 * (1 - progress)));
    levelBadge.setAttribute('aria-valuenow', String(percent));
    levelBadge.setAttribute('aria-valuetext', level + ' 岁；年度进度 ' + percent + '%');
    // 时钟
    var pad = function(v) { return String(v).padStart(2, '0'); };
    var text = now.getFullYear() + '/' + pad(now.getMonth()+1) + '/' + pad(now.getDate()) + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
    clock.dateTime = now.toISOString();
    clock.setAttribute('aria-label', text);
    var numbers = text.replace(/\D/g, '');
    digits.forEach(function(d, i) { d.textContent = numbers[i] || ''; });
  })();
</script>

<script>
  import '@/scripts/home-dashboard';
</script>
