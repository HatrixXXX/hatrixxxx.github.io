---
import { SITE } from '@/config/site';
import { HOME_LINKS } from '@/config/navigation';
import { HOME_QUOTES } from '@/data/home-quotes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePanel from '@/components/HomePanel.astro';
import HomeIcon from '@/components/HomeIcon.astro';
import HomeTile from '@/components/HomeTile.astro';
import MusicPlayer from '@/components/MusicPlayer.astro';
import CharacterIdle from '@/components/CharacterIdle.astro';
import { projectPanel, projectRectOnPanelPlane, type Point } from '@/lib/home-projection';
import '@fontsource/orbitron/latin-800.css';
import '../styles/home-tiles.css';

const clockTemplate = '0000/00/00 00:00:00';
const homeBackground = '/assets/home/cover.webp';
const lowerLeftPlane = { width: 208, height: 88, corners: [[399, 708], [606, 696], [606, 784], [399, 796]] } as const;
// The five lower-left cards share one affine plane with vertical sides and parallel top/bottom edges.
const leftPanels = {
  search: { width: 44, height: 44, corners: [[14, 16], [58, 16], [58, 60], [14, 60]] },
  identity: { width: 180, height: 180, corners: [[72, 355], [252, 355], [252, 535], [72, 535]] },
  identityName: { x: 264, y: 389, width: 300, height: 112 },
  quote: { width: 600, height: 70, corners: projectRectOnPanelPlane(lowerLeftPlane.width, lowerLeftPlane.height, lowerLeftPlane.corners, { x: -392, y: -78, width: 600, height: 70 }) },
  music: { width: 376, height: 289, corners: projectRectOnPanelPlane(lowerLeftPlane.width, lowerLeftPlane.height, lowerLeftPlane.corners, { x: -392, y: 0, width: 376, height: 289 }) },
  friends: { width: 216, height: 91, corners: projectRectOnPanelPlane(lowerLeftPlane.width, lowerLeftPlane.height, lowerLeftPlane.corners, { x: -8, y: 0, width: 216, height: 91 }) },
  guestbook: { width: 216, height: 91, corners: projectRectOnPanelPlane(lowerLeftPlane.width, lowerLeftPlane.height, lowerLeftPlane.corners, { x: -8, y: 99, width: 216, height: 91 }) },
  labShortcut: { width: 216, height: 91, corners: projectRectOnPanelPlane(lowerLeftPlane.width, lowerLeftPlane.height, lowerLeftPlane.corners, { x: -8, y: 198, width: 216, height: 91 }) }
} satisfies Record<string, { width: number; height: number; corners?: readonly Point[]; x?: number; y?: number }>;

// Every right-side card is a rectangle on this ONE plane. Only the parent is projected.
const rightPlane = { width: 930, height: 952, corners: [[970, 120], [1910, 8], [1910, 1068], [970, 958]] } as const;
const rightTransform = `matrix3d(${projectPanel(rightPlane.width, rightPlane.height, rightPlane.corners).join(',')})`;
const rightPanels = {
  clock: { x: 110, y: 0, width: 820, height: 96 },
  blog: { x: 140, y: 108, width: 790, height: 286 },
  projects: { x: 110, y: 406, width: 380, height: 180 },
  about: { x: 502, y: 406, width: 428, height: 180 },
  recommendations: { x: 190, y: 598, width: 740, height: 180 },
  plans: { x: 120, y: 790, width: 399, height: 162 },
  digest: { x: 531, y: 790, width: 399, height: 162 }
};
---

<BaseLayout title={SITE.title} pageKind="home">
  <link rel="preload" href={homeBackground} as="image" />
  <main data-home-stage aria-labelledby="home-title" class="home-stage">
    <div class="home-canvas" data-home-canvas style={{ '--home-background-image': `url("${homeBackground}")` }}>
      <div class="character-space" data-home-character aria-hidden="true">
        <CharacterIdle />
      </div>
      <div class="home-side home-side--left" data-home-side="left">
        <HomePanel name="search" {...leftPanels.search}>
          <button class="search-button" type="button" data-open-search aria-label="搜索文章">
            <HomeIcon name="search" />
          </button>
        </HomePanel>
        <HomePanel name="identity" {...leftPanels.identity}>
          <button class="level-badge" type="button" data-home-magnetic data-level-impulse aria-label="推动等级圆环" aria-description="按住最多 3 秒蓄力，松开释放" disabled>
            <div class="level-meter" data-home-level role="meter" aria-label="等级年度进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="启用 JavaScript 后显示等级">
            <svg class="level-ring" viewBox="0 0 180 180" aria-hidden="true">
              <defs>
                <linearGradient id="level-shell-metal" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#4c4550" />
                  <stop offset=".45" stop-color="#181821" />
                  <stop offset="1" stop-color="#4b372d" />
                </linearGradient>
                <radialGradient id="level-core-metal">
                  <stop offset="0" stop-color="#30313a" />
                  <stop offset=".72" stop-color="#1b1b25" />
                  <stop offset="1" stop-color="#10131b" />
                </radialGradient>
              </defs>
              <circle class="level-shell" cx="90" cy="90" r="88" />
              <circle class="level-bezel" cx="90" cy="90" r="78" />
              <g class="level-tick-wheel">
                <circle class="level-minor-ticks" cx="90" cy="90" r="73" pathLength="120" stroke-dasharray=".55 1.45" transform="rotate(-90 90 90)" />
                <circle class="level-major-ticks" cx="90" cy="90" r="73" pathLength="24" stroke-dasharray=".65 1.35" transform="rotate(-90 90 90)" />
                <path class="level-tick-index" d="M85 11h10l-5 11Z" />
              </g>
              <circle class="level-track" cx="90" cy="90" r="65" />
              <circle class="level-progress" data-level-progress cx="90" cy="90" r="65" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 90 90)" />
              <circle class="level-core" cx="90" cy="90" r="55" />
              <g class="level-armor-wheel">
                <path class="level-armor" d="M18 46 30 27 52 16 65 16 54 26 35 37 26 53ZM115 16 128 16 150 27 162 46 154 53 145 37 126 26ZM26 127 35 143 54 154 65 164 52 164 30 153 18 134ZM154 127 162 134 150 153 128 164 115 164 126 154 145 143Z" />
                <path class="level-seams" d="M21 43 32 29 51 19M129 19 148 29 159 43M21 137 32 151 51 161M129 161 148 151 159 137" />
                <path class="level-axis" d="M90 6v9M90 165v9M6 90h9M165 90h9" />
                <circle class="level-rivet" cx="28" cy="40" r="2" /><circle class="level-rivet" cx="152" cy="40" r="2" />
                <circle class="level-rivet" cx="28" cy="140" r="2" /><circle class="level-rivet" cx="152" cy="140" r="2" />
                <path class="level-armor-index" d="M160 85h12l-5 5 5 5h-12Z" />
              </g>
            </svg>
            <div class="level-readout" aria-hidden="true">
              <span class="level-number" data-level-number>—</span>
              <span class="level-label">LV</span>
            </div>
            </div>
          </button>
          <noscript><p class="level-fallback">启用 JavaScript 后显示等级</p></noscript>
        </HomePanel>
        <HomePanel name="identity-name" {...leftPanels.identityName}>
          <div class="identity-name">
            <h1 id="home-title" data-home-title>Hatrix</h1>
            <button class="identity-trigger" type="button" data-home-magnetic aria-label="点亮 Hatrix" disabled></button>
          </div>
        </HomePanel>
        <div class="home-left-cards" data-home-tilt="left">
          <HomePanel name="quote" {...leftPanels.quote}>
            <button class="quote-card" type="button" data-home-quote data-home-magnetic data-quote-cursor="source" aria-label="语句卡片" aria-description="双击或连续按两次 Enter／空格切换语句" aria-describedby="quote-announcement" disabled>
              <span class="quote-window">
                <span class="quote-row">
                  <span class="quote-text-window" data-quote-text-window>
                    <span data-quote-text aria-hidden="true">{HOME_QUOTES[0].text}</span>
                  </span>
                  <span data-quote-source aria-hidden="true">— {HOME_QUOTES[0].source}</span>
                </span>
              </span>
            </button>
            <span id="quote-announcement" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-quote-announcement>{HOME_QUOTES[0].text}，出处：{HOME_QUOTES[0].source}</span>
          </HomePanel>
          <MusicPlayer mode="home" />
          <HomePanel name="music" {...leftPanels.music}>
          </HomePanel>
          <HomePanel name="friends" {...leftPanels.friends}>
            <HomeTile name="friends" {...HOME_LINKS.friends} />
          </HomePanel>
          <HomePanel name="guestbook" {...leftPanels.guestbook}>
            <HomeTile name="guestbook" {...HOME_LINKS.guestbook} />
          </HomePanel>
          <HomePanel name="lab-shortcut" {...leftPanels.labShortcut}>
            <HomeTile name="lab" className="tile--lab-shortcut" {...HOME_LINKS.lab} />
          </HomePanel>
        </div>
      </div>
      <div class="home-side home-side--right" data-home-side="right">
        <div class="right-plane" data-home-plane="right" style={`width:${rightPlane.width}px;height:${rightPlane.height}px;transform:${rightTransform}`}>
          <HomePanel name="clock" {...rightPanels.clock}>
            <button class="clock-card" type="button" data-home-clock-card data-home-magnetic aria-description="双击或连续按两次 Enter／空格播放故障动画" disabled>
              <time data-home-clock aria-label="正在读取本地时间">
                {Array.from(clockTemplate).map((character) => /\d/.test(character)
                  ? <span class="nixie-tube" data-clock-digit aria-hidden="true">—</span>
                  : <span class:list={['clock-separator', { 'clock-space': character === ' ' }]} aria-hidden="true">{character}</span>)}
              </time>
              <noscript><span class="clock-fallback">启用 JavaScript 后显示时间</span></noscript>
            </button>
          </HomePanel>
          <HomePanel name="blog" {...rightPanels.blog}>
            <HomeTile name="blog" {...HOME_LINKS.blog} />
          </HomePanel>
          <HomePanel name="projects" {...rightPanels.projects}>
            <HomeTile name="projects" {...HOME_LINKS.projects} />
          </HomePanel>
          <HomePanel name="about" {...rightPanels.about}>
            <HomeTile name="about" {...HOME_LINKS.about} />
          </HomePanel>
          <HomePanel name="recommendations" {...rightPanels.recommendations}>
            <section class="recommendations" aria-labelledby="recommendations-title">
              <h2 id="recommendations-title">效率提升</h2>
              <HomeTile name="snippets" {...HOME_LINKS.snippets} />
              <HomeTile name="bookmark" {...HOME_LINKS.bookmarks} />
              <HomeTile name="software" {...HOME_LINKS.software} />
            </section>
          </HomePanel>
          <HomePanel name="plans" {...rightPanels.plans}>
            <HomeTile name="plans" {...HOME_LINKS.plans} />
          </HomePanel>
          <HomePanel name="digest" {...rightPanels.digest}>
            <HomeTile name="digest" {...HOME_LINKS.digest} />
          </HomePanel>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  :global(html[data-page-kind='home']), :global(html[data-page-kind='home'] body) {
    width: 100%; height: 100%; overflow: hidden; overscroll-behavior: none;
  }
  .home-stage {
    --home-paper: #17151d;
    --home-surface: #2e2934f2;
    --home-surface-hover: #403746;
    --home-ink: #e9e4dc;
    --home-accent: #ffd200;
    --home-icon: #c8c0d0;
    --home-panel-radius: 3px;
    position: fixed; inset: 0; overflow: hidden;
    background: var(--home-paper); color: var(--home-ink);
    font-family: 'Microsoft YaHei', 'PingFang SC', sans-serif;
    isolation: isolate;
  }
  .home-canvas {
    position: absolute; left: 50%; top: 50%; width: 1920px; height: 1080px;
    /* atan2 yields a unitless uniform scale, including with JavaScript disabled. */
    --home-scale: tan(atan2(min(100vw, 177.7777778dvh), 1920px));
    /* Compensate for ultrawide letterboxing in design pixels, without resizing either group. */
    --home-side-offset: max(0px, calc((tan(atan2(100vw, 100dvh)) * 1080 - 1920) * .5px));
    transform: translate(-50%, -50%) scale(var(--home-scale));
    transform-origin: center;
  }
  .home-canvas::before {
    content: ''; position: absolute; inset: 0 calc(-1 * var(--home-side-offset)); z-index: -2;
    background: var(--home-background-image) center / cover no-repeat; pointer-events: none;
  }
  .home-side { position: absolute; inset: 0; pointer-events: none; }
  .home-side--left { transform: translateX(calc(-1 * var(--home-side-offset))); }
  .home-side--right { transform: translateX(var(--home-side-offset)); }
  .home-left-cards { position: absolute; inset: 0; pointer-events: none; transform-origin: 0 0; }
  .home-side :global([data-home-panel]) { pointer-events: auto; }
  .home-side :global([data-music-player][data-display-mode='home']) { pointer-events: auto; }
  .right-plane { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
  /* Crop inside the design canvas so portrait letterboxing stays empty. */
  .character-space { position: absolute; z-index: -1; inset: 0; overflow: hidden; pointer-events: none; }
  .home-stage :is(button, a, summary) { -webkit-tap-highlight-color: transparent; }
  .home-stage :is(button, a, summary):focus-visible { outline: 4px solid #ffe360; outline-offset: -7px; }
  .home-stage ::selection { background: var(--home-accent); color: #172329; }
  .search-button { position: relative; display: grid; width: 100%; height: 100%; place-items: center; padding: 0; border: 1px solid var(--color-copper); clip-path: polygon(0 9px, 9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%); background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset)); box-shadow: inset 0 0 0 4px rgb(0 0 0 / 22%); color: var(--color-accent); cursor: pointer; transition: color 160ms ease, filter 160ms ease; }
  .search-button::before { position: absolute; inset: 5px; border: 1px solid rgb(216 140 60 / 42%); clip-path: polygon(0 5px, 5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%); content: ''; pointer-events: none; }
  .search-button::after { position: absolute; top: 5px; right: 5px; width: 5px; height: 3px; background: var(--color-link); box-shadow: 0 0 7px var(--color-link); content: ''; pointer-events: none; }
  .search-button:is(:hover, :focus-visible) { color: var(--color-accent-strong); filter: brightness(1.18); }
  .search-button:focus-visible { box-shadow: inset 0 0 0 3px var(--color-link); }
  .search-button:active { filter: brightness(1.35); }
  .search-button :global(svg) { width: 23px; height: 23px; }
  .level-badge { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; color: var(--home-ink); filter: drop-shadow(3px 6px 6px #0b0a12a6); isolation: isolate; touch-action: none; transition: filter 180ms ease, transform 180ms var(--ease-out); }
  .level-badge::before { --halo-spread: var(--charge-spread, var(--release-spread, 0)); position: absolute; z-index: -1; inset: -62px; border-radius: 50%; background: radial-gradient(circle, #ffd200a6 0, #ffd20085 88px, #ffd20052 98px, transparent calc(105px + var(--halo-spread) * 43px)); content: ''; opacity: 0; pointer-events: none; filter: blur(calc(3px + var(--halo-spread) * 9px)); }
  .level-meter { width: 100%; height: 100%; }
  .level-badge:focus-visible { filter: drop-shadow(3px 6px 8px #0b0a12a6) drop-shadow(0 0 8px #ffd20080); }
  .level-badge[data-charging]::before { opacity: calc(.22 + var(--charge-glow, 0) * .78); }
  .level-badge[data-charge-full]::before { animation: level-charge-ready .26s ease-in-out infinite alternate; }
  .level-badge[data-impulsing]:not([data-charging])::before { opacity: var(--release-glow, 0); }
  .level-badge[data-impulsing] { filter: drop-shadow(3px 6px 8px #0b0a12a6) drop-shadow(0 0 11px rgb(255 210 0 / calc(var(--impulse-strength, 0) * .7))) drop-shadow(0 0 6px rgb(255 210 0 / calc(var(--impulse-strength, 0) * .5))); }
  .level-badge[data-impulsing]:focus-visible:not([data-charging]) { filter: drop-shadow(3px 6px 8px #0b0a12a6) drop-shadow(0 0 11px rgb(255 210 0 / calc(.5 + var(--impulse-strength, 0) * .2))) drop-shadow(0 0 6px rgb(255 210 0 / calc(var(--impulse-strength, 0) * .5))); }
  @media (hover: hover) {
    .level-badge:hover { filter: drop-shadow(3px 6px 8px #0b0a12a6) drop-shadow(0 0 8px #ffd20080); }
    .level-badge[data-impulsing]:hover:not([data-charging]) { filter: drop-shadow(3px 6px 8px #0b0a12a6) drop-shadow(0 0 11px rgb(255 210 0 / calc(.5 + var(--impulse-strength, 0) * .2))) drop-shadow(0 0 6px rgb(255 210 0 / calc(var(--impulse-strength, 0) * .5))); }
  }
  .level-badge[data-charging] { filter: drop-shadow(3px 6px 6px #0b0a12a6); transition: none; }
  .level-badge:not([data-impulsing]):active { transform: scale(.97); }
  @keyframes level-charge-ready { from { opacity: 1; } to { opacity: .42; } }
  .level-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .level-tick-wheel, .level-armor-wheel { transform-box: view-box; transform-origin: center; }
  .level-tick-wheel { animation: level-spin 90s linear infinite; }
  .level-armor-wheel { animation: level-spin 150s linear infinite reverse; }
  @keyframes level-spin { to { transform: rotate(360deg); } }
  .level-shell { fill: url(#level-shell-metal); stroke: #d88c3c; stroke-width: 1.5; }
  .level-bezel { fill: #11131bd9; stroke: #ad9a8a; stroke-width: 1; }
  .level-minor-ticks, .level-major-ticks, .level-track, .level-progress { fill: none; }
  .level-minor-ticks { stroke: #9e8f83; stroke-width: 2.5; opacity: .7; }
  .level-major-ticks { stroke: #e0b46d; stroke-width: 5; }
  .level-tick-index { fill: #ffd200; stroke: #332717; stroke-width: 1; }
  .level-track { stroke: #403945; stroke-width: 8; }
  .level-progress { stroke: #ffd200; stroke-width: 7; filter: drop-shadow(0 0 4px #ffd200a6); }
  .level-core { fill: url(#level-core-metal); stroke: #d88c3c9c; stroke-width: 1.5; }
  .level-armor { fill: #302b33; stroke: #b47b45; stroke-width: 1; stroke-linejoin: bevel; }
  .level-seams { fill: none; stroke: #ffdc88; stroke-width: 1.5; opacity: .8; }
  .level-axis { fill: none; stroke: #00ddeb; stroke-width: 2.5; }
  .level-rivet { fill: #d88c3c; stroke: #17151d; stroke-width: 1; }
  .level-armor-index { fill: #00ddeb; stroke: #182229; stroke-width: 1; }
  .level-readout { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 5px; font-family: 'Orbitron', Arial, sans-serif; }
  .level-number { color: #fff1d1; font-size: 61px; font-weight: 800; line-height: 1.05; font-variant-numeric: tabular-nums; letter-spacing: -.035em; text-shadow: 0 2px 2px #000, 0 0 12px #ffd20073; }
  .level-label { width: 60px; margin-top: 3px; padding-top: 7px; border-top: 1px solid #d88c3c; color: #ffd200; font-size: 17px; font-weight: 800; line-height: 1; letter-spacing: .15em; text-align: center; }
  .level-fallback { margin: 8px -40px 0; font-size: 18px; text-align: center; }
  .identity-name { position: relative; display: flex; width: 100%; height: 100%; align-items: center; padding-left: 28px; background: transparent; }
  .identity-name h1 { position: relative; z-index: 1; margin: 0; color: var(--home-ink); font: 800 64px/1 'Orbitron', Arial, sans-serif; letter-spacing: .025em; text-shadow: 0 0 16px color-mix(in srgb, var(--color-link) 35%, transparent); transition: color 180ms ease, text-shadow 180ms ease, transform 120ms ease; }
  .identity-trigger { position: absolute; z-index: 2; inset: 0; padding: 0; border: 0; background: transparent; }
  .identity-name:is(:hover, :focus-within) h1 { color: #fff1d1; text-shadow: 0 0 18px #00ddebab, 0 0 6px #ffd20080; }
  .identity-name:active h1 { transform: translateY(2px); }
  @property --hatrix-glow-radius { syntax: '<length>'; inherits: false; initial-value: 0px; }
  .identity-name h1::after { position: absolute; inset: 0; content: 'Hatrix'; color: transparent; opacity: 0; pointer-events: none; text-shadow: 0 0 9px #00ddebd9, 0 0 20px #00ddeb9c; mask-image: radial-gradient(circle at var(--ripple-x, 50%) var(--ripple-y, 50%), #000 calc(var(--hatrix-glow-radius) - 22px), transparent calc(var(--hatrix-glow-radius) + 30px)); }
  .identity-name[data-rippling] h1 { animation: hatrix-glow-pulse 800ms ease-out both; }
  .identity-name[data-rippling] h1::after { animation: hatrix-glow-spread 800ms ease-out both; }
  @keyframes hatrix-glow-spread { 0% { --hatrix-glow-radius: 0px; opacity: 0; } 22% { opacity: .7; } 65% { opacity: .38; } 100% { --hatrix-glow-radius: 230px; opacity: 0; } }
  @keyframes hatrix-glow-pulse { 0%, 100% { text-shadow: 0 0 16px color-mix(in srgb, var(--color-link) 35%, transparent); } 27% { text-shadow: 0 0 17px #00ddeb94, 0 0 24px #00ddeb4d; } 52% { text-shadow: 0 0 20px #00ddebaf, 0 0 29px #00ddeb55; } 75% { text-shadow: 0 0 17px #00ddeb91, 0 0 23px #00ddeb42; } }
  .quote-card { position: relative; display: flex; overflow: hidden; width: 100%; height: 100%; align-items: center; padding: 0; background: #202b3bf2; border: 1px solid #21d8eacc; border-radius: var(--home-panel-radius); box-shadow: inset 0 1px #b7e0e71a; color: #ecf2f0; font: inherit; text-align: left; touch-action: manipulation; transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease; }
  .quote-card:is(:hover, :focus-visible) { border-color: #82f5ff; background: #26394bf2; box-shadow: inset 0 1px #b7e0e740, 0 0 12px #00ddeb40; }
  .quote-window { z-index: 1; overflow: visible; width: 100%; padding: 0 24px; }
  .quote-row { display: flex; min-width: 0; width: 100%; align-items: flex-end; gap: 8px; }
  .quote-text-window { display: flex; overflow: visible; min-width: 0; flex: 0 1 auto; align-items: center; }
  [data-quote-text] { display: block; overflow: visible; min-width: 0; width: max-content; font-size: 17px; line-height: 1.25; white-space: nowrap; }
  [data-quote-source] { overflow: visible; min-width: 0; max-width: 35%; flex: 0 0 auto; color: #a9e7f0; font-size: 10.506px; line-height: 1.25; letter-spacing: .02em; text-align: left; white-space: nowrap; }
  .quote-card[data-quote-cursor='text'] [data-quote-text]::after,
  .quote-card[data-quote-cursor='source'] [data-quote-source]::after { display: inline-block; width: 2px; height: 17px; margin-left: 3px; background: #8adaf1; content: ''; vertical-align: -.25em; animation: quote-caret-blink 1.2s steps(1, end) infinite; }
  @keyframes quote-caret-blink { 50% { opacity: .25; } }
  .clock-card { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; height: 100%; place-items: center; background: #28232ced; border: 1px solid #ffd200d9; border-radius: 3px; box-shadow: inset 0 1px #f8e7cf12; padding: 8px 22px; color: inherit; font: inherit; touch-action: manipulation; }
  .clock-card:is(:hover, :focus-visible) { border-color: #ffe360; box-shadow: inset 0 1px #f8e7cf2e, 0 0 12px #ffb12d40; }
  .clock-card[data-clock-glitch] { animation: clock-shell-glitch 720ms steps(1, end); }
  .clock-card[data-clock-glitch] .nixie-tube { animation: clock-tube-glitch 720ms steps(1, end); }
  .clock-card[data-clock-glitch] .nixie-tube:nth-of-type(3n) { animation-delay: -110ms; }
  .clock-card[data-clock-glitch] .nixie-tube:nth-of-type(4n) { animation-delay: -190ms; }
  .clock-card[data-clock-glitch] .clock-separator { animation: clock-separator-glitch 720ms steps(1, end); }
  @keyframes clock-shell-glitch { 18%, 39% { border-color: #8d6130; box-shadow: inset 0 1px #f8e7cf12; } 23%, 44%, 79% { border-color: #fff0b8; box-shadow: inset 0 1px #f8e7cf2e, 0 0 18px #ffb12d70; } }
  @keyframes clock-tube-glitch { 12%, 28%, 42%, 56% { color: #7b5941; text-shadow: none; filter: brightness(.48); } 17%, 35%, 48%, 73% { color: #fff4c3; text-shadow: 0 0 5px #ff9b43, 0 0 19px #ff7929; filter: brightness(1.4); } 61% { transform: translateY(2px); filter: brightness(.7); } }
  @keyframes clock-separator-glitch { 20%, 42% { opacity: .2; } 25%, 51% { opacity: 1; } }
  [data-home-clock] { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; gap: 5px; white-space: nowrap; }
  .nixie-tube { position: relative; display: grid; flex: 1 1 0; min-width: 0; place-items: center; height: 76px; border: 1px solid #c8b4a575; border-radius: 20px 20px 11px 11px; background: #201a17; box-shadow: inset 3px 0 5px #ffffff14, inset -3px 0 5px #0008; font: 400 51px/1 'IBM Plex Mono', monospace; color: #ffd36a; text-shadow: 0 0 3px #ff7c38, 0 0 12px #ff7929b3; }
  .nixie-tube::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: -5px; height: 5px; border-bottom: 2px solid #b6906f; background: #32251b; }
  .clock-separator { flex: 0 0 auto; color: #ffd36a; font: 36px/1 'IBM Plex Mono', monospace; }
  .clock-space { width: 14px; }
  .clock-fallback { font-size: 17px; }
  .recommendations {
    position: relative; height: 100%; display: grid; gap: 4px;
    grid-template: 'snippets heading heading' 22fr 'snippets bookmark software' 78fr / 32fr 34fr 34fr;
  }
  .recommendations h2 { grid-area: heading; display: flex; align-items: center; margin: 0; padding: 0 17px; border: 1px solid #c8c7cab3; border-radius: var(--home-panel-radius); color: var(--home-ink); background: #25212ef2; font-size: 26px; font-weight: 400; line-height: 1; }
  .home-stage :global([data-music-player][data-display-mode='home']) { --player-ink: #e9e4dc; --player-muted: #c5bacb; --player-accent: #ffd200; --player-accent-hover: #ffe360; --player-on-accent: #241c13; --player-track: #655770; --color-inset: #19161f; --color-surface-raised: #2c2735; --color-copper: #d88c3c; --color-line: #b8a6c14d; --color-line-strong: #655770; background: #26232ff2; border-color: var(--color-copper); }
  @media (prefers-reduced-motion: reduce) {
    .search-button { transition: none; }
    .level-tick-wheel, .level-armor-wheel { animation: none; }
    .level-badge[data-charge-full]::before { animation: none; opacity: 1; }
    .level-badge, .identity-name h1, .quote-card { transition: none; }
    .level-badge:active, .identity-name:active h1 { transform: none; }
    .quote-card[data-quote-cursor='text'] [data-quote-text]::after,
    .quote-card[data-quote-cursor='source'] [data-quote-source]::after { animation: none; }
    .identity-name[data-rippling] h1, .identity-name[data-rippling] h1::after { animation: none; }
    .identity-name[data-rippling] h1 { color: #fff1d1; text-shadow: 0 0 19px #00ddeb80; }
    .clock-card[data-clock-glitch] { animation: clock-shell-glitch 220ms steps(1, end); }
    .clock-card[data-clock-glitch] .nixie-tube,
    .clock-card[data-clock-glitch] .clock-separator { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var stage = document.querySelector('[data-home-stage]');
    if (!stage) return;
    var clock = stage.querySelector('[data-home-clock]');
    var digits = clock ? Array.from(clock.querySelectorAll('[data-clock-digit]')) : [];
    var levelBadge = stage.querySelector('[data-home-level]');
    var levelNumber = stage.querySelector('[data-level-number]');
    var levelRing = stage.querySelector('[data-level-progress]');
    if (!clock || !levelBadge || !levelNumber || !levelRing) return;
    var now = new Date();
    // 等级计算（北京时间）
    var beijing = new Date(now.getTime() + 8 * 3600000);
    var year = beijing.getUTCFullYear();
    var bm = 6, bd = 29, by = 2002;
    var todayUTC = Date.UTC(year, beijing.getUTCMonth(), beijing.getUTCDate());
    var birthdayYear = todayUTC < Date.UTC(year, bm, bd) ? year - 1 : year;
    var lastBD = Date.UTC(birthdayYear, bm, bd);
    var nextBD = Date.UTC(birthdayYear + 1, bm, bd);
    var elapsed = (todayUTC - lastBD) / 86400000;
    var yearDays = (nextBD - lastBD) / 86400000;
    var level = birthdayYear - by;
    var progress = elapsed / yearDays;
    var percent = Math.round(progress * 10000) / 100;
    levelNumber.textContent = String(level);
    levelRing.setAttribute('stroke-dashoffset', String(100 * (1 - progress)));
    levelBadge.setAttribute('aria-valuenow', String(percent));
    levelBadge.setAttribute('aria-valuetext', level + ' 岁；年度进度 ' + percent + '%');
    // 时钟
    var pad = function(v) { return String(v).padStart(2, '0'); };
    var text = now.getFullYear() + '/' + pad(now.getMonth()+1) + '/' + pad(now.getDate()) + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
    clock.dateTime = now.toISOString();
    clock.setAttribute('aria-label', text);
    var numbers = text.replace(/\D/g, '');
    digits.forEach(function(d, i) { d.textContent = numbers[i] || ''; });
  })();
</script>

