---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title={SITE.title} image="/images/cover.png" pageKind="home">
  <main data-home-stage aria-labelledby="home-title" class="home-stage">
    <section class="home-copy">
      <h1 id="home-title" data-home-title>Hatrixの窝</h1>
      <p class="home-subtitle" aria-label="轻松即单纯，速成即精准">
        <span data-home-typing aria-label="轻松即单纯，速成即精准" aria-hidden="true"></span>
        <span data-home-typing-cursor aria-hidden="true">|</span>
      </p>
    </section>
    <a
      class="home-blog-link"
      href="/blog/"
      aria-label="进入博客文章总览"
      data-home-blog-link
      data-astro-prefetch="load"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="30" height="30">
        <path d="m9 5 7 7-7 7"></path>
      </svg>
    </a>
  </main>
</BaseLayout>

<style>
  :global(html[data-page-kind='home']),
  :global(html[data-page-kind='home'] body) {
    width: 100%;
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .home-stage {
    position: fixed;
    inset: 0;
    min-height: 100dvh;
    overflow: hidden;
    background: url('/images/cover.png') center / cover no-repeat;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'IBM Plex Mono', 'Microsoft YaHei', sans-serif;
    isolation: isolate;
  }

  .home-stage::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: rgb(0 0 0 / 30%);
    content: '';
  }

  .home-copy {
    position: absolute;
    top: 43%;
    left: 50%;
    width: min(calc(100% - 2rem), 54rem);
    transform: translateX(-50%);
    text-align: center;
  }

  .home-copy h1 {
    margin: 0;
    color: #fff;
    font-size: 2.85rem;
    font-weight: 700;
    line-height: 1.5;
    text-shadow: 2px 2px 4px rgb(0 0 0 / 15%);
  }

  .home-subtitle {
    min-height: 1.5em;
    margin: 0;
    color: #eee;
    font-size: 1.72rem;
    font-weight: 400;
    line-height: 1.5;
    text-shadow: 2px 2px 4px rgb(0 0 0 / 15%);
  }

  .home-blog-link {
    position: absolute;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    left: 50%;
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: #eee;
    filter: drop-shadow(1px 1px 2px rgb(0 0 0 / 30%));
    transform: translateX(-50%);
  }

  .home-blog-link svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  @media (max-width: 768px) {
    .home-copy h1 {
      font-size: 1.85rem;
    }

    .home-subtitle {
      font-size: 1.15rem;
    }
  }
</style>
