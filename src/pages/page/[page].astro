---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import HeroBanner from '@/components/HeroBanner.astro';
import Pagination from '@/components/Pagination.astro';
import PostList from '@/components/PostList.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { paginatePosts, sortPosts, type Page, type PostEntry } from '@/lib/content';

interface Props {
  page: Page<PostEntry>;
}

export const getStaticPaths = (async () => {
  const posts = sortPosts(await getCollection('posts', ({ data }: PostEntry) => !data.draft));
  const total = paginatePosts(posts, 1, 6).total;

  return Array.from({ length: total - 1 }, (_, index) => {
    const current = index + 2;
    return {
      params: { page: String(current) },
      props: { page: paginatePosts(posts, current, 6) }
    };
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title={`文章列表 · 第 ${page.current} 页`}>
  <HeroBanner
    title={`文章列表 · 第 ${page.current} 页`}
    subtitle={SITE.tagline}
    image="/images/default-cover.svg"
    compact
  />
  <main class="home-main container">
    <div class="home-feed">
      <PostList posts={page.items} />
      <Pagination current={page.current} total={page.total} basePath="/page/" />
    </div>
  </main>
</BaseLayout>

<style>
  .home-main {
    display: grid;
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .home-feed {
    min-width: 0;
  }

</style>
