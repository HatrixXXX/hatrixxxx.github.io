---
import AboutIdentityCard from '@/components/AboutIdentityCard.astro';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于我" bodyClass="about-page nav-content-page plain-page">
  <BackButton href="/" label="返回主页" cornerAligned={true} />
  <main class="about-main container">
    <AboutIdentityCard />
  </main>
</BaseLayout>

<style>
  .about-main {
    display: grid;
    width: min(calc(100% - 16px), 1478px);
    height: 100dvh;
    min-width: 0;
    place-items: center;
    overflow: hidden;
    padding-top: calc(var(--header-height) + 0.5rem) !important;
    padding-bottom: 0.5rem;
  }

  :global(html),
  :global(body.about-page) { overflow: hidden; }

  @media (max-width: 1240px) {
    .about-main { height: auto; min-height: 100dvh; overflow: visible; padding-bottom: 2rem; }
    :global(html),
    :global(body.about-page) { overflow: auto; }
  }
</style>

<script>
  import '@/scripts/about-card-fold';
</script>
