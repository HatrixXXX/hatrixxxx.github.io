---
import BackButton from '@/components/BackButton.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于我" bodyClass="nav-content-page plain-page">
  <BackButton href="/" label="返回主页" />
  <main class="about-main container">
    <article class="about-console">
      <div class="about-console__copy">
        <h1>{SITE.author.name}</h1>
        <p>{SITE.description}</p>
        <p>这里记录技术研发、学习笔记与作品进展。</p>
      </div>
      <div class="about-console__emblem" aria-hidden="true">
        <span class="emblem-wing emblem-wing--left"></span>
        <span class="emblem-wing emblem-wing--right"></span>
        <span class="emblem-ring"><span class="emblem-core"></span></span>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .about-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; overflow: visible; padding-block: clamp(2.5rem, 6vw, 5rem); }
  .about-console {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 33%);
    align-items: center;
    min-width: 0;
    min-height: clamp(320px, 40vh, 450px);
    overflow: hidden;
    border: 1px solid var(--chassis-edge);
    border-radius: 3px;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      linear-gradient(125deg, rgb(0 221 235 / 7%), transparent 36% 63%, rgb(255 210 0 / 5%)),
      linear-gradient(180deg, rgb(245 224 193 / 6%), transparent 24%),
      var(--color-surface);
    box-shadow: inset 0 0 0 6px var(--chassis-groove), inset 0 0 0 7px rgb(216 140 60 / 17%), 0 20px 45px rgb(4 5 10 / 35%);
  }
  .about-console::before {
    content: '';
    position: absolute;
    top: 10px;
    right: 28%;
    left: 24px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-copper), var(--color-accent) 28%, transparent 52%, var(--color-link) 78%, transparent);
  }
  .about-console::after {
    content: '';
    position: absolute;
    right: 24px;
    bottom: 10px;
    width: min(30%, 250px);
    height: 3px;
    background: linear-gradient(270deg, var(--color-link), var(--color-copper), transparent);
  }
  .about-console__copy { position: relative; z-index: 1; max-width: 60ch; }
  h1 { margin: 0; color: var(--color-heading); font-size: clamp(2.3rem, 5vw, 4.25rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  p { color: var(--color-text); font-size: clamp(1rem, 1.4vw, 1.14rem); }
  .about-console__emblem {
    position: relative;
    display: grid;
    width: min(100%, 290px);
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
    filter: drop-shadow(0 12px 22px rgb(4 5 10 / 45%));
  }
  .about-console__emblem::before,
  .about-console__emblem::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: 28%;
    height: 42%;
    border: 1px solid var(--chassis-edge);
    background: linear-gradient(160deg, #3a3540, #1b1b25 65%);
  }
  .about-console__emblem::before { left: 0; clip-path: polygon(0 0, 100% 22%, 80% 100%, 0 72%); }
  .about-console__emblem::after { right: 0; clip-path: polygon(0 22%, 100% 0, 100% 72%, 20% 100%); }
  .emblem-wing {
    position: absolute;
    width: 48%;
    height: 54%;
    border: 1px solid var(--chassis-edge);
    background: linear-gradient(145deg, #48404a 0 12%, #201f2b 12% 72%, #131823);
    box-shadow: inset 0 0 0 6px var(--chassis-groove);
  }
  .emblem-wing--left { left: 5%; clip-path: polygon(0 0, 100% 18%, 84% 50%, 100% 82%, 0 100%, 15% 50%); }
  .emblem-wing--right { right: 5%; clip-path: polygon(0 18%, 100% 0, 85% 50%, 100% 100%, 0 82%, 16% 50%); }
  .emblem-ring {
    position: relative;
    z-index: 2;
    display: grid;
    width: 48%;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid var(--color-copper);
    border-radius: 50%;
    background: radial-gradient(circle, #111823 0 44%, transparent 45%), repeating-conic-gradient(var(--color-copper) 0 3deg, transparent 3deg 22deg), var(--color-surface);
    box-shadow: inset 0 0 0 8px var(--chassis-groove), 0 0 0 8px #24212a, 0 0 0 9px var(--chassis-edge), 0 0 28px rgb(0 221 235 / 16%);
    animation: core-engage 700ms var(--ease-out) both;
  }
  .emblem-core {
    width: 44%;
    aspect-ratio: 1;
    border: 2px solid var(--color-link);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    background: radial-gradient(circle, var(--color-accent) 0 14%, var(--color-link) 15% 24%, #101923 25%);
    box-shadow: 0 0 16px rgb(0 221 235 / 30%);
  }
  @keyframes core-engage { from { transform: rotate(-30deg); opacity: 0.6; } to { transform: rotate(0); opacity: 1; } }
  @media (max-width: 700px) {
    .about-console { grid-template-columns: 1fr; gap: 1.5rem; }
    .about-console__emblem { width: min(58vw, 230px); }
  }
  @media (prefers-reduced-motion: reduce) { .emblem-ring { animation: none; } }
</style>
