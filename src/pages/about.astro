---
import BackButton from '@/components/BackButton.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于我" bodyClass="plain-page">
  <BackButton href="/" label="返回主页" />
  <main class="about-main container">
    <article>
      <h1>{SITE.author.name}</h1>
      <p>{SITE.description}</p>
      <p>这里记录技术研发、学习笔记与作品进展。</p>
    </article>
  </main>
</BaseLayout>

<style>
  .about-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; overflow: visible; padding-block: clamp(2.5rem, 6vw, 5rem); }
  article { min-width: 0; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: clamp(1.5rem, 5vw, 3rem); background: var(--surface-sheen), var(--color-surface); box-shadow: var(--shadow-inset), var(--shadow-panel); }
  h1 { margin: 0; color: var(--color-heading); font-weight: 650; }
  p { color: var(--color-text); }
</style>
