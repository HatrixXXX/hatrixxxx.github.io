---
import HeroBanner from '@/components/HeroBanner.astro';
import WaveDivider from '@/components/WaveDivider.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于">
  <HeroBanner title="关于" subtitle={`你好，我是 ${SITE.author.name}`} image="/images/default-cover.svg" compact />
  <WaveDivider />
  <main class="about-main container">
    <article>
      <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="128" height="128" loading="lazy" />
      <div>
        <h1>{SITE.author.name}</h1>
        <p>{SITE.description}</p>
        <p>这里记录技术研发、学习笔记与作品进展。</p>
        <nav aria-label="社交链接">
          {SITE.socials.map((social) => <a href={social.url} target="_blank" rel="me noreferrer">{social.label}</a>)}
        </nav>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .about-main { padding-block: clamp(2.5rem, 6vw, 5rem); }
  article { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; max-width: 760px; margin-inline: auto; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: clamp(1.5rem, 5vw, 3rem); background: var(--color-surface); box-shadow: var(--shadow-panel); }
  img { border: 3px solid rgb(255 255 255 / 75%); border-radius: 50%; object-fit: cover; }
  h1 { margin: 0; color: #fff; }
  p { color: var(--color-muted); }
  nav { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  nav a { border: 1px solid var(--color-line); border-radius: 999px; padding: 0.4rem 0.75rem; }
  nav a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  @media (max-width: 600px) { article { grid-template-columns: minmax(0, 1fr); } img { margin-inline: auto; } }
</style>
