---
import { getCollection } from 'astro:content';
import HeroBanner from '@/components/HeroBanner.astro';
import SidebarStack from '@/components/SidebarStack.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { PostEntry } from '@/lib/content';

const posts = await getCollection('posts', ({ data }: PostEntry) => !data.draft);
---

<BaseLayout title="关于">
  <HeroBanner title="关于" subtitle={`你好，我是 ${SITE.author.name}`} image="/images/default-cover.svg" compact />
  <main class="about-main container">
    <article>
      <h1>{SITE.author.name}</h1>
      <p>{SITE.description}</p>
      <p>这里记录技术研发、学习笔记与作品进展。</p>
    </article>
    <SidebarStack posts={posts} />
  </main>
</BaseLayout>

<style>
  .about-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; padding-block: clamp(2.5rem, 6vw, 5rem); }
  article { min-width: 0; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: clamp(1.5rem, 5vw, 3rem); background: var(--color-surface); box-shadow: var(--shadow-panel); }
  h1 { margin: 0; color: var(--color-heading, var(--color-text)); }
  p { color: var(--color-muted); }
  @media (min-width: 1025px) {
    .about-main { grid-template-columns: minmax(240px, 280px) minmax(0, 1fr); }
    article { grid-column: 2; grid-row: 1; }
    .about-main :global([data-sidebar-stack]) { grid-column: 1; grid-row: 1; }
  }
</style>
