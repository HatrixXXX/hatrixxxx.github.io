---
import BackButton from '@/components/BackButton.astro';
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="随笔" bodyClass="nav-content-page plain-page">
  <BackButton href="/" label="返回主页" />
  <main class="snippets-main container">
    <EmptyState title="暂时没有公开的随笔" />
  </main>
</BaseLayout>

<style>
  .snippets-main {
    max-width: 920px;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
</style>
