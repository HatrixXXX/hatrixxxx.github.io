---
import { getCollection, type CollectionEntry } from 'astro:content';
import BackButton from '@/components/BackButton.astro';
import BackToTop from '@/components/BackToTop.astro';
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { snippetPath, sortSnippets } from '@/lib/snippets';
import '@/styles/snippets-timeline.css';

const snippets = sortSnippets(await getCollection('snippets') as CollectionEntry<'snippets'>[]);
const formatDate = (date: Date) =>
  `${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}.${String(date.getUTCDate()).padStart(2, '0')}`;
---

<BaseLayout title="随笔" description="Hatrix 的随笔，沿时间线从新近的记录读到最早的一篇。" bodyClass="snippets-page plain-page nav-content-page">
  <BackButton href="/" label="返回主页" cornerAligned={true} />
  <main class="snippets-main container" data-snippets-timeline aria-label="随笔">
    <section class="snippets-chronicle" aria-label="随笔时间线">
      <div class="chronicle-crown" aria-hidden="true">
        <img src="/assets/snippets-timeline/upper-rune-bowl-blue-gunmetal.webp" width="528" height="454" alt="" decoding="async" />
      </div>

      <div class="chronicle-body" data-timeline-body>
        <div class="chronicle-conduit" aria-hidden="true">
          <span class="conduit-liquid" data-timeline-liquid></span>
          <span class="conduit-bubbles">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </span>
        </div>

        {snippets.length > 0 ? (
          <ol class="chronicle-list">
            {snippets.map((entry, index) => (
              <li class:list={['chronicle-entry', index % 2 === 0 ? 'entry-left' : 'entry-right']} data-timeline-entry>
                <span class="entry-branch" aria-hidden="true"></span>
                <span class="entry-junction" aria-hidden="true"><span></span></span>
                <div class="snippet-reveal">
                <a class="snippet-card" href={snippetPath(entry.id)} aria-label={`${entry.data.title}，${formatDate(entry.data.date)}`}>
                  <span class="snippet-card-art" aria-hidden="true">
                    <img src={entry.data.cover || '/assets/blog-cards/default-cover.webp'} alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="snippet-card-content">
                    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                    <strong>{entry.data.title}</strong>
                    {entry.data.description && <span class="snippet-summary">{entry.data.description}</span>}
                  </span>
                </a>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <div class="chronicle-empty">
            <span class="empty-junction" aria-hidden="true"></span>
            <span class="empty-branch" aria-hidden="true"></span>
            <EmptyState title="还没有随笔" description="第一篇写好后，会从这里沿时间线展开。" />
          </div>
        )}
      </div>

      <div class="chronicle-terminal" aria-hidden="true">
        <picture>
          <source media="(max-width: 700px)" srcset="/assets/snippets-timeline/lower-rune-bowl-mobile.webp" />
          <img src="/assets/snippets-timeline/lower-rune-bowl.webp" width="680" height="203" alt="" decoding="async" />
        </picture>
      </div>
    </section>
  </main>
  <BackToTop />
  <BackToTop direction="bottom" />
</BaseLayout>

<script>
  import '@/scripts/back-to-top';
  import '@/scripts/snippets-timeline';
</script>
