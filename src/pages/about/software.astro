---
import BackButton from '@/components/BackButton.astro';
import ToolModule from '@/components/ToolModule.astro';
import { SOFTWARE_TOOLS, SOFTWARE_TOOL_CATEGORIES } from '@/data/software-tools';
import BaseLayout from '@/layouts/BaseLayout.astro';

const description = '收录常用软件、在线工具和工作中会反复打开的站点。';
const orderedTools = SOFTWARE_TOOL_CATEGORIES.flatMap((category) =>
  SOFTWARE_TOOLS.filter((tool) => tool.category === category.id)
);
---

<BaseLayout title="工具箱" description={description} bodyClass="software-page nav-content-page plain-page">
  <BackButton href="/" label="返回主页" />

  <main class="toolbox-main container" aria-label="工具箱">
    <div class="tool-deck" data-tool-deck>
      <div class="tool-grid" data-tool-grid>
        {orderedTools.map((tool) => <ToolModule tool={tool} />)}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  :global(body.software-page.nav-content-page.plain-page) > main.toolbox-main {
    padding-top: calc(var(--header-height) + 4.5rem);
    padding-bottom: clamp(5rem, 8vw, 7rem);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: clamp(0.4rem, 0.7vw, 0.65rem);
  }

  :global(body.software-page [data-sakana-layer]) {
    display: none;
  }

  @media (min-width: 769px) {
    :global(body.software-page.nav-content-page.plain-page) > main.toolbox-main {
      padding-top: calc(var(--header-height) + 1rem);
    }

    .tool-deck {
      padding-top: 3.5rem;
    }
  }

  @media (max-width: 1100px) {
    .tool-grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .tool-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    :global(body.software-page.nav-content-page.plain-page) > main.toolbox-main {
      width: min(100% - 1rem, var(--content-width));
    }

    .tool-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
    }
  }
</style>
