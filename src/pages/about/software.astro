---
import BackButton from '@/components/BackButton.astro';
import ToolSpecimen from '@/components/ToolSpecimen.astro';
import { SOFTWARE_TOOLS } from '@/data/software-tools';
import BaseLayout from '@/layouts/BaseLayout.astro';

const description = '收录常用软件、在线工具和工作中会反复打开的站点。';
const shelves = ([
  { kind: 'software' as const, capacity: 6, slotWidth: '148px' },
  { kind: 'link' as const, capacity: 8, slotWidth: '108px' }
]).flatMap(({ kind, capacity, slotWidth }) => {
  const tools = SOFTWARE_TOOLS.filter((tool) => tool.kind === kind);
  return Array.from({ length: Math.ceil(tools.length / capacity) }, (_, index) => ({
    kind,
    capacity,
    slotWidth,
    slots: Array.from(
      { length: capacity },
      (__, slotIndex) => tools[index * capacity + slotIndex]
    )
  }));
});
---

<BaseLayout title="工具箱" description={description} pageSubtitle={description} bodyClass="software-page plain-page">
  <BackButton href="/" label="返回主页" />

  <main class="tool-cabinet container" aria-label="工具箱">
    <div class="tool-shelves">
      {shelves.map((shelf, shelfIndex) => (
        <section
          class="tool-shelf"
          aria-label={`工具平台 ${shelfIndex + 1}`}
          data-tool-shelf
          data-shelf-kind={shelf.kind}
          style={`--shelf-columns: ${shelf.capacity}; --shelf-slot-width: ${shelf.slotWidth}`}
        >
          <div class="tool-grid">
            {shelf.slots.map((tool) => (
              <div class="tool-slot" data-tool-slot data-empty={tool ? undefined : ''}>
                {tool && <ToolSpecimen tool={tool} />}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .tool-cabinet {
    position: relative;
    padding-block: calc(var(--header-height) + 2rem) clamp(5rem, 8vw, 7rem);
  }

  .tool-cabinet::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 2.5rem;
    border: 1px solid rgb(190 174 204 / 12%);
    border-radius: 8px;
    background:
      linear-gradient(155deg, rgb(245 224 193 / 3%), transparent 38%),
      rgb(23 21 29 / 74%);
    box-shadow: 0 18px 48px rgb(8 6 12 / 18%), inset 0 1px rgb(255 255 255 / 4%);
    backdrop-filter: blur(4px);
  }

  .tool-shelves {
    display: grid;
    gap: 0.5rem;
    padding-inline: clamp(0.5rem, 1.5vw, 1rem);
  }

  .tool-shelf {
    min-width: 0;
  }

  .tool-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--shelf-columns), minmax(0, 1fr));
    align-items: end;
    column-gap: 10px;
    min-width: 0;
    padding: 0 8px 34px;
  }

  .tool-grid::before {
    content: '';
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 18px;
    left: 0;
    height: 16px;
    border: 1px solid #59483d;
    border-top-color: #916b4c;
    border-radius: 3px 3px 6px 6px;
    background:
      linear-gradient(180deg, rgb(255 226 176 / 10%), transparent 35%),
      linear-gradient(90deg, #241c1e, #392a26 50%, #201a1d);
    box-shadow: 0 10px 14px rgb(5 4 8 / 38%), inset 0 -3px rgb(0 0 0 / 22%);
  }

  .tool-grid::after {
    content: '';
    position: absolute;
    z-index: 0;
    right: 8%;
    bottom: 0;
    left: 8%;
    height: 20px;
    background:
      linear-gradient(90deg, #21191b 0 9px, transparent 9px calc(100% - 9px), #21191b calc(100% - 9px));
    opacity: 0.9;
  }

  .tool-grid :global([data-tool-specimen]) {
    z-index: 1;
  }

  .tool-slot {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    align-items: end;
  }

  :global(html[data-theme='light'] body.software-page) .tool-cabinet::before {
    border-color: rgb(84 65 94 / 14%);
    background:
      linear-gradient(155deg, rgb(255 255 255 / 40%), transparent 38%),
      rgb(240 236 228 / 78%);
    box-shadow: 0 18px 48px rgb(58 43 35 / 9%), inset 0 1px rgb(255 255 255 / 55%);
  }

  @media (max-width: 900px) {
    .tool-cabinet {
      width: min(100% - 1rem, var(--content-width));
      padding-top: calc(var(--header-height) + 1.5rem);
    }

    .tool-cabinet::before {
      inset-inline: -0.25rem;
    }

    .tool-shelves {
      gap: 0.35rem;
      padding-inline: 0;
    }

    .tool-shelf {
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
    }

    .tool-grid {
      grid-template-columns: repeat(var(--shelf-columns), var(--shelf-slot-width));
      width: max-content;
      min-width: 100%;
      padding-inline: 10px;
    }

    .tool-grid :global([data-tool-specimen]) {
      scroll-snap-align: start;
    }
  }
</style>
