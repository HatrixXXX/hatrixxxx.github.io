---
import ProfileSidebar from '@/components/ProfileSidebar.astro';
import SidebarStack from '@/components/SidebarStack.astro';
import SiteStats from '@/components/SiteStats.astro';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FRIENDS } from '@/data/friends';
import { getCollection } from 'astro:content';
import { buildSiteStats } from '@/lib/site-stats';

const posts = await getCollection('posts');
const stats = posts.length > 0 ? buildSiteStats(posts) : null;
---

<BaseLayout title="友链" bodyClass="friends-page nav-content-page plain-page">
  <BackButton href="/" label="返回主页" />
  <main class="friends-main container">
    <SidebarStack posts={[]} showClock={false} showStats={false}>
      <ProfileSidebar />
      {stats && <SiteStats stats={stats} showClock={false} visitorLabel="访问数" />}
    </SidebarStack>
    <div class="friends-content">
      <ul class="friends-grid" role="list">
        {FRIENDS.map((friend) => {
          const faviconUrl = new URL(friend.url).origin + '/favicon.ico';
          const initial = friend.name.charAt(0).toUpperCase();
          return (
            <li>
              <a
                class="friend-card"
                href={friend.url}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={friend.name}
              >
                <img
                  class="friend-avatar"
                  src="/assets/images/default-avatar.svg" data-src={friend.avatar}
                  data-fallback-favicon={faviconUrl}
                  data-fallback-initial={initial}
                  alt={friend.name}
                  width="64"
                  height="64"
                  loading="lazy"
                />
                <div class="friend-info">
                  <span class="friend-name">{friend.name}</span>
                  <span class="friend-desc">{friend.description}</span>
                  <span class="friend-url">{friend.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </main>

<script>
  document.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
    const avatarUrl = img.dataset.src!;
    const faviconUrl = img.dataset.fallbackFavicon!;
    const initial = img.dataset.fallbackInitial ?? '?';

    function makeSvgFallback() {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 56 56"><rect width="56" height="56" rx="28" fill="var(--color-inset,#2a2a3a)"/><text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" font-size="24" font-family="system-ui,sans-serif" fill="var(--color-muted,#888)">${initial}</text></svg>`;
      img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
    }

    function onFaviconError() {
      img.removeEventListener('error', onFaviconError);
      makeSvgFallback();
    }

    function onAvatarError() {
      img.removeEventListener('error', onAvatarError);
      img.addEventListener('error', onFaviconError);
      img.src = faviconUrl;
    }

    img.addEventListener('error', onAvatarError);
    img.src = avatarUrl;
  });
</script>
</BaseLayout>

<style>
  :global(body.friends-page) {
    overflow: hidden;
  }

  .friends-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    height: 100dvh;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .friends-content {
    min-width: 0;
    height: 100%;
    overflow-y: auto;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .friend-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--chassis-edge);
    border-radius: 3px;
    background:
      linear-gradient(130deg, rgb(0 221 235 / 7%), transparent 43%),
      linear-gradient(180deg, rgb(245 224 193 / 5%), transparent 26%),
      var(--color-surface);
    box-shadow: inset 0 0 0 3px var(--chassis-groove), 0 10px 26px rgb(4 5 10 / 25%);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .friend-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1rem;
    width: 65%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-copper), transparent);
    transform: scaleX(0.55);
    transform-origin: left;
    transition: transform 220ms var(--ease-out), background-color 220ms ease;
  }

  .friend-card::after {
    content: '';
    position: absolute;
    top: 10px;
    right: 11px;
    width: 6px;
    height: 6px;
    border: 1px solid var(--color-link);
    background: rgb(0 221 235 / 15%);
    box-shadow: 0 0 0 3px var(--chassis-groove);
    transition: background-color 180ms ease, box-shadow 180ms ease;
  }

  .friend-card:hover,
  .friend-card:focus-visible {
    border-color: var(--color-accent);
    background-color: var(--color-surface-raised);
    box-shadow: inset 0 0 0 3px var(--chassis-groove), 0 16px 35px rgb(4 5 10 / 40%);
  }

  .friend-card:is(:hover, :focus-visible)::before {
    background: linear-gradient(90deg, var(--color-accent), var(--color-link), transparent);
    transform: scaleX(1);
  }

  .friend-card:is(:hover, :focus-visible)::after {
    background: var(--color-link);
    box-shadow: 0 0 0 3px var(--chassis-groove), 0 0 12px var(--color-link);
  }

  .friend-card:active {
    box-shadow: inset 0 0 0 4px var(--chassis-groove);
    transition-duration: 80ms;
  }

  .friend-avatar {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--color-line-strong);
    object-fit: cover;
    background: var(--color-inset);
  }

  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
    overflow: hidden;
  }

  .friend-name {
    color: var(--color-heading);
    font-size: 0.95rem;
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-desc {
    color: var(--color-text);
    font-size: 0.8rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .friend-url {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-family: var(--font-data);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 1025px) {
    .friends-main {
      grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
      padding-inline: 0;
    }

    .friends-content {
      grid-column: 2;
      grid-row: 1;
    }

    .friends-main :global([data-sidebar-stack]) {
      grid-column: 1;
      grid-row: 1;
      position: static !important;
      align-self: start;
      align-content: start;
      height: 100%;
      overflow-y: auto;
      padding-bottom: clamp(2rem, 4vw, 3.5rem);
    }
  }

  @media (max-width: 1024px) {
    .friends-main {
      overflow-y: auto;
    }

    .friends-content {
      height: auto;
      overflow-y: visible;
      padding-block: 1.5rem clamp(2.5rem, 6vw, 5rem);
    }
  }
</style>
