---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import HeroBanner from '@/components/HeroBanner.astro';
import PostList from '@/components/PostList.astro';
import ProfileSidebar from '@/components/ProfileSidebar.astro';
import WaveDivider from '@/components/WaveDivider.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildTaxonomy, sortPosts, type PostEntry } from '@/lib/content';

interface Props {
  tag: string;
  posts: PostEntry[];
  postCount: number;
  categoryCount: number;
  tagCount: number;
}

export const getStaticPaths = (async () => {
  const allPosts = sortPosts(await getCollection('posts', ({ data }: PostEntry) => !data.draft));
  const tags = buildTaxonomy(allPosts, 'tags');
  const categoryCount = buildTaxonomy(allPosts, 'category').size;

  return [...tags.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts, postCount: allPosts.length, categoryCount, tagCount: tags.size }
  }));
}) satisfies GetStaticPaths;

const { tag, posts, postCount, categoryCount, tagCount } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <HeroBanner title={`# ${tag}`} subtitle={`${posts.length} 篇文章`} image="/images/default-cover.svg" compact />
  <WaveDivider />
  <main class="index-main container with-sidebar">
    <section><PostList posts={posts} /></section>
    <aside><ProfileSidebar postCount={postCount} categoryCount={categoryCount} tagCount={tagCount} /></aside>
  </main>
</BaseLayout>

<style>
  .index-main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 290px); gap: clamp(1.5rem, 3vw, 2.5rem); padding-block: clamp(2.5rem, 6vw, 5rem); }
  .index-main > section { min-width: 0; }
  @media (max-width: 1024px) { .index-main { grid-template-columns: minmax(0, 1fr); } aside { order: -1; } }
</style>
