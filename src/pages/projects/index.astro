---
import { getCollection, type CollectionEntry } from 'astro:content';
import BackButton from '@/components/BackButton.astro';
import ToolSpecimen from '@/components/ToolSpecimen.astro';
import type { SoftwareTool, ToolIconName, ToolTone } from '@/data/software-tools';
import BaseLayout from '@/layouts/BaseLayout.astro';

type ProjectSpecimen = Pick<SoftwareTool, 'name' | 'description' | 'tone' | 'kind'> & { icon: ToolIconName; href?: string };

const projects = (await getCollection('projects')) as CollectionEntry<'projects'>[];
projects.sort((a, b) => a.data.order - b.data.order);
const icons: readonly ToolIconName[] = [
  'code', 'chart', 'network', 'book', 'transfer', 'utility', 'palette', 'search', 'archive', 'capture'
];
const tones: readonly ToolTone[] = ['cyan', 'amber', 'green', 'violet'];
const specimens: ProjectSpecimen[] = projects.map((project, index) => ({
  name: project.data.title,
  description: project.data.description,
  href: project.data.links[0]?.url,
  icon: icons[index % icons.length],
  tone: tones[index % tones.length],
  kind: project.data.featured ? 'software' : 'link'
}));
const shelves = ([
  { kind: 'software' as const, size: 'large' as const, capacity: 4, slotWidth: '230px' },
  { kind: 'link' as const, size: 'small' as const, capacity: 6, slotWidth: '160px' }
]).flatMap(({ kind, size, capacity, slotWidth }) => {
  const items = specimens.filter((item) => item.kind === kind);
  return Array.from({ length: Math.ceil(items.length / capacity) }, (_, index) => ({
    kind,
    size,
    capacity,
    slotWidth,
    slots: Array.from({ length: capacity }, (__, slotIndex) => items[index * capacity + slotIndex])
  }));
});
---

<BaseLayout title="作品橱窗" bodyClass="projects-page plain-page">
  <BackButton href="/" label="返回主页" />

  <main class="project-cabinet container" aria-label="示例作品橱窗">
    <div class="project-shelves">
      {shelves.map((shelf, shelfIndex) => (
        <section
          class="project-shelf"
          aria-label={`作品平台 ${shelfIndex + 1}`}
          data-project-shelf
          data-shelf-size={shelf.size}
          style={`--shelf-columns: ${shelf.capacity}; --shelf-slot-width: ${shelf.slotWidth}`}
        >
          <div class="project-grid">
            {shelf.slots.map((project) => (
              <div class="project-slot" data-empty={project ? undefined : ''}>
                {project && <ToolSpecimen tool={project} specimenKind="project" />}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .project-cabinet {
    position: relative;
    padding-block: calc(var(--header-height) + 2rem) clamp(5rem, 8vw, 7rem);
  }

  .project-cabinet::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(var(--header-height) + 1rem) 0 2.5rem;
    border: 1px solid rgb(190 174 204 / 12%);
    border-radius: 8px;
    background:
      linear-gradient(155deg, rgb(245 224 193 / 3%), transparent 38%),
      rgb(23 21 29 / 74%);
    box-shadow: 0 18px 48px rgb(8 6 12 / 18%), inset 0 1px rgb(255 255 255 / 4%);
    backdrop-filter: blur(4px);
  }

  .project-shelves {
    display: grid;
    gap: 1.25rem;
    padding-inline: clamp(0.5rem, 1.5vw, 1rem);
  }

  .project-shelf {
    min-width: 0;
  }

  .project-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--shelf-columns), minmax(0, 1fr));
    align-items: end;
    justify-content: center;
    column-gap: 12px;
    min-width: 0;
    padding: 0 8px 34px;
  }

  .project-grid::before {
    content: '';
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 18px;
    left: 0;
    height: 16px;
    border: 1px solid #59483d;
    border-top-color: #916b4c;
    border-radius: 3px 3px 6px 6px;
    background:
      linear-gradient(180deg, rgb(255 226 176 / 10%), transparent 35%),
      linear-gradient(90deg, #241c1e, #392a26 50%, #201a1d);
    box-shadow: 0 10px 14px rgb(5 4 8 / 38%), inset 0 -3px rgb(0 0 0 / 22%);
  }

  .project-grid::after {
    content: '';
    position: absolute;
    z-index: 0;
    right: 8%;
    bottom: 0;
    left: 8%;
    height: 20px;
    background:
      linear-gradient(90deg, #21191b 0 9px, transparent 9px calc(100% - 9px), #21191b calc(100% - 9px));
    opacity: 0.9;
  }

  .project-grid :global([data-project-specimen]) {
    z-index: 1;
  }

  .project-slot {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    align-items: end;
  }

  :global(html[data-theme='light'] body.projects-page) .project-cabinet::before {
    border-color: rgb(84 65 94 / 14%);
    background:
      linear-gradient(155deg, rgb(255 255 255 / 40%), transparent 38%),
      rgb(240 236 228 / 78%);
    box-shadow: 0 18px 48px rgb(58 43 35 / 9%), inset 0 1px rgb(255 255 255 / 55%);
  }

  @media (max-width: 900px) {
    .project-cabinet {
      width: min(100% - 1rem, var(--content-width));
      padding-top: calc(var(--header-height) + 1.5rem);
    }

    .project-cabinet::before {
      inset-inline: -0.25rem;
    }

    .project-shelves {
      gap: 0.75rem;
      padding-inline: 0;
    }

    .project-shelf {
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
    }

    .project-grid {
      grid-template-columns: repeat(var(--shelf-columns), var(--shelf-slot-width));
      justify-content: start;
      width: max-content;
      min-width: 100%;
      padding-inline: 10px;
    }

    .project-grid :global([data-project-specimen]) {
      scroll-snap-align: start;
    }
  }
</style>
