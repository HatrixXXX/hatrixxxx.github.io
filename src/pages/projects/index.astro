---
import { getCollection, type CollectionEntry } from 'astro:content';
import BackButton from '@/components/BackButton.astro';
import ProjectArchiveCard from '@/components/ProjectArchiveCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/project-archive.css';

const projects = (await getCollection('projects')) as CollectionEntry<'projects'>[];
projects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="作品橱窗" description="Hatrix 的项目档案与制作记录。" bodyClass="projects-page plain-page nav-content-page">
  <BackButton href="/" label="返回主页" />

  <main class="project-atlas container" aria-labelledby="projects-heading">
    <header class="project-atlas-head">
      <div>
        <h1 id="projects-heading">作品橱窗</h1>
        <p>选择一张卡片，读取项目档案。照片和制作记录会陆续补充。</p>
      </div>
      <div class="project-atlas-count" aria-label={`收录 ${projects.length} 个作品`}>
        <span>收录作品</span>
        <strong>{String(projects.length).padStart(2, '0')}</strong>
      </div>
    </header>

    <div class="project-atlas-rail" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="project-atlas-grid">
      {projects.map((project, index) => <ProjectArchiveCard project={project} index={index} total={projects.length} />)}
    </div>
  </main>
</BaseLayout>

<script>
  import '@/scripts/project-archive';
</script>
