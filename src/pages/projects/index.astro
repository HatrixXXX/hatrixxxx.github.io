---
import { getCollection, type CollectionEntry } from 'astro:content';
import EmptyState from '@/components/EmptyState.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectLoadingAnimation from '@/components/ProjectLoadingAnimation.astro';
import BackButton from '@/components/BackButton.astro';

const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
const debugLoadingOnly = true;
---

<BaseLayout title="作品" bodyClass={debugLoadingOnly ? 'projects-loading-view' : undefined}>
  <BackButton href="/" label="返回主页" />
  <main class="projects-main container">
    {debugLoadingOnly ? (
      <ProjectLoadingAnimation />
    ) : (
      <>
        <HeroBanner title="作品" subtitle="项目与实验记录" image="/images/default-cover.svg" compact />
        {projects.length === 0 ? (
          <EmptyState title="作品内容还没添加" description="新的项目与实验记录会陆续整理到这里。" />
        ) : (
          <section class="project-grid" aria-label="作品列表">
            {projects.map((project) => (
              <article>
                <h2>{project.data.title}</h2>
                <p>{project.data.description}</p>
              </article>
            ))}
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>

<style>
  :global(body.projects-loading-view) {
    overflow: hidden;
    background: #000;
  }

  :global(body.projects-loading-view .projects-main) {
    padding-block: 0;
  }

  .projects-main { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  article { border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 1.5rem; background: var(--color-surface); box-shadow: var(--shadow-panel); }
  h2 { margin: 0; color: #fff; }
  p { margin-bottom: 0; color: var(--color-muted); }
</style>
