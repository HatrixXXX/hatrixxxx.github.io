---
import TwikooComments from '@/components/TwikooComments.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BackButton from '@/components/BackButton.astro';
---

<BaseLayout title="留言板" bodyClass="guestbook-page nav-content-page plain-page">
  <BackButton href="/" label="返回主页" />
  <main class="guestbook-main container">
    <section class="guestbook-shell" aria-label="留言板" data-guestbook-shell>
      <div class="guestbook-board">
        <TwikooComments variant="guestbook" />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .guestbook-main {
    max-width: 1120px;
    min-height: 100svh;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .guestbook-shell {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border: 1px solid var(--chassis-edge);
    border-radius: 8px;
    padding: clamp(1.2rem, 3vw, 2.25rem) clamp(1.25rem, 3.6vw, 3rem) clamp(1.5rem, 3.6vw, 3rem);
    background-color: rgb(15 18 27 / 82%);
    background-image:
      linear-gradient(160deg, rgb(0 221 235 / 10%), transparent 28% 75%, rgb(216 140 60 / 9%)),
      repeating-linear-gradient(90deg, transparent 0 39px, rgb(255 255 255 / 1.5%) 40px 41px);
    box-shadow:
      inset 0 0 0 5px rgb(4 8 16 / 78%),
      inset 0 0 0 6px rgb(216 140 60 / 32%),
      inset 0 26px 44px rgb(0 221 235 / 3%),
      0 26px 70px rgb(2 5 11 / 52%);
    backdrop-filter: blur(18px) saturate(118%);
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  .guestbook-shell:hover,
  .guestbook-shell:focus-within {
    border-color: rgb(255 210 0 / 72%);
    box-shadow:
      inset 0 0 0 5px rgb(4 8 16 / 78%),
      inset 0 0 0 6px rgb(216 140 60 / 42%),
      inset 0 26px 44px rgb(0 221 235 / 5%),
      0 26px 70px rgb(2 5 11 / 52%),
      0 0 30px rgb(255 210 0 / 8%);
  }

  .guestbook-shell::before {
    position: absolute;
    z-index: -1;
    inset: 6px;
    background:
      linear-gradient(90deg, var(--color-link), transparent 72%) left top / 130px 2px no-repeat,
      linear-gradient(270deg, var(--color-copper), transparent 72%) right bottom / 130px 2px no-repeat,
      linear-gradient(180deg, rgb(0 221 235 / 45%), transparent 72%) left top / 2px 100px no-repeat,
      linear-gradient(0deg, rgb(216 140 60 / 52%), transparent 72%) right bottom / 2px 100px no-repeat,
      var(--surface-sheen);
    content: '';
    pointer-events: none;
  }

  .guestbook-board :global(.comments) {
    margin-top: 0;
  }

  .guestbook-board :global(.comments-status),
  .guestbook-board :global(noscript) {
    margin: 0;
    color: var(--color-muted);
  }

  @supports not ((backdrop-filter: blur(1px))) {
    .guestbook-shell {
      background-color: rgb(15 18 27 / 94%);
    }
  }

  @media (max-width: 640px) {
    :global(body.guestbook-page.plain-page) > main.guestbook-main {
      padding-top: calc(var(--header-height) + 4rem);
    }
  }

  @media (max-width: 420px) {
    .guestbook-shell {
      border-radius: var(--radius-card);
      padding-inline: 1rem;
    }

    .guestbook-board {
      margin-left: 55px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guestbook-shell {
      transition: none;
    }
  }
</style>
