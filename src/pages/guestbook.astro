---
import TwikooComments from '@/components/TwikooComments.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BackButton from '@/components/BackButton.astro';
import '@/styles/guestbook-terminal.css';
---

<BaseLayout title="留言板" bodyClass="guestbook-page nav-content-page plain-page">
  <BackButton href="/" label="返回主页" cornerAligned={true} />
  <main class="guestbook-main container">
    <section class="guestbook-shell" aria-label="留言板" data-guestbook-shell>
      <div class="guestbook-screen" role="region" aria-label="留言内容" tabindex="0" data-guestbook-scroll data-lenis-prevent>
        <div class="guestbook-board">
          <TwikooComments variant="guestbook" />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
