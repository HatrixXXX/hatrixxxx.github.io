---
import TwikooComments from '@/components/TwikooComments.astro';
import PostCard from '@/components/PostCard.astro';
import PostLink from '@/components/PostLink.astro';
import ProtectedContent from '@/components/ProtectedContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { PostEntry } from '@/lib/content';
import { postSchema } from '@/lib/post-schema';

interface Props {
  slug: string;
  label: string;
}

export const prerender = true;

export function getStaticPaths() {
  if (process.env.PLAYWRIGHT_TEST !== '1') return [];

  return [
    { params: { slug: 'protected' }, props: { slug: 'protected', label: '第一页' } },
    { params: { slug: 'remembered' }, props: { slug: 'remembered', label: '第二页' } },
    { params: { slug: 'locked-index' }, props: { slug: 'locked-index', label: '公开索引' } }
  ];
}

const { slug, label } = Astro.props;
const route = `/__tests__/${slug}/`;
const publicIndex = slug === 'locked-index';
const legacyPost = {
  id: 'locked-index-fixture',
  collection: 'posts',
  body: 'public-blog-body-marker',
  data: postSchema.parse({
    title: '旧字段公开文章标题',
    summary: '旧字段公开文章摘要',
    pubDate: new Date('2026-09-03'),
    cover: '/assets/blog-cards/default-cover.webp',
    locked: true,
    legacySlug: 'locked-index-fixture'
  })
} as PostEntry;
const publicPost = {
  ...legacyPost,
  id: 'public-index-fixture',
  data: {
    ...legacyPost.data,
    title: '公开文章标题',
    legacySlug: 'public-index-fixture'
  }
} as PostEntry;
---

<BaseLayout title={publicIndex ? '公开博客索引测试' : `加锁测试${label}`} canonicalPath={route} noindex={publicIndex}>
  {
    publicIndex ? (
      <main class="container">
        <PostCard post={legacyPost} />
        {['footer', 'archive', 'adjacent'].map((surface) => (
          <section data-post-link-surface={surface}>
            <PostLink
              post={legacyPost}
              direction={surface === 'adjacent' ? '上一篇' : undefined}
              data-fixture-state="legacy"
            />
            <PostLink
              post={publicPost}
              direction={surface === 'adjacent' ? '上一篇' : undefined}
              data-fixture-state="public"
            />
          </section>
        ))}
      </main>
    ) : (
      <ProtectedContent locked route={route} title={`加锁测试${label}`}>
        <main class="container" data-protected-test-content={slug}>
          <nav aria-label="测试目录">
            <a href="#protected-heading" data-toc-link="protected-heading">测试小节</a>
          </nav>
          <article>
            <h1>仅管理员可见的{label}正文</h1>
            <h2 id="protected-heading">解锁后的测试小节</h2>
            <p>protected-e2e-secret-{slug}</p>
            <img
              src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
              alt="解锁后的测试图片"
              title="受保护图片标题"
              data-protected-src="/protected-content/assets/test-image.bin"
              data-protected-type="image/png"
            />
            <pre><code class="language-mermaid">graph TD; A--&gt;B;</code></pre>
            <a href={slug === 'protected' ? '/__tests__/remembered/' : '/__tests__/protected/'} data-test-next>
              前往另一加锁页
            </a>
          </article>
          <TwikooComments title="测试评论" />
        </main>
      </ProtectedContent>
    )
  }
</BaseLayout>

<script>
  import '@/scripts/mermaid';
  import '@/scripts/toc';
</script>
