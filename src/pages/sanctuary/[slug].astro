---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BackButton from '@/components/BackButton.astro';
import BackToTop from '@/components/BackToTop.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanctuaryPath, sortSanctuary } from '@/lib/sanctuary';
import { deriveContentKeyBytes } from '@/lib/protected-content/crypto';
import { renderProtectedMarkdown } from '@/lib/protected-content/markdown';
import { adminKeyFromEnvironment } from '@/lib/protected-content/server';

interface Props {
  sanctuary: CollectionEntry<'sanctuary'>;
  adjacent: {
    previous?: CollectionEntry<'sanctuary'>;
    next?: CollectionEntry<'sanctuary'>;
  };
}

export const getStaticPaths = (async () => {
  const entries = sortSanctuary(await getCollection('sanctuary'));
  return entries.map((sanctuary, index) => ({
    params: { slug: sanctuary.id },
    props: {
      sanctuary,
      adjacent: { previous: entries[index - 1], next: entries[index + 1] }
    }
  }));
}) satisfies GetStaticPaths;

const { sanctuary, adjacent } = Astro.props;
const protectedHtml = sanctuary.body?.trim()
  ? (await renderProtectedMarkdown(
      sanctuary,
      await deriveContentKeyBytes(adminKeyFromEnvironment())
    )).html
  : undefined;
---

<BaseLayout title="秘境" description="加锁秘境文章" canonicalPath={sanctuaryPath(sanctuary.id)} noindex={true} locked={true} bodyClass="sanctuary-entry-page plain-page">
  <BackButton href="/sanctuary/" label="返回秘境总览" belowHeader={true} />
  <main class="sanctuary-entry-main container">
    <article data-post>
      <header class="sanctuary-entry-header"><h1>{sanctuary.data.title}</h1></header>
      <div class="prose">
        {protectedHtml !== undefined ? <Fragment set:html={protectedHtml} /> : <p>正文待补充。</p>}
      </div>
      {(adjacent.previous || adjacent.next) && (
        <nav class="adjacent-posts" aria-label="相邻笔记" data-adjacent-sanctuary>
          {adjacent.previous ? (
            <a href={sanctuaryPath(adjacent.previous.id)} rel="prev">
              <span>上一篇笔记</span>
              <strong>{adjacent.previous.data.title}</strong>
            </a>
          ) : <span aria-hidden="true" />}
          {adjacent.next && (
            <a href={sanctuaryPath(adjacent.next.id)} rel="next">
              <span>下一篇笔记</span>
              <strong>{adjacent.next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>
  </main>
  <BackToTop />
  <BackToTop direction="bottom" />
</BaseLayout>

<script>
  import '@/scripts/back-to-top';
</script>

<style>
  .sanctuary-entry-main { width: min(100% - 2rem, 940px); padding-block: clamp(6rem, 11vw, 9rem) 5rem; }
  .sanctuary-entry-header { margin-bottom: clamp(2.5rem, 6vw, 4rem); padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-copper); }
  .sanctuary-entry-header h1 { margin: 0; color: var(--color-heading); font-size: clamp(2rem, 5vw, 3.75rem); line-height: 1.2; }

  .adjacent-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .adjacent-posts a {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    min-height: 124px;
    border: 1px solid var(--chassis-edge);
    border-radius: var(--radius-card);
    padding: 1.45rem 1.35rem 1.2rem;
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: inset 0 0 0 4px var(--chassis-groove), inset 0 5px 12px rgb(0 0 0 / 18%), 0 10px 24px rgb(3 5 11 / 22%);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .adjacent-posts a::before {
    content: '';
    flex: none;
    align-self: flex-start;
    width: 65%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-copper), transparent);
    transform: scaleX(0.615);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out), background-color var(--duration-normal) ease;
  }

  .adjacent-posts a:hover,
  .adjacent-posts a:focus-visible {
    border-color: var(--color-copper);
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 4px var(--chassis-groove), inset 0 5px 12px rgb(0 0 0 / 18%), 0 14px 28px rgb(3 5 11 / 32%);
  }

  .adjacent-posts a:is(:hover, :focus-visible)::before {
    background: linear-gradient(90deg, var(--color-accent), var(--color-link), transparent);
    transform: scaleX(1);
  }

  .adjacent-posts a[rel='next'] { text-align: right; }

  .adjacent-posts a[rel='next']::before {
    align-self: flex-end;
    background: linear-gradient(270deg, var(--color-copper), transparent);
    transform-origin: right;
  }

  .adjacent-posts a[rel='next']:is(:hover, :focus-visible)::before {
    background: linear-gradient(270deg, var(--color-accent), var(--color-link), transparent);
  }

  .adjacent-posts a > span {
    color: var(--color-copper);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .adjacent-posts a > strong {
    color: var(--color-heading);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .adjacent-posts a:is(:hover, :focus-visible) > strong { color: var(--color-link); }

  @media (prefers-reduced-motion: reduce) {
    .adjacent-posts a,
    .adjacent-posts a::before { transition: none; }
    .adjacent-posts a:hover,
    .adjacent-posts a:focus-visible { transform: none; }
  }

  @media (max-width: 600px) {
    .adjacent-posts { grid-template-columns: minmax(0, 1fr); }
    .adjacent-posts > span { display: none; }
    .adjacent-posts a[rel='next'] { text-align: left; }
  }

  @media (max-width: 768px) { .sanctuary-entry-main { padding-top: 7rem; } }
</style>
