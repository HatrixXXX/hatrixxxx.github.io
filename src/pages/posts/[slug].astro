---
import type { GetStaticPaths, MarkdownHeading } from 'astro';
import { getCollection, render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import {
  getAdjacentPosts,
  sortPosts,
  type AdjacentPosts,
  type PostEntry
} from '@/lib/content';
import { deriveContentKeyBytes } from '@/lib/protected-content/crypto';
import { renderProtectedMarkdown } from '@/lib/protected-content/markdown';
import { adminKeyFromEnvironment } from '@/lib/protected-content/server';

interface Props {
  post: PostEntry;
  adjacent: AdjacentPosts;
}

export const getStaticPaths = (async () => {
  const posts = sortPosts(await getCollection('posts', ({ data }: PostEntry) => !data.draft));
  return posts.map((post) => ({
    params: { slug: post.data.legacySlug },
    props: { post, adjacent: getAdjacentPosts(posts, post.id) }
  }));
}) satisfies GetStaticPaths;

const { post, adjacent } = Astro.props;
const renderedPost = post.data.locked ? undefined : await render(post);
const Content = renderedPost?.Content;
const headings = post.data.locked
  ? (post.rendered?.metadata?.headings as MarkdownHeading[] | undefined) ?? []
  : renderedPost?.headings ?? [];
const protectedHtml = post.data.locked
  ? (await renderProtectedMarkdown(
      post,
      await deriveContentKeyBytes(adminKeyFromEnvironment())
    )).html
  : undefined;
---

<PostLayout post={post} headings={headings} adjacent={adjacent}>
  {protectedHtml !== undefined ? <Fragment set:html={protectedHtml} /> : Content && <Content />}
</PostLayout>
