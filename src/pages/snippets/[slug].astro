---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { snippetPath } from '@/lib/snippets';

interface Props {
  snippet: CollectionEntry<'snippets'>;
}

export const getStaticPaths = (async () => {
  const snippets = await getCollection('snippets');
  return snippets.map((snippet: CollectionEntry<'snippets'>) => ({
    params: { slug: snippet.id },
    props: { snippet }
  }));
}) satisfies GetStaticPaths;

const { snippet } = Astro.props;
const { Content } = await render(snippet);
const canonicalPath = snippetPath(snippet.id);
const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC'
}).format(snippet.data.date);
---

<BaseLayout
  title={snippet.data.title}
  description={snippet.data.description}
  image={snippet.data.cover}
  canonicalPath={canonicalPath}
  bodyClass="snippet-entry-page plain-page"
>
  <BackButton href="/snippets/" label="返回随笔总览" belowHeader={true} />
  <main class="snippet-entry-main container">
    <article data-post>
      <header class="snippet-entry-header">
        <h1>{snippet.data.title}</h1>
        <time datetime={snippet.data.date.toISOString()}>{date}</time>
      </header>
      <div class="prose"><Content /></div>
    </article>
  </main>
</BaseLayout>

<style>
  .snippet-entry-main {
    width: min(100% - 2rem, 940px);
    padding-block: clamp(6rem, 11vw, 9rem) 5rem;
  }

  .snippet-entry-header {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-copper);
  }

  .snippet-entry-header h1 {
    margin: 0 0 1rem;
    color: var(--color-heading);
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.2;
  }

  .snippet-entry-header time {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .snippet-entry-main { padding-top: 7rem; }
  }
</style>

<script>
  const bindSnippetReturn = () => {
    const back = document.querySelector<HTMLAnchorElement>('body.snippet-entry-page [data-back-button]');
    if (!back || back.dataset.snippetReturnBound) return;
    back.dataset.snippetReturnBound = 'true';
    back.addEventListener('click', () => {
      try { sessionStorage.setItem('hatrix:snippets:return', '1'); } catch { /* The link still navigates. */ }
    });
  };
  document.addEventListener('astro:page-load', bindSnippetReturn);
  bindSnippetReturn();
</script>
