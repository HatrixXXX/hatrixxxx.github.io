---
import { POST_TYPE_LINKS } from '@/config/navigation';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const blogCategories = [{ label: '全部文章', href: '/blog/all/' }, ...POST_TYPE_LINKS];
const categoryIcons = [
  'M4 4h6v16H4zM14 4h6v16h-6zM7 8h0M17 8h0',
  'm8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18',
  'm12 3 10 18H2zM12 9v5m0 4h0',
  'M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
  'm12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z',
  'm15 4 5 5M4 20l4-1 12-12-4-4L4 15zM4 20h16'
];
---

<BaseLayout title="博客文章">
  <BackButton href="/" label="返回主页" />
  <section class="blog-category-section" aria-labelledby="blog-category-title">
    <div class="blog-category-heading">
      <h1 id="blog-category-title">博客文章</h1>
    </div>
    <nav class="blog-category-nav" aria-label="博客文章分类" data-blog-category-nav>
      <ul class="blog-category-list">
        {blogCategories.map((category, index) => (
          <li style={`--blog-card-index: ${index};`}>
            <a
              href={category.href}
              data-blog-category-card
            >
              <svg class="blog-category-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d={categoryIcons[index]} />
              </svg>
              <span class="blog-category-label">{category.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  :global(html:has(.blog-category-section)),
  :global(body:has(.blog-category-section)) {
    overflow: hidden;
  }

  .blog-category-section {
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
    padding-block: clamp(2rem, 4vw, 4rem) clamp(2rem, 5vw, 4rem);
    background: var(--color-bg);
  }

  .blog-category-heading,
  .blog-category-nav {
    width: calc(100% - 4rem);
    max-width: none;
    margin-inline: auto;
  }

  .blog-category-heading {
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    padding-inline-start: clamp(3.75rem, 5vw, 4.5rem);
  }

  .blog-category-heading h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.8rem, 3.5vw, 3.25rem);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .blog-category-list {
    display: flex;
    gap: clamp(0.65rem, 1.25vw, 1.25rem);
    min-width: 0;
    margin: 0;
    padding: 0.2rem 0.125rem;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .blog-category-list::-webkit-scrollbar {
    display: none;
  }

  .blog-category-list li {
    display: flex;
    min-width: 0;
    flex: 1 0 0;
    animation: blog-card-enter 320ms var(--ease-out) both;
    animation-delay: calc(var(--blog-card-index) * 72ms);
  }

  @keyframes blog-card-enter {
    0% {
      opacity: 0.5;
      transform: translate3d(0, 4px, 0);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .blog-category-list a {
    position: relative;
    display: flex;
    width: 100%;
    min-height: clamp(28rem, calc(100svh - 10rem), 60rem);
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.1rem 1.4rem;
    background: var(--surface-sheen), var(--color-surface);
    color: var(--color-heading);
    box-shadow: var(--shadow-inset), var(--shadow-panel);
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .blog-category-list a::before {
    position: absolute;
    inset: auto 1.1rem 1.4rem;
    height: 1px;
    background: var(--color-line-strong);
    content: '';
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .blog-category-list a:hover,
  .blog-category-list a:focus-visible {
    border-color: var(--color-copper);
    background-color: var(--color-surface-raised);
    transform: translateY(-2px);
  }

  .blog-category-list a:hover::before,
  .blog-category-list a:focus-visible::before {
    background: var(--color-copper);
  }

  .blog-category-list a:active {
    transform: translateY(0);
    transition-duration: 100ms;
  }

  .blog-category-icon {
    position: absolute;
    top: 1.5rem;
    left: calc(50% - 12px);
    color: var(--color-copper);
  }

  .blog-category-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(1.25rem, 2.3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    writing-mode: vertical-rl;
    text-orientation: upright;
  }

  @media (max-width: 768px) {
    .blog-category-section {
      padding-block: 3.5rem 1.5rem;
    }

    .blog-category-heading,
    .blog-category-nav {
      width: calc(100% - 2rem);
    }

    .blog-category-list li {
      flex: 0 0 min(42vw, 12rem);
    }

    .blog-category-list a {
      min-height: clamp(30rem, calc(100svh - 9rem), 48rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-category-list li {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .blog-category-list a:hover,
    .blog-category-list a:focus-visible,
    .blog-category-list a:active {
      transform: none;
    }
  }
</style>
