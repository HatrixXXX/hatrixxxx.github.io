---
import { getCollection } from 'astro:content';
import EmptyState from '@/components/EmptyState.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import PostList from '@/components/PostList.astro';
import BackButton from '@/components/BackButton.astro';
import { POST_TYPE_LINKS } from '@/config/navigation';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sortPosts, type PostEntry } from '@/lib/content';

export async function getStaticPaths() {
  const posts: PostEntry[] = await getCollection('posts');

  return POST_TYPE_LINKS.map((type) => ({
    params: { type: type.slug },
    props: {
      title: type.label,
      posts: sortPosts(posts.filter((post) => post.data.type === type.label))
    }
  }));
}

const { title, posts } = Astro.props;
---

<BaseLayout title={title}>
  <BackButton href="/blog/all/" label="返回博客文章" />
  <HeroBanner title={title} subtitle={`${posts.length} 篇文章`} image="/images/default-cover.svg" compact />
  <main class="blog-main">
    {posts.length === 0 ? (
      <div class="container">
        <EmptyState title="这个分类还没有文章" description="以后写了文章再来这里看吧" />
      </div>
    ) : (
      <PostList posts={posts} />
    )}
  </main>
</BaseLayout>

<style>
  .blog-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
</style>
