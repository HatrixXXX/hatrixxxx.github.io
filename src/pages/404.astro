---
import HeroBanner from '@/components/HeroBanner.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" canonicalPath="/404.html">
  <HeroBanner title="404" subtitle="这个页面似乎不存在" image="/images/default-cover.svg" compact />
  <main class="not-found container">
    <p>你可以回到首页，继续浏览已有内容。</p>
    <a href="/">返回首页</a>
  </main>
</BaseLayout>

<style>
  .not-found { padding-block: clamp(2.5rem, 6vw, 5rem); text-align: center; }
  p { color: var(--color-muted); }
  a { display: inline-block; border-radius: 999px; padding: 0.65rem 1rem; background: var(--color-accent); color: #161a20; font-weight: 800; }
</style>
