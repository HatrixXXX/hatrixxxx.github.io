---
import HeroBanner from '@/components/HeroBanner.astro';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" canonicalPath="/404.html">
  <BackButton href="/" label="返回主页" />
  <HeroBanner title="404" subtitle="这个页面似乎不存在" image="/images/default-cover.svg" compact />
  <main class="not-found container">
    <p>你可以回到首页，继续浏览已有内容。</p>
    <a href="/">返回首页</a>
  </main>
</BaseLayout>

<style>
  .not-found { padding-block: clamp(2.5rem, 6vw, 5rem); text-align: center; }
  p { color: var(--color-muted); }
  a { display: inline-block; border: 1px solid var(--color-accent); border-radius: var(--radius-control); padding: 0.65rem 1rem; background: var(--color-accent); color: var(--color-on-accent); box-shadow: var(--shadow-inset); font-size: 0.875rem; font-weight: 650; transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out); }
  a:hover { border-color: var(--color-accent-strong); background: var(--color-accent-strong); }
  a:active { border-color: var(--color-copper); transition-duration: 100ms; }
</style>
