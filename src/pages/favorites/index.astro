---
import BookmarkArchive from '@/components/BookmarkArchive.astro';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BOOKMARKS } from '@/data/bookmarks';
import '@/styles/bookmark-archive.css';

const categories = [...new Set(BOOKMARKS.map((bookmark) => bookmark.category))];
---

<BaseLayout
  title="收藏夹"
  description="收藏的网址与简要介绍。"
>
  <BackButton href="/" label="返回主页" cornerAligned={true} />
  <main class="favorites-page">
    <div class="favorites-stage">
      <BookmarkArchive bookmarks={BOOKMARKS} />
    </div>
    <section class="favorites-directory" aria-label="全部收藏网站">
      {categories.map((category, index) => (
        <section class="favorites-category" aria-labelledby={`favorites-category-${index}`}>
          <h2 id={`favorites-category-${index}`}>{category}</h2>
          <ul class="favorites-directory__links">
            {BOOKMARKS.filter((bookmark) => bookmark.category === category).map((bookmark) => (
              <li>
                <a href={bookmark.url} target="_blank" rel="noopener noreferrer">
                  <span class="favorites-directory__title">
                    {bookmark.title}
                  </span>
                  <span class="favorites-directory__description">{bookmark.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  import '@/scripts/bookmark-archive';
</script>

<style>
  .favorites-directory {
    width: min(100%, var(--content-width));
    margin-inline: auto;
  }

  .favorites-category {
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    gap: 32px;
    padding-block: 40px;
    border-top: 1px solid var(--color-line-strong);
  }

  .favorites-category h2 {
    margin: 0;
    padding-top: 12px;
    color: var(--color-copper);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .favorites-directory__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .favorites-directory__links li {
    min-width: 0;
  }

  .favorites-directory__links a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    min-height: 72px;
    padding: 12px 8px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-heading);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .favorites-directory__links a:hover,
  .favorites-directory__links a:focus-visible {
    background: var(--color-surface);
    color: var(--color-accent);
  }

  .favorites-directory__links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .favorites-directory__title {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .favorites-directory__description {
    color: var(--color-muted);
    font-size: .875rem;
    line-height: 1.65;
  }

  @media (max-width: 1199px) {
    .favorites-category { grid-template-columns: 120px minmax(0, 1fr); gap: 24px; }
    .favorites-directory__links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 700px) {
    .favorites-category { grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 32px; }
    .favorites-category h2 { padding-top: 0; }
    .favorites-directory__links { grid-template-columns: minmax(0, 1fr); }
  }
</style>
