---
import { getCollection, type CollectionEntry } from 'astro:content';
import BackButton from '@/components/BackButton.astro';
import ProjectBook from '@/components/ProjectBook.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/project-book.css';

const projects = (await getCollection('projects')) as CollectionEntry<'projects'>[];
projects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="作品橱窗" description="Hatrix 的作品展示与制作记录。" bodyClass="projects-page plain-page nav-content-page">
  <BackButton href="/" label="返回主页" cornerAligned={true} />
  <ProjectBook projects={projects} />
</BaseLayout>

<script>
  import '@/scripts/project-book';
</script>
