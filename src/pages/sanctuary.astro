---
import { getCollection } from 'astro:content';
import PostList from '@/components/PostList.astro';
import BackButton from '@/components/BackButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sortSanctuary } from '@/lib/sanctuary';

const sanctuary = sortSanctuary(await getCollection('sanctuary'));
---

<BaseLayout title="秘境" bodyClass="sanctuary-page plain-page">
  <BackButton href="/" label="返回主页" cornerAligned={true} />
  <main class="blog-main">
    {sanctuary.length > 0 ? <PostList sanctuary={sanctuary} /> : <p class="empty-state">暂无秘境文章。</p>}
  </main>
</BaseLayout>

<style>
  :global(body.sanctuary-page) { --blog-header-height: 60px; }
  :global(body.sanctuary-page:has([data-protected-state='ready'])) { overflow: hidden; }
  :global(body.sanctuary-page [data-protected-mount] > main.blog-main) {
    height: 100dvh;
    padding-top: var(--blog-header-height);
  }

  .blog-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .empty-state {
    margin: auto;
    color: var(--color-muted);
    text-align: center;
  }
</style>
