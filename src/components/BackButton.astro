---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="back-button" href={href} aria-label={label} data-back-button>
  <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path d="M1 24 25 2h22L26 24l21 22H25Z" />
  </svg>
</a>

<style>
  .back-button {
    --back-button-offset-y: 0.4rem;
    position: fixed;
    z-index: 30;
    top: clamp(2rem, 4vw, 4rem);
    left: 2.5rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--color-accent);
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 30%));
    transform: translateY(var(--back-button-offset-y));
    transition: color 160ms ease, transform 160ms ease, filter 160ms ease;
  }

  .back-button svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .back-button:hover,
  .back-button:focus-visible {
    color: var(--color-accent-strong);
    filter: drop-shadow(0 6px 16px rgb(0 0 0 / 40%));
    transform: translateX(-0.2rem) translateY(var(--back-button-offset-y)) scale(1.04);
  }

  @media (max-width: 768px) {
    .back-button {
      --back-button-offset-y: -0.2rem;
      top: 3.5rem;
      left: 1.25rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-button {
      transition: none;
    }
  }
</style>
