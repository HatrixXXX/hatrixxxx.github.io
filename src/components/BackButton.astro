---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="back-button" href={href} aria-label={label} data-back-button>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m10 5-7 7 7 7M3 12h18" />
  </svg>
</a>

<style>
  .back-button {
    --back-button-offset-y: 0.4rem;
    position: fixed;
    z-index: 30;
    top: clamp(2rem, 4vw, 4rem);
    left: 2.5rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--color-accent);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset);
    transform: translateY(var(--back-button-offset-y));
    transition: color 160ms ease, transform 160ms ease, filter 160ms ease;
  }

  .back-button svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-button:hover,
  .back-button:focus-visible {
    color: var(--color-accent-strong);
    border-color: var(--color-copper);
    transform: translateX(-2px) translateY(var(--back-button-offset-y));
  }

  @media (max-width: 768px) {
    .back-button {
      --back-button-offset-y: -0.2rem;
      top: 3.5rem;
      left: 1.25rem;
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-button {
      transition: none;
    }
  }
</style>
