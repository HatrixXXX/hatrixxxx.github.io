---
interface Props {
  href: string;
  label: string;
  belowHeader?: boolean;
  cornerAligned?: boolean;
}

const { href, label, belowHeader = false, cornerAligned = false } = Astro.props;
---

<a class:list={['back-button', { 'back-button--below-header': belowHeader, 'back-button--corner-aligned': cornerAligned }]} href={href} aria-label={label} data-back-button>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m10 5-7 7 7 7M3 12h18" />
  </svg>
</a>

<style>
  .back-button {
    --back-button-offset-y: 0;
    position: fixed;
    z-index: 30;
    top: 8px;
    left: 16px;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--color-accent);
    isolation: isolate;
    border: 1px solid var(--color-copper);
    clip-path: polygon(0 9px, 9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%);
    background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset));
    box-shadow: inset 0 0 0 4px rgb(0 0 0 / 22%);
    transform: translateY(var(--back-button-offset-y));
    transition: color 160ms ease, transform 160ms ease, background-color 160ms ease, filter 160ms ease;
  }

  .back-button[data-back-button] {
    cursor: image-set(url('/assets/cursors/link-nav.png') 2x) 24 24, image-set(url('/assets/cursors/pointer.cur') 2x) 2 3, pointer !important;
  }

  .back-button::before,
  .back-button::after {
    position: absolute;
    pointer-events: none;
    content: '';
  }

  .back-button::before {
    inset: 5px;
    border: 1px solid rgb(216 140 60 / 42%);
    clip-path: polygon(0 5px, 5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%);
  }

  .back-button::after {
    top: 5px;
    right: 5px;
    width: 5px;
    height: 3px;
    background: var(--color-link);
    box-shadow: 0 0 7px var(--color-link);
  }

  .back-button svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-button:hover,
  .back-button:focus-visible {
    color: var(--color-accent-strong);
    border-color: var(--color-copper);
    transform: translateX(-2px) translateY(var(--back-button-offset-y));
    filter: brightness(1.18);
  }

  .back-button:focus-visible {
    box-shadow: inset 0 0 0 3px var(--color-link);
  }

  .back-button:active {
    transform: translateX(-3px) translateY(var(--back-button-offset-y)) scale(.96);
    filter: brightness(1.35);
  }

  .back-button.back-button--corner-aligned {
    --back-button-offset-y: 0;
  }

  @media (max-width: 768px) {
    .back-button {
      --back-button-offset-y: 0;
      top: 8px;
      left: 16px;
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (max-width: 1199px) {
    .back-button.back-button--below-header {
      --back-button-offset-y: 0;
    }

    .back-button.back-button--corner-aligned {
      top: 8px;
      left: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-button {
      transition: none;
    }
  }
</style>
