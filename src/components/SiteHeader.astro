---
import { PRIMARY_NAV_ITEMS } from '@/config/navigation';

interface Props {
  homeMode?: boolean;
}

const { homeMode = false } = Astro.props;
const isCurrent = (href: string) => Astro.url.pathname === href;
---

<header data-site-header class:list={['site-header', { 'site-header--home': homeMode }]}>
  <div
    class="header-content-boundary container"
    data-content-boundary
    aria-hidden="true"
  ></div>
  <div class="header-inner" data-header-controls data-home-controls={homeMode ? '' : undefined}>

    <nav class="desktop-nav" aria-label="主导航">
      <ul>
        {PRIMARY_NAV_ITEMS.map((item) => (
          <li data-nav-item={item.label}>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              data-home-blog-link={homeMode && item.href === '/blog/' ? '' : undefined}
            >
              {item.label}
              {'children' in item && <span class="nav-caret" aria-hidden="true"></span>}
            </a>
            {'children' in item && (
              <ul class="submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="admin-logout" type="button" data-admin-logout hidden>
        退出管理员身份
      </button>
      <button class="header-action" type="button" aria-label="搜索文章" data-open-search>
        <svg
          class="search-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="20"
          height="20"
        >
          <circle cx="10.75" cy="10.75" r="6.25"></circle>
          <path d="m15.5 15.5 4.25 4.25"></path>
        </svg>
      </button>
      <button
        class="header-action"
        type="button"
        aria-label="切换主题"
        data-theme-toggle
      >
        <span class="theme-icon" aria-hidden="true">
          <svg class="theme-icon__sun" viewBox="0 0 24 24" width="20" height="20">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 1.75v2.2M12 20.05v2.2M1.75 12h2.2M20.05 12h2.2M4.75 4.75l1.55 1.55M17.7 17.7l1.55 1.55M19.25 4.75 17.7 6.3M6.3 17.7l-1.55 1.55"></path>
          </svg>
          <svg class="theme-icon__moon" viewBox="0 0 24 24" width="20" height="20">
            <path d="M20.2 15.15A8.6 8.6 0 0 1 8.85 3.8a8.65 8.65 0 1 0 11.35 11.35Z"></path>
          </svg>
        </span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-label="切换导航栏"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="移动端导航" data-mobile-menu hidden>
    <ul class="mobile-nav__list container">
      {PRIMARY_NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            data-home-blog-link={homeMode && item.href === '/blog/' ? '' : undefined}
          >
            {item.label}
          </a>
          {'children' in item && (
            <ul class="submenu">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --site-header-height: 60px;
    position: absolute;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    min-height: var(--site-header-height);
    border-bottom: 0;
    background: transparent;
    color: #eee;
    font-family: 'IBM Plex Mono', -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif;
  }

  .header-content-boundary {
    position: absolute;
    inset-block: 0;
    left: 50%;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .header-inner {
    display: flex;
    width: 100%;
    min-height: var(--site-header-height);
    align-items: center;
    justify-content: flex-end;
    gap: 0.875rem;
    padding-inline: 36px;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .desktop-nav {
    position: relative;
  }

  .desktop-nav > ul > li > a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 0.8rem;
    border-radius: 999px;
    color: #eee;
    font-size: 15.21px;
    text-shadow: 1px 1px 2px rgb(0 0 0 / 30%);
    transition: color 160ms ease, background-color 160ms ease;
  }

  .desktop-nav a:hover {
    background: transparent;
    color: #eee;
  }

  .nav-caret {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
  }

  .desktop-nav .submenu {
    position: absolute;
    z-index: 1;
    top: 100%;
    left: 50%;
    display: flex;
    width: max-content;
    min-width: 9rem;
    max-width: calc(100vw - 2rem);
    flex-wrap: nowrap;
    gap: 0.15rem;
    padding: 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    visibility: hidden;
    background: rgb(22 26 32 / 96%);
    box-shadow: var(--shadow-panel);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms;
  }

  .desktop-nav .submenu a {
    display: flex;
    min-height: 40px;
    align-items: center;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    color: #fff;
    font-size: 0.86rem;
    white-space: nowrap;
  }

  .desktop-nav > ul > li:hover > .submenu,
  .desktop-nav > ul > li:focus-within > .submenu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .desktop-nav > ul:has(> li:hover) > li:not(:hover) > .submenu {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
  }

  .desktop-nav .submenu {
    position: fixed;
    top: 60px;
    right: 16px;
    left: auto;
    transform: translateY(-0.35rem);
  }

  .desktop-nav > ul > li:hover > .submenu,
  .desktop-nav > ul > li:focus-within > .submenu {
    transform: translateY(0);
  }

  .desktop-nav > ul:has(> li:hover) > li:not(:hover) > .submenu {
    transform: translateY(-0.35rem);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .admin-logout {
    min-height: 40px;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    background: rgb(17 20 25 / 70%);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
  }

  .admin-logout:hover,
  .admin-logout:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .header-action,
  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #eee;
    cursor: pointer;
    text-shadow: 1px 1px 2px rgb(0 0 0 / 30%);
  }

  .header-action:hover,
  .menu-toggle:hover {
    background: transparent;
    color: #eee;
  }
  .header-action:disabled {
    cursor: wait;
  }

  .search-icon {
    margin: auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-icon {
    display: grid;
    width: 20px;
    height: 20px;
    margin: auto;
    place-items: center;
  }

  .theme-icon svg {
    grid-area: 1 / 1;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .theme-icon__sun circle {
    fill: currentColor;
    stroke: none;
  }

  .theme-icon__moon {
    fill: currentColor !important;
    stroke: none !important;
  }

  :global(html[data-theme='dark']) .theme-icon__sun,
  :global(html[data-theme='light']) .theme-icon__moon {
    opacity: 0;
    transform: rotate(-35deg) scale(0.65);
  }

  :global(html[data-theme='dark']) .theme-icon__moon,
  :global(html[data-theme='light']) .theme-icon__sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  .menu-toggle {
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 19px;
    height: 2px;
    margin: 4px auto;
    border-radius: 2px;
    background: currentColor;
  }

  @media (max-width: 768px) {
    .header-inner {
      width: 100%;
      padding-inline: 16px;
    }

    .admin-logout {
      max-width: 8.5rem;
      font-size: 0.72rem;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-nav:not([hidden]) {
      display: block;
      overflow-y: auto;
      max-height: calc(100dvh - var(--site-header-height));
      border-top: 1px solid var(--color-line);
      background: rgb(22 26 32 / 96%);
      box-shadow: var(--shadow-panel);
      backdrop-filter: blur(14px);
    }

    .mobile-nav__list {
      display: grid;
      gap: 0.25rem;
      padding-block: 0.7rem 1rem;
    }

    .mobile-nav .submenu {
      display: grid;
      gap: 0.15rem;
      padding-left: 1rem;
    }

    .mobile-nav a {
      display: flex;
      min-height: 44px;
      align-items: center;
      border-radius: 6px;
      padding: 0.55rem 0.75rem;
      color: #fff;
    }

    .mobile-nav .submenu a {
      color: #b8bdc6;
      font-size: 0.9rem;
    }

    .mobile-nav a:hover,
    .mobile-nav a:focus-visible {
      background: rgb(255 255 255 / 12%);
      color: #fff;
    }
  }
</style>
