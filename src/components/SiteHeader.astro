---
import { PRIMARY_NAV_ITEMS } from '@/config/navigation';
import HomeIcon from '@/components/HomeIcon.astro';

interface Props {
  homeMode?: boolean;
}

const { homeMode = false } = Astro.props;
const isCurrent = (href: string) => Astro.url.pathname === href;
---

<header data-site-header class:list={['site-header', { 'site-header--home': homeMode }]}>
  <div
    class="header-content-boundary container"
    data-content-boundary
    aria-hidden="true"
  ></div>
  <div class="header-inner" data-header-controls data-home-controls={homeMode ? '' : undefined}>
    <nav class="desktop-nav" aria-label="主导航">
      <ul>
        {PRIMARY_NAV_ITEMS.map((item) => (
          <li data-nav-item={item.label}>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <span class="nav-icon" aria-hidden="true"><HomeIcon name={item.icon} /></span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        class="menu-toggle"
        type="button"
        aria-label="切换导航栏"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <button class="header-action" type="button" aria-label="退出管理员身份" data-admin-logout hidden>
        <svg class="logout-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M10 4H5v16h5"></path>
          <path d="M13 8l4 4-4 4M17 12H8"></path>
        </svg>
      </button>
      <button class="header-action" type="button" aria-label="搜索文章" data-open-search>
        <svg
          class="search-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="20"
          height="20"
        >
          <circle cx="10.75" cy="10.75" r="6.25"></circle>
          <path d="m15.5 15.5 4.25 4.25"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="移动端导航" data-mobile-menu hidden>
    <ul class="mobile-nav__list container">
      {PRIMARY_NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <span class="nav-icon" aria-hidden="true"><HomeIcon name={item.icon} /></span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --site-header-height: 60px;
    position: fixed;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    min-height: var(--site-header-height);
    border-bottom: 1px solid var(--chassis-edge);
    background: transparent;
    color: var(--color-text);
      font-family: var(--font-body);
  }

  /* 有 hero banner 时：header 完全透明，浮在 banner 上 */
  /* 有背景图时：header 使用半透明磨砂背景 */
  /* 无背景图时：header 使用不透明底色 */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-surface);
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .site-header::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 5%, var(--color-copper) 11%, transparent 24% 76%, var(--color-copper) 89%, transparent 95%);
    opacity: 0.75;
    pointer-events: none;
  }

  :global(html:has([data-hero])) .site-header::before {
    opacity: 0;
  }

  :global(body[style*="--page-bg-image"]) .site-header::before {
    background: rgb(23 21 29 / 55%);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
  }

  .site-header .header-inner,
  .site-header .mobile-nav {
    position: relative;
    z-index: 1;
  }

  .header-content-boundary {
    position: absolute;
    inset-block: 0;
    left: 50%;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .site-header:has(.mobile-nav:not([hidden])) {
    z-index: 100;
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    width: 100%;
    min-height: var(--site-header-height);
    align-items: center;
    gap: 0.875rem;
    padding-inline: 16px;
  }

  /* Cropped crosshair keeps its 48px artwork and centered hotspot; fallback matches the site's pointer size. */
  .header-inner :is(a[href], button:not(:disabled):not([aria-disabled='true'])) {
    cursor: pointer !important;
    cursor: image-set(url('/assets/cursors/link-nav.png') 2x) 24 24, image-set(url('/assets/cursors/pointer.cur') 2x) 2 3, pointer !important;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav > ul {
    display: flex;
    align-items: center;
    gap: 1.125rem;
  }

  @media (min-width: 1320px) {
    .desktop-nav > ul {
      gap: 1.5rem;
    }
  }

  @media (min-width: 1200px) and (max-width: 1399px) {
    .header-inner:has([data-admin-logout]:not([hidden])) .desktop-nav > ul {
      gap: 0.5rem;
    }
  }

  .desktop-nav > ul > li {
    display: flex;
    min-height: var(--site-header-height);
    align-items: center;
  }

  .desktop-nav {
    position: relative;
    grid-column: 2;
    grid-row: 1;
  }

  .desktop-nav > ul > li > a {
    position: relative;
    display: flex;
    min-height: var(--site-header-height);
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.4rem;
    color: var(--color-text);
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .desktop-nav > ul > li > a::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    bottom: 0;
    left: 0.25rem;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-accent) 25% 75%, transparent);
    box-shadow: 0 -4px 12px rgb(255 210 0 / 25%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 230ms var(--ease-out);
  }

  .nav-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    flex: none;
    align-items: center;
    justify-content: center;
    transition: transform 230ms var(--ease-out), filter 230ms var(--ease-out);
  }

  .nav-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .desktop-nav a:hover {
    color: var(--color-accent);
  }

  .desktop-nav > ul > li > a:hover,
  .desktop-nav > ul > li > a:focus-visible,
  .desktop-nav > ul > li > a[aria-current='page'] {
    background: linear-gradient(180deg, transparent 38%, rgb(255 210 0 / 9%));
  }

  .desktop-nav > ul > li > a:is(:hover, :focus-visible, [aria-current='page'])::after {
    transform: scaleX(1);
  }

  .desktop-nav > ul > li > a:is(:hover, :focus-visible) .nav-icon {
    filter: drop-shadow(0 0 5px rgb(255 210 0 / 48%));
    transform: translateY(-2px);
  }

  .desktop-nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav-caret {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
  }

  .desktop-nav .submenu {
    position: fixed;
    z-index: 1;
    top: var(--site-header-height);
    left: 50%;
    display: flex;
    width: max-content;
    min-width: 9rem;
    max-width: calc(100vw - 2rem);
    flex-wrap: nowrap;
    gap: 0.15rem;
    padding: 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    visibility: hidden;
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-panel);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .desktop-nav .submenu a {
    display: flex;
    min-height: 40px;
    align-items: center;
    border-radius: var(--radius-control);
    padding: 0.5rem 0.75rem;
    color: var(--color-text);
    font-size: 0.86rem;
    white-space: nowrap;
  }

  .desktop-nav > ul > li:hover > .submenu,
  .desktop-nav > ul > li:focus-within > .submenu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .header-actions {
    display: flex;
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    align-items: center;
    gap: 0.35rem;
  }

  .header-action,
  .menu-toggle {
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: 2px;
    background: linear-gradient(145deg, rgb(245 224 193 / 5%), transparent 58%), rgb(11 13 20 / 32%);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease, border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .header-action::before,
  .menu-toggle::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 2px;
    background: var(--color-copper);
    opacity: 0.7;
    transform: scaleX(0.5);
    transform-origin: left;
    transition: transform var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .header-action:hover,
  .header-action:focus-visible,
  .menu-toggle:hover,
  .menu-toggle:focus-visible,
  .menu-toggle[aria-expanded='true'] {
    background: var(--color-accent-soft);
    border-color: var(--color-copper);
    color: var(--color-accent);
    box-shadow: inset 0 0 0 1px rgb(255 210 0 / 14%), 0 4px 13px rgb(0 0 0 / 28%);
  }
  .header-action:is(:hover, :focus-visible)::before,
  .menu-toggle:is(:hover, :focus-visible, [aria-expanded='true'])::before {
    background: var(--color-accent);
    transform: scaleX(1);
  }
  .header-action:active, .menu-toggle:active { background: var(--color-inset); box-shadow: var(--shadow-inset); }

  .header-action {
    border-color: var(--color-copper);
    clip-path: polygon(0 9px, 9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%);
    background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset));
    box-shadow: inset 0 0 0 4px rgb(0 0 0 / 22%);
    color: var(--color-accent);
  }

  .header-action::before {
    inset: 5px;
    width: auto;
    height: auto;
    border: 1px solid rgb(216 140 60 / 42%);
    clip-path: polygon(0 5px, 5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%);
    background: none;
    opacity: 1;
    transform: none;
  }

  .header-action::after {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 5px;
    height: 3px;
    background: var(--color-link);
    box-shadow: 0 0 7px var(--color-link);
    content: '';
    pointer-events: none;
  }

  .header-action:is(:hover, :focus-visible) {
    background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset));
    border-color: var(--color-copper);
    color: var(--color-accent-strong);
    box-shadow: inset 0 0 0 4px rgb(0 0 0 / 22%);
    filter: brightness(1.18);
  }

  .header-action:is(:hover, :focus-visible)::before { background: none; transform: none; }
  .header-action:focus-visible { box-shadow: inset 0 0 0 3px var(--color-link); }
  .header-action:active { filter: brightness(1.35); }

  .search-icon,
  .logout-icon {
    width: 23px;
    height: 23px;
    margin: auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  .menu-toggle {
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 19px;
    height: 2px;
    margin: 4px auto;
    border-radius: 2px;
    background: currentColor;
    transition: transform 180ms var(--ease-out), opacity 130ms ease;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 1199px) {
    .header-inner {
      display: flex;
      justify-content: flex-end;
      width: 100%;
      padding-inline: 16px;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-nav:not([hidden]) {
      display: block;
      overflow-y: auto;
      max-height: calc(100dvh - var(--site-header-height));
      border-top: 1px solid var(--color-copper);
      background: linear-gradient(145deg, rgb(0 221 235 / 6%), transparent 34%), var(--color-surface);
      box-shadow: 0 18px 36px rgb(4 5 10 / 55%), inset 0 2px 0 var(--chassis-groove);
      animation: nav-hatch-open 260ms var(--ease-out) both;
    }

    .mobile-nav__list {
      display: grid;
      gap: 1rem;
      padding-block: 0.7rem 1rem;
    }

    .mobile-nav .submenu {
      display: grid;
      gap: 0.15rem;
      padding-left: 1rem;
    }

    .mobile-nav a {
      display: flex;
      min-height: 44px;
      align-items: center;
      gap: 0.5rem;
      border-radius: var(--radius-control);
      padding: 0.55rem 0.75rem;
      color: var(--color-text);
      font-size: 17px;
    }

    .mobile-nav .submenu a {
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .mobile-nav a:hover,
    .mobile-nav a:focus-visible {
      background: var(--color-accent-soft);
      color: var(--color-accent);
    }
    .mobile-nav a[aria-current='page'] {
      background: var(--color-accent-soft);
      color: var(--color-accent);
      box-shadow: inset 3px 0 var(--color-accent);
    }
  }

  @keyframes nav-hatch-open {
    from { opacity: 0; clip-path: inset(0 0 90% 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not([hidden]) { animation: none; }
    .desktop-nav > ul > li > a:is(:hover, :focus-visible) .nav-icon { transform: none; }
  }
</style>
