---
import { PRIMARY_NAV_ITEMS } from '@/config/navigation';

interface Props {
  homeMode?: boolean;
}

const { homeMode = false } = Astro.props;
const isCurrent = (href: string) => Astro.url.pathname === href;
---

<header data-site-header class:list={['site-header', { 'site-header--home': homeMode }]}>
  <div
    class="header-content-boundary container"
    data-content-boundary
    aria-hidden="true"
  ></div>
  <div class="header-inner" data-header-controls data-home-controls={homeMode ? '' : undefined}>
    <button class="admin-logout" type="button" data-admin-logout hidden>
      退出管理员身份
    </button>

    <nav class="desktop-nav" aria-label="主导航">
      <ul>
        {PRIMARY_NAV_ITEMS.map((item) => (
          <li data-nav-item={item.label}>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="header-action" type="button" aria-label="搜索文章" data-open-search>
        <svg
          class="search-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="20"
          height="20"
        >
          <circle cx="10.75" cy="10.75" r="6.25"></circle>
          <path d="m15.5 15.5 4.25 4.25"></path>
        </svg>
      </button>
      <button
        class="header-action"
        type="button"
        aria-label="切换主题"
        data-theme-toggle
      >
        <span class="theme-icon" aria-hidden="true">
          <svg class="theme-icon__sun" viewBox="0 0 24 24" width="20" height="20">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 1.75v2.2M12 20.05v2.2M1.75 12h2.2M20.05 12h2.2M4.75 4.75l1.55 1.55M17.7 17.7l1.55 1.55M19.25 4.75 17.7 6.3M6.3 17.7l-1.55 1.55"></path>
          </svg>
          <svg class="theme-icon__moon" viewBox="0 0 24 24" width="20" height="20">
            <path d="M20.2 15.15A8.6 8.6 0 0 1 8.85 3.8a8.65 8.65 0 1 0 11.35 11.35Z"></path>
          </svg>
        </span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-label="切换导航栏"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="移动端导航" data-mobile-menu hidden>
    <ul class="mobile-nav__list container">
      {PRIMARY_NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --site-header-height: 60px;
    position: fixed;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    min-height: var(--site-header-height);
    border-bottom: 0;
    background-color: color-mix(in srgb, var(--color-surface) 92%, transparent);
    background-image: var(--page-hero-image, none);
    background-position: center 44%;
    background-size: cover;
    backdrop-filter: blur(2px);
    color: var(--color-text);
    box-shadow: var(--shadow-inset), inset 0 -1px var(--color-line);
    font-family: var(--font-body);
  }

  .header-content-boundary {
    position: absolute;
    inset-block: 0;
    left: 50%;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .site-header:has(.mobile-nav:not([hidden])) {
    z-index: 100;
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    width: 100%;
    min-height: var(--site-header-height);
    align-items: center;
    gap: 0.875rem;
    padding-inline: 36px;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .desktop-nav > ul > li {
    display: flex;
    min-height: var(--site-header-height);
    align-items: center;
  }

  .desktop-nav {
    position: relative;
    grid-column: 2;
    grid-row: 1;
  }

  .desktop-nav > ul > li > a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius-control);
    color: var(--color-text);
    font-size: 14.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .desktop-nav a:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .desktop-nav a[aria-current='page'] { color: var(--color-accent); box-shadow: inset 0 -1px var(--color-copper); }

  .nav-caret {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
  }

  .desktop-nav .submenu {
    position: fixed;
    z-index: 1;
    top: var(--site-header-height);
    left: 50%;
    display: flex;
    width: max-content;
    min-width: 9rem;
    max-width: calc(100vw - 2rem);
    flex-wrap: nowrap;
    gap: 0.15rem;
    padding: 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    visibility: hidden;
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-panel);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .desktop-nav .submenu a {
    display: flex;
    min-height: 40px;
    align-items: center;
    border-radius: var(--radius-control);
    padding: 0.5rem 0.75rem;
    color: var(--color-text);
    font-size: 0.86rem;
    white-space: nowrap;
  }

  .desktop-nav > ul > li:hover > .submenu,
  .desktop-nav > ul > li:focus-within > .submenu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .header-actions {
    display: flex;
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    align-items: center;
    gap: 0.35rem;
  }

  .admin-logout {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    min-height: 40px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: 0.45rem 0.8rem;
    background: var(--color-inset);
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
  }

  .admin-logout:hover,
  .admin-logout:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .header-action,
  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .header-action:hover,
  .menu-toggle:hover {
    background: var(--color-accent-soft);
    border-color: var(--color-line);
    color: var(--color-accent);
  }
  .header-action:active, .menu-toggle:active { background: var(--color-inset); box-shadow: var(--shadow-inset); }
  .header-action:disabled {
    cursor: wait;
  }

  .search-icon {
    margin: auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-icon {
    display: grid;
    width: 20px;
    height: 20px;
    margin: auto;
    place-items: center;
  }

  .theme-icon svg {
    grid-area: 1 / 1;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .theme-icon__sun circle {
    fill: currentColor;
    stroke: none;
  }

  .theme-icon__moon {
    fill: currentColor !important;
    stroke: none !important;
  }

  :global(html[data-theme='dark']) .theme-icon__sun,
  :global(html[data-theme='light']) .theme-icon__moon {
    opacity: 0;
    transform: rotate(-35deg) scale(0.65);
  }

  :global(html[data-theme='dark']) .theme-icon__moon,
  :global(html[data-theme='light']) .theme-icon__sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  .menu-toggle {
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 19px;
    height: 2px;
    margin: 4px auto;
    border-radius: 2px;
    background: currentColor;
  }

  @media (max-width: 1199px) {
    .header-inner {
      display: flex;
      justify-content: center;
      width: 100%;
      padding-inline: 16px;
    }

    .header-inner:has(.admin-logout:not([hidden])) {
      justify-content: space-between;
    }

    .admin-logout {
      max-width: 8.5rem;
      font-size: 0.72rem;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-nav:not([hidden]) {
      display: block;
      overflow-y: auto;
      max-height: calc(100dvh - var(--site-header-height));
      border-top: 1px solid var(--color-line);
      background: var(--color-surface);
      box-shadow: var(--shadow-panel);
    }

    .mobile-nav__list {
      display: grid;
      gap: 0.25rem;
      padding-block: 0.7rem 1rem;
    }

    .mobile-nav .submenu {
      display: grid;
      gap: 0.15rem;
      padding-left: 1rem;
    }

    .mobile-nav a {
      display: flex;
      min-height: 44px;
      align-items: center;
      border-radius: var(--radius-control);
      padding: 0.55rem 0.75rem;
      color: var(--color-text);
    }

    .mobile-nav .submenu a {
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .mobile-nav a:hover,
    .mobile-nav a:focus-visible {
      background: var(--color-accent-soft);
      color: var(--color-accent);
    }
    .mobile-nav a[aria-current='page'] { color: var(--color-accent); }
  }
</style>
