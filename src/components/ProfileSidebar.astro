---
import { SITE } from '@/config/site';
import SocialIcon from '@/components/SocialIcon.astro';
---

<section class="profile-sidebar" aria-label="作者资料" data-profile-card>
  <div class="profile-rail" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="portrait-housing">
    <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="112" height="112" loading="lazy" />
  </div>
  <h2>{SITE.title}</h2>
  <p>{SITE.tagline}</p>
  <nav aria-label="作者链接">
    {SITE.socials.map((social) => (
      <a
        href={social.url}
        aria-label={social.label}
        data-social-id={social.id}
        target={social.url.startsWith('http') ? '_blank' : undefined}
        rel={social.url.startsWith('http') ? 'me noreferrer' : undefined}
        style={`--social-color: ${social.color}`}
      >
        <SocialIcon id={social.id} />
      </a>
    ))}
  </nav>
</section>

<style>
  .profile-sidebar {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-width: 0;
    width: 100%;
    justify-self: center;
    border: 1px solid var(--color-line-strong);
    clip-path: polygon(0 16px, 16px 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 16px), calc(100% - 16px) 100%, 16px 100%, 0 calc(100% - 16px));
    padding: 1.3rem 1.25rem 1.5rem;
    background:
      linear-gradient(90deg, transparent 11px, rgb(216 140 60 / 23%) 11px 12px, transparent 12px calc(100% - 12px), rgb(216 140 60 / 23%) calc(100% - 12px) calc(100% - 11px), transparent calc(100% - 11px)),
      repeating-linear-gradient(0deg, transparent 0 17px, rgb(190 174 204 / 4%) 17px 18px),
      var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset), inset 0 0 0 5px rgb(0 0 0 / 20%);
    text-align: center;
  }

  .profile-sidebar::before,
  .profile-sidebar::after {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    content: '';
  }

  .profile-sidebar::before {
    top: 42px;
    left: 12px;
    width: 58px;
    height: 62px;
    border-top: 2px solid var(--color-copper);
    border-left: 2px solid var(--color-copper);
    clip-path: polygon(0 0, 100% 0, 100% 8px, 8px 8px, 8px 100%, 0 100%);
    opacity: .65;
  }

  .profile-sidebar::after {
    right: 12px;
    bottom: 12px;
    width: 46px;
    height: 38px;
    background: linear-gradient(90deg, var(--color-copper) 0 14px, transparent 14px 20px, var(--color-link) 20px 25px, transparent 25px);
    opacity: .65;
  }

  .profile-rail {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 7px;
    margin: 0 0 1.15rem;
  }

  .profile-rail::before {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--color-copper), transparent);
    content: '';
  }

  .profile-rail span {
    width: 12px;
    height: 3px;
    background: var(--color-copper);
  }

  .profile-rail span:nth-child(2) {
    width: 6px;
    background: var(--color-link);
    box-shadow: 0 0 7px rgb(0 221 235 / 65%);
  }

  .portrait-housing {
    position: relative;
    display: grid;
    width: 136px;
    height: 136px;
    margin-inline: auto;
    place-items: center;
    background: conic-gradient(from 22.5deg, var(--color-copper) 0 36deg, transparent 36deg 54deg, var(--color-line-strong) 54deg 126deg, transparent 126deg 144deg, var(--color-copper) 144deg 216deg, transparent 216deg 234deg, var(--color-line-strong) 234deg 306deg, transparent 306deg 324deg, var(--color-copper) 324deg);
    clip-path: polygon(50% 0, 84% 14%, 100% 50%, 84% 86%, 50% 100%, 16% 86%, 0 50%, 16% 14%);
    box-shadow: 0 8px 16px rgb(0 0 0 / 32%);
  }

  .portrait-housing::before {
    position: absolute;
    inset: 5px;
    background: var(--color-inset);
    clip-path: inherit;
    content: '';
  }

  .portrait-housing::after {
    position: absolute;
    top: 12px;
    right: 16px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 9px var(--color-accent);
    content: '';
  }

  img {
    position: relative;
    width: 112px;
    height: 112px;
    margin-inline: auto;
    border: 2px solid var(--color-line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    margin: 1rem 0 0;
    color: var(--color-heading);
    font-size: 1.35rem;
    font-weight: 650;
  }

  p {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  nav > a {
    position: relative;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    justify-self: center;
    border: 1px solid var(--color-line-strong);
    clip-path: polygon(0 7px, 7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%);
    background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset));
    color: var(--social-color, var(--color-link));
    transition: border-color var(--duration-fast) var(--ease-out), filter var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  nav a:hover {
    border-color: var(--social-color, var(--color-copper));
    background: var(--color-surface-raised);
    color: var(--social-color, var(--color-heading));
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  nav a:focus-visible {
    box-shadow: inset 0 0 0 3px var(--color-link);
    filter: brightness(1.2);
  }

  nav a:active {
    background: var(--color-inset);
    transform: translateY(1px) scale(.96);
    transition-duration: 100ms;
  }

  @media (prefers-reduced-motion: reduce) {
    nav > a {
      transition: none;
    }

    nav a:hover,
    nav a:active {
      transform: none;
    }
  }

</style>
