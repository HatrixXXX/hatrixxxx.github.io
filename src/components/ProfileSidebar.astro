---
import { SITE } from '@/config/site';
import SocialIcon from '@/components/SocialIcon.astro';
---

<section class="profile-sidebar" aria-label="作者资料" data-profile-card>
  <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="112" height="112" loading="lazy" />
  <h2>{SITE.title}</h2>
  <p>{SITE.tagline}</p>
  <nav aria-label="作者链接">
    {SITE.socials.map((social) => (
      social.url === null ? (
        <span
          aria-label={social.label}
          aria-disabled="true"
          data-social-id={social.id}
          data-social-pending="wechat"
          style={`--social-color: ${social.color}`}
        >
          <SocialIcon id={social.id} />
        </span>
      ) : (
        <a
          href={social.url}
          aria-label={social.label}
          data-social-id={social.id}
          style={`--social-color: ${social.color}`}
          target={social.url.startsWith('http') ? '_blank' : undefined}
          rel={social.url.startsWith('http') ? 'me noreferrer' : undefined}
        >
          <SocialIcon id={social.id} />
        </a>
      )
    ))}
  </nav>
</section>

<style>
  .profile-sidebar {
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.25rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
    text-align: center;
  }

  img {
    width: 112px;
    height: 112px;
    margin-inline: auto;
    border: 3px solid rgb(255 255 255 / 75%);
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    margin: 1rem 0 0;
    color: var(--color-heading, var(--color-text));
    font-size: 1.35rem;
  }

  p {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  nav a,
  nav span {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    justify-self: center;
    border: 1px solid color-mix(in srgb, var(--social-color) 45%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--social-color) 12%, transparent);
    color: var(--social-color);
  }

  nav a:hover {
    border-color: var(--social-color);
    background: color-mix(in srgb, var(--social-color) 20%, transparent);
  }

  nav span {
    opacity: 0.65;
  }
</style>
