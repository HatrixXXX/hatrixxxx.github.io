---
import { SITE } from '@/config/site';
import SocialIcon from '@/components/SocialIcon.astro';
---

<section class="profile-sidebar" aria-label="作者资料" data-profile-card>
  <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="112" height="112" loading="lazy" />
  <h2>{SITE.title}</h2>
  <p>{SITE.tagline}</p>
  <nav aria-label="作者链接">
    {SITE.socials.map((social) => (
      social.url === null ? (
        <span
          aria-label={social.label}
          aria-disabled="true"
          data-social-id={social.id}
          data-social-pending={social.id}
          style={`--social-color: ${social.color}`}
        >
          <SocialIcon id={social.id} />
        </span>
      ) : (
        <a
          href={social.url}
          aria-label={social.label}
          data-social-id={social.id}
          target={social.url.startsWith('http') ? '_blank' : undefined}
          rel={social.url.startsWith('http') ? 'me noreferrer' : undefined}
          style={`--social-color: ${social.color}`}
        >
          <SocialIcon id={social.id} />
        </a>
      )
    ))}
  </nav>
</section>

<style>
  .profile-sidebar {
    min-width: 0;
    width: min(100%, 240px);
    justify-self: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.25rem;
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset), var(--shadow-panel);
    text-align: center;
  }

  img {
    width: 112px;
    height: 112px;
    margin-inline: auto;
    border: 3px solid var(--color-line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    margin: 1rem 0 0;
    color: var(--color-heading);
    font-size: 1.35rem;
    font-weight: 650;
  }

  p {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  nav > a,
  nav > span {
    position: relative;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    justify-self: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    background: var(--color-inset);
    color: var(--social-color, var(--color-link));
    transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  nav a:hover {
    border-color: var(--social-color, var(--color-copper));
    background: var(--color-surface-raised);
    color: var(--social-color, var(--color-heading));
    filter: brightness(1.15);
  }

  nav a:active {
    background: var(--color-inset);
    transition-duration: 100ms;
  }

  nav > span {
    color: var(--social-color, var(--color-muted));
    opacity: 0.65;
  }

  [data-social-id='qqmusic'] {
    --qqmusic-cutout: var(--color-inset);
  }

  a[data-social-id='qqmusic']:hover {
    --qqmusic-cutout: var(--color-surface-raised);
  }

  a[data-social-id='qqmusic']:active {
    --qqmusic-cutout: var(--color-inset);
  }

</style>