---
import { SITE } from '@/config/site';

interface Props {
  postCount: number;
}

const { postCount } = Astro.props;
---

<aside class="profile-sidebar" aria-label="作者资料">
  <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="112" height="112" loading="lazy" />
  <h2>{SITE.author.name}</h2>
  <p>{SITE.description}</p>
  <dl>
    <div>
      <dt>文章</dt>
      <dd data-post-count>{postCount}</dd>
    </div>
  </dl>
  <nav aria-label="作者链接">
    {SITE.socials.map((social) => (
      <a href={social.url} target="_blank" rel="me noreferrer">{social.label}</a>
    ))}
  </nav>
</aside>

<style>
  .profile-sidebar {
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 2rem 1.4rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
    text-align: center;
  }

  img {
    width: 112px;
    height: 112px;
    margin-inline: auto;
    border: 3px solid rgb(255 255 255 / 75%);
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    margin: 1rem 0 0;
    color: #fff;
    font-size: 1.35rem;
  }

  p {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 1.5rem 0;
  }

  dt {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  dd {
    margin: 0;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem 0.8rem;
  }

  nav a {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 1025px) {
    .profile-sidebar {
      position: sticky;
      top: 1.5rem;
    }
  }
</style>
