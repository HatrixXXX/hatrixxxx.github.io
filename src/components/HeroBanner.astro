---
import { getImage } from 'astro:assets';
import workshop from '@/assets/home/liupin-workshop-v5.png';

interface Props {
  title: string;
  subtitle?: string;
  image: string;
  compact?: boolean;
}

const { title, subtitle, image, compact = false } = Astro.props;
const heroImage = image === '/images/default-cover.svg'
  ? (await getImage({ src: workshop, format: 'webp', quality: 85 })).src
  : image;
const safeHeroImage = heroImage.replaceAll('"', '%22');
const backgroundImage = `--hero-image: url("${safeHeroImage}")`;
---

<style define:vars={{ heroImageUrl: `url("${safeHeroImage}")` }}>
  :root { --page-hero-image: var(--heroImageUrl); }
</style>

<section
  data-hero
  class:list={['hero', { 'hero--compact': compact }]}
  style={backgroundImage}
  aria-labelledby="hero-title"
>
  <div class="hero-overlay"></div>
  <div class="hero-content container">
    <h1 id="hero-title">{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

<style>
  .hero {
    --hero-text: #f5f0e8;
    --hero-muted: #ded6dc;
    position: relative;
    display: grid;
    height: clamp(440px, 76svh, 720px);
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-surface);
    background-image: var(--hero-image);
    background-position: center 44%;
    background-size: cover;
    color: var(--hero-text);
    border-bottom: 1px solid #b58c6566;
  }

  .hero--compact {
    margin-top: calc(-1 * var(--header-height, 60px));
    padding-top: var(--header-height, 60px);
    height: calc(var(--inner-page-banner-height) + var(--header-height, 60px));
  }

  .hero--compact .hero-content {
    padding-block: calc(var(--header-height) + 1rem) 1rem;
  }

  .hero--compact h1 {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
  }

  .hero-overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, rgb(23 21 29 / 50%), rgb(23 21 29 / 75%) 45%, rgb(23 21 29 / 62%));
  }

  .hero-content {
    padding-block: calc(var(--header-height) + 3rem) 5rem;
    text-align: center;
    text-shadow: 0 2px 8px rgb(0 0 0 / 40%);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    font-weight: 650;
    letter-spacing: .02em;
    line-height: 1.2;
  }

  p {
    margin: 1rem 0 0;
    color: var(--hero-muted);
    font-size: clamp(1rem, 2vw, 1.3rem);
    letter-spacing: .03em;
  }

  @media (max-width: 768px) {
    .hero {
      height: clamp(400px, 66svh, 600px);
    }

    .hero--compact {
      height: calc(var(--inner-page-banner-height) + var(--header-height, 60px));
    }

    .hero-content {
      padding-bottom: 4rem;
    }

    .hero--compact .hero-content {
      padding-bottom: 1rem;
    }
  }
</style>