---
import SocialIcon from '@/components/SocialIcon.astro';
import { SITE } from '@/config/site';

const games = [
  { src: '/assets/about-games/hearthstone.webp', alt: '炉石传说封面' },
  { src: '/assets/about-games/hades.webp', alt: '哈迪斯封面' },
  { src: '/assets/about-games/kingdom-rush.webp', alt: '王国保卫战 5：联盟封面' },
  { src: '/assets/about-games/nine-kings.webp', alt: '九王封面' },
  { src: '/assets/about-games/dead-cells.webp', alt: '死亡细胞封面' },
  { src: '/assets/about-games/turing-complete.webp', alt: '图灵完备封面' }
] as const;
---

<article class="identity-card" aria-labelledby="about-name">
  <div class="identity-card__trace" aria-hidden="true"></div>

  <div class="identity-left">
  <header class="identity-header">
    <div class="portrait-housing">
      <img
        src={SITE.author.avatar}
        alt={`${SITE.author.name} 的头像`}
        width="795"
        height="795"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="identity-title">
      <h1 class="identity-name" id="about-name">{SITE.author.name}</h1>
      <p class="identity-tagline">轻松即单纯，速成即精准。</p>
    </div>

    <nav class="social-links" aria-label="社交媒体联系方式">
      {SITE.socials.map((social) => (
        <a
          href={social.url}
          aria-label={social.label}
          target={social.url.startsWith('http') ? '_blank' : undefined}
          rel={social.url.startsWith('http') ? 'me noreferrer' : undefined}
          style={`--social-color: ${social.color}`}
        >
          <SocialIcon id={social.id} />
          <span>{social.label}</span>
        </a>
      ))}
    </nav>

    <div class="identity-copy">
      <p lang="en">
        <span class="card-sheen" aria-hidden="true"></span>
        <span>
          PhD student <a href="https://github.com/ININ-Polaris" target="_blank" rel="noreferrer">@ININ-Polaris</a>{' '}at Beijing Institute of Technology, interested in Hardware Acceleration, Computer Architecture and AI Accelerators.
        </span>
      </p>
      <p><span class="card-sheen" aria-hidden="true"></span><span>入门级科研工作者，机器人全栈开发菜鸟，RM 退役队员，设计爱好者。除了编码，我还喜欢记录学到的东西，收集有趣的小玩意儿，间歇性发疯，偶尔心血来潮。</span></p>
    </div>
  </header>

  <section class="games" aria-labelledby="games-title">
    <div class="section-heading">
      <span aria-hidden="true"></span>
      <h2 id="games-title">在玩</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="game-covers">
      {games.map((game) => (
        <figure tabindex="0">
          <img src={game.src} alt={game.alt} width="480" height="720" loading="lazy" decoding="async" />
          <span class="card-sheen" aria-hidden="true"></span>
        </figure>
      ))}
    </div>
  </section>
  </div>

  <section class="expertise" aria-labelledby="expertise-title">
    <div class="section-heading">
      <span aria-hidden="true"></span>
      <h2 id="expertise-title">专业领域</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="expertise__panel">
      <img
        src="/assets/about-interests/hardware-acceleration-card.webp"
        alt="硬件加速芯片与蓝金色电路走线"
        width="2172"
        height="724"
        loading="eager"
        decoding="async"
      />
      <span class="card-sheen" aria-hidden="true"></span>
      <div class="expertise__copy">
        <h3><span class="expertise__icon" aria-hidden="true"></span>硬件加速</h3>
        <p>探索专用计算架构、并行处理、数据流优化与软硬件协同设计。通过分析计算与存储瓶颈，提升计算密集型任务的处理速度和能效，为复杂应用提供更高效的算力支持。</p>
      </div>
    </div>
  </section>

  <section class="interests" aria-labelledby="interests-title">
    <div class="section-heading">
      <span aria-hidden="true"></span>
      <h2 id="interests-title">生活爱好</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class="interest-grid">
      <article class="interest-card interest-card--singing">
        <picture class="interest-card__image">
          <source media="(max-width: 600px)" srcset="/assets/about-interests/singing.webp" />
          <img src="/assets/about-interests/singing-wide.webp" alt="KTV 包厢里的麦克风" width="1920" height="240" loading="lazy" decoding="async" />
        </picture>
        <span class="card-sheen" aria-hidden="true"></span>
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M20.7 4.8a5.1 5.1 0 0 1 2.8 6.7l-3.2 7a5.1 5.1 0 0 1-9.3-4.2l3.2-7a5.1 5.1 0 0 1 6.5-2.5Z" />
            <path d="m12.2 18.2-6.6 9.1m3.2-4.4 4.8 3.5M19 20.5l4.6 3.3" />
          </svg>
          <div>
            <h3>唱 K</h3>
            <p>音色能打，KTV 绝不冷场，5 小时战绩可查。</p>
          </div>
        </div>
      </article>

      <article class="interest-card interest-card--running">
        <picture class="interest-card__image">
          <source media="(max-width: 600px)" srcset="/assets/about-interests/long-run.webp" />
          <img src="/assets/about-interests/long-run-wide.webp" alt="清晨沿河长跑的人" width="1920" height="240" loading="lazy" decoding="async" />
        </picture>
        <span class="card-sheen" aria-hidden="true"></span>
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="20.5" cy="6.5" r="2.5" />
            <path d="m18 11-4.2 4.3-5.3 1.2m9.5-5.5 4.5 4.4 4.7.6M14.5 15.2l3.7 4.4-5.7 7.2m5.7-7.2 6.2 6.1M9 26.8H4.8" />
          </svg>
          <div>
            <h3>长跑</h3>
            <p>弱于常人的身体素质，超乎常人的意志品质。</p>
          </div>
        </div>
      </article>

      <article class="interest-card interest-card--painting">
        <picture class="interest-card__image">
          <source media="(max-width: 600px)" srcset="/assets/about-interests/model-painting.webp" />
          <img src="/assets/about-interests/model-painting-wide.webp" alt="用细笔为模型上色" width="1920" height="240" loading="lazy" decoding="async" />
        </picture>
        <span class="card-sheen" aria-hidden="true"></span>
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="m22.5 4.7 4.8 4.8-11.8 11.8-6.7 1.9 1.9-6.7L22.5 4.7Z" />
            <path d="m19.5 7.7 4.8 4.8M8.8 23.2 5 27m1.5-5.4 3.9 3.9" />
          </svg>
          <div>
            <h3>笔涂</h3>
            <p>白模上色，还原那些鲜有人注意的精巧细节。</p>
          </div>
        </div>
      </article>

      <article class="interest-card interest-card--anime">
        <picture class="interest-card__image">
          <source media="(max-width: 600px)" srcset="/assets/about-interests/anime.webp" />
          <img src="/assets/about-interests/anime-wide.webp" alt="夜晚在客厅观看动画" width="1920" height="240" loading="lazy" decoding="async" />
        </picture>
        <span class="card-sheen" aria-hidden="true"></span>
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect x="4.5" y="7.5" width="23" height="17" rx="2" />
            <path d="m13.5 12.5 7 3.5-7 3.5v-7Zm-4-9 6.5 4 6.5-4M12 28h8" />
          </svg>
          <div>
            <h3>追番</h3>
            <p>保持初心和纯粹，动漫就是成年人的童话。</p>
          </div>
        </div>
      </article>
    </div>
  </section>

</article>

<style>
  .identity-card {
    --about-surface: rgb(24 23 32 / 96%);
    --about-inset: rgb(10 13 19 / 92%);
    --about-frame-inset: 5.25rem;
    --about-left-content-width: 100%;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto;
    align-content: stretch;
    gap: clamp(0.85rem, 1.35vw, 1.2rem) clamp(1.1rem, 2vw, 1.7rem);
    isolation: isolate;
    width: min(100%, 1478px);
    min-height: 740px;
    height: auto;
    margin-inline: auto;
    translate: 0 -1rem;
    overflow: hidden;
    border: 1px solid rgb(216 140 60 / 50%);
    border-radius: var(--radius-card);
    padding: var(--about-frame-inset);
    background:
      radial-gradient(circle at 10% 0%, rgb(0 221 235 / 9%), transparent 25rem),
      radial-gradient(circle at 94% 12%, rgb(255 210 0 / 7%), transparent 22rem),
      linear-gradient(145deg, rgb(245 224 193 / 5%), transparent 26%),
      var(--about-surface);
    box-shadow:
      inset 0 0 0 6px rgb(4 8 16 / 54%),
      inset 0 0 0 7px rgb(216 140 60 / 14%),
      0 28px 64px rgb(3 4 8 / 42%);
  }

  .identity-card::before,
  .identity-card::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .identity-card::before {
    inset: 12px;
    border: 1px solid rgb(190 174 204 / 12%);
    border-radius: 4px;
  }

  .identity-card::after {
    top: 0;
    left: 8%;
    width: 52%;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-copper) 16%, var(--color-accent) 50%, var(--color-link) 84%, transparent);
    box-shadow: 31vw calc(100% - 3px) 0 rgb(0 221 235 / 72%);
  }

  .identity-card__trace {
    position: absolute;
    z-index: -1;
    top: 1.25rem;
    right: 0.75rem;
    bottom: 1.25rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgb(216 140 60 / 48%) 12%, rgb(0 221 235 / 30%) 72%, transparent);
  }

  .identity-card__trace::before,
  .identity-card__trace::after {
    content: '';
    position: absolute;
    right: -3px;
    width: 7px;
    aspect-ratio: 1;
    border: 1px solid var(--color-copper);
    border-radius: 50%;
    background: var(--about-surface);
    box-shadow: 0 0 12px rgb(216 140 60 / 34%);
  }

  .identity-card__trace::before { top: 18%; }
  .identity-card__trace::after { bottom: 14%; border-color: var(--color-link); }

  .identity-left {
    --identity-copy-gap: clamp(0.75rem, 1.2vw, 1rem);
    position: relative;
    display: flex;
    grid-column: 1;
    grid-row: 1;
    flex-direction: column;
    gap: var(--identity-copy-gap);
    min-height: 0;
  }

  .identity-header {
    display: grid;
    grid-template-columns: clamp(72px, 6vw, 96px) minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    row-gap: var(--identity-copy-gap);
    align-content: start;
    align-items: start;
    min-height: 0;
    padding: 0;
  }

  .portrait-housing {
    --portrait-rim: 7px;
    position: relative;
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    max-width: 104px;
    aspect-ratio: 1;
    border: 1px solid rgb(216 140 60 / 74%);
    border-radius: var(--radius-control);
    padding: 7px;
    background: conic-gradient(from 40deg, var(--color-link), var(--color-copper), var(--color-accent), var(--color-link));
    box-shadow:
      inset 0 2px 1px rgb(255 255 255 / 48%),
      inset 0 -4px 3px rgb(14 10 23 / 76%),
      0 5px 3px rgb(4 5 10 / 76%),
      0 16px 28px rgb(4 5 10 / 42%);
  }

  .portrait-housing::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 3px solid var(--about-surface);
    border-radius: inherit;
    pointer-events: none;
  }

  .portrait-housing::after {
    content: '';
    position: absolute;
    inset: var(--portrait-rim);
    border: 1px solid rgb(255 244 216 / 36%);
    border-radius: 3px;
    box-shadow: inset 0 2px 3px rgb(0 0 0 / 48%), inset 0 -2px 2px rgb(0 0 0 / 56%);
    pointer-events: none;
  }

  .portrait-housing img {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    object-fit: cover;
  }

  .identity-copy {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 2;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--identity-copy-gap);
    width: var(--about-left-content-width);
    min-width: 0;
    min-height: 0;
    justify-self: end;
  }

  .identity-title {
    display: flex;
    flex-direction: column;
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
    align-items: flex-start;
    justify-content: center;
    justify-self: center;
    width: max-content;
    max-width: 100%;
    min-width: 0;
    transform: translateX(-0.5rem);
  }

  .identity-name {
    margin: 0;
    transform: translateX(-3px);
    color: #fff4d8;
    font-family: var(--font-data);
    font-size: clamp(2rem, 2.65vw, 2.85rem);
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1;
    text-shadow: 0 1px 0 #a86b32, 0 3px 0 #58405f, 0 10px 20px rgb(0 0 0 / 55%), 0 0 22px rgb(0 221 235 / 38%);
  }

  .identity-tagline {
    margin: 0.45rem 0 0;
    color: var(--color-accent);
    font-size: clamp(0.7rem, 0.9vw, 0.9rem);
    font-weight: 650;
    line-height: 1.4;
    white-space: nowrap;
  }

  .identity-copy p {
    --feedback-color: var(--color-accent);
    position: relative;
    display: grid;
    align-content: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(255 210 0 / 34%);
    border-radius: 4px;
    padding: clamp(0.9rem, 1.2vw, 1.2rem);
    background: linear-gradient(125deg, rgb(255 210 0 / 11%), rgb(216 140 60 / 10%) 55%, rgb(157 112 255 / 7%));
    color: #fff5d5;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 650;
    line-height: 1.62;
    text-align: left;
    text-shadow: 0 0 12px rgb(255 210 0 / 34%), 0 2px 5px rgb(0 0 0 / 80%);
    box-shadow:
      inset 0 2px 1px rgb(255 210 0 / 58%),
      inset 0 -4px 3px rgb(17 11 22 / 78%),
      0 4px 3px rgb(5 5 10 / 68%),
      0 14px 26px rgb(0 0 0 / 26%);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 220ms var(--ease-out);
  }

  .identity-copy p > span:not(.card-sheen) { position: relative; z-index: 3; text-wrap: pretty; }

  .identity-copy p[lang='en'] {
    --feedback-color: var(--color-link);
    border-color: rgb(0 221 235 / 28%);
    background: linear-gradient(125deg, rgb(0 221 235 / 9%), rgb(149 92 255 / 10%) 55%, rgb(255 210 0 / 5%));
    color: #f2eefb;
    font-family: 'Orbitron', var(--font-body);
    font-size: clamp(0.92rem, 1.2vw, 1.08rem);
    letter-spacing: 0.01em;
    line-height: 1.7;
    text-shadow: 0 0 14px rgb(0 221 235 / 34%), 0 2px 5px rgb(0 0 0 / 78%);
    box-shadow:
      inset 0 2px 1px rgb(0 221 235 / 52%),
      inset 0 -4px 3px rgb(10 12 29 / 82%),
      0 4px 3px rgb(5 5 10 / 68%),
      0 14px 26px rgb(0 0 0 / 26%);
  }

  .identity-copy a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgb(255 210 0 / 45%);
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .identity-copy a:hover {
    color: var(--color-accent-strong);
    text-decoration-color: currentColor;
  }

  .social-links {
    display: grid;
    grid-column: 3;
    grid-row: 1;
    grid-template-columns: repeat(4, 70px);
    align-self: center;
    gap: clamp(0.4rem, 0.6vw, 0.65rem);
    justify-content: end;
  }

  .social-links a {
    display: flex;
    width: 70px;
    height: 70px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--social-color, var(--color-link));
    border-radius: var(--radius-control);
    background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset));
    color: var(--social-color, var(--color-link));
    box-shadow:
      inset 0 2px 1px rgb(255 255 255 / 25%),
      inset 0 -4px 3px rgb(4 5 12 / 82%),
      0 4px 3px rgb(3 4 8 / 72%),
      0 13px 24px rgb(0 0 0 / 32%);
    transition: filter var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .social-links a:hover {
    border-color: var(--social-color, var(--color-copper));
    background: var(--color-surface-raised);
    filter: brightness(1.12);
    transform: translateY(-2px);
  }

  .social-links a:active {
    transform: translateY(2px);
    box-shadow: inset 0 3px 4px rgb(3 4 8 / 75%), inset 0 -1px 1px rgb(255 255 255 / 16%), 0 2px 3px rgb(3 4 8 / 60%);
  }
  .social-links a:focus-visible {
    box-shadow: inset 0 0 0 3px var(--color-link), inset 0 -4px 3px rgb(4 5 12 / 82%), 0 4px 3px rgb(3 4 8 / 72%), 0 13px 24px rgb(0 0 0 / 32%);
    filter: brightness(1.15);
  }
  .social-links :global(svg) { width: 38px; height: 38px; }
  .social-links span { display: none; }

  .expertise {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    grid-template-rows: auto minmax(0, 1fr);
    align-self: start;
    height: calc(40% - 0.5rem);
    min-height: 0;
    margin: 0;
    padding-top: clamp(1px, calc(3vw - 35px), 13px);
  }

  .expertise__panel {
    --feedback-color: var(--color-copper);
    position: relative;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--color-copper);
    border-radius: 5px;
    background: #080c12;
    box-shadow: 0 5px 4px rgb(3 4 8 / 72%), 0 20px 36px rgb(3 4 8 / 42%);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 220ms var(--ease-out);
  }

  .expertise__panel::after {
    content: '';
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .expertise__panel::after {
    inset: 0;
    background: linear-gradient(90deg, rgb(8 10 15 / 98%) 0%, rgb(8 10 15 / 90%) 43%, rgb(8 10 15 / 25%) 74%, rgb(8 10 15 / 10%));
    box-shadow: inset 0 2px 1px rgb(255 227 166 / 30%), inset 0 -5px 4px rgb(2 4 9 / 88%), inset 3px 0 3px rgb(2 4 9 / 46%);
  }

  .expertise__panel > img {
    position: absolute;
    inset: 0 0 0 auto;
    width: 82%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: filter 260ms ease, transform 520ms var(--ease-out);
  }

  .identity-copy p .card-sheen,
  .expertise__panel .card-sheen,
  .interest-card .card-sheen,
  .game-covers figure .card-sheen {
    position: absolute;
    z-index: 2;
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 70%;
    background: linear-gradient(90deg, transparent 7%, rgb(255 255 255 / 7%) 28%, rgb(255 255 255 / 52%) 49%, rgb(255 255 255 / 15%) 67%, transparent 86%);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-100%) skewX(-24deg);
    transition: transform 560ms ease, opacity 140ms ease 370ms;
  }

  .expertise__copy {
    position: relative;
    z-index: 3;
    display: grid;
    height: 100%;
    width: min(92%, 680px);
    align-content: center;
    padding: clamp(0.75rem, 1.1vw, 1rem);
  }

  .expertise h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.35rem;
    color: var(--color-copper);
    font-size: clamp(0.95rem, 1.44vw, 1.37rem);
    font-weight: 700;
    line-height: 1.15;
    text-shadow: 0 2px 8px rgb(0 0 0 / 80%);
  }

  .expertise__icon {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    background: currentColor;
    -webkit-mask: url('/assets/about-interests/hardware-chip.svg') center / contain no-repeat;
    mask: url('/assets/about-interests/hardware-chip.svg') center / contain no-repeat;
  }

  .section-heading h2 {
    margin: 0;
    color: #fff1c8;
    font-size: clamp(1.12rem, 1.85vw, 1.55rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-shadow: 0 1px 0 #8f5429, 0 2px 0 #3b2e37, 0 7px 14px rgb(0 0 0 / 62%), 0 0 20px rgb(216 140 60 / 38%);
  }

  .expertise p {
    max-width: 22em;
    margin: 0;
    color: #eee9e2;
    font-size: clamp(0.95rem, 1.2vw, 1.12rem);
    line-height: 1.35;
    text-shadow: 0 2px 12px rgb(0 0 0 / 72%);
  }

  .interests,
  .games {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    margin-top: 0;
  }

  .interests { grid-column: 2; grid-row: 1; align-self: end; height: calc(60% - 0.5rem); }
  .games {
    flex: none;
    grid-template-rows: auto auto;
    align-content: start;
    row-gap: var(--identity-copy-gap);
  }
  .games .section-heading { margin: 0; }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }

  .section-heading h2 { flex: none; text-align: center; }

  .section-heading span {
