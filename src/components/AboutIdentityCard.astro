---
import SocialIcon from '@/components/SocialIcon.astro';
import { SITE } from '@/config/site';

const games = [
  { src: '/assets/about-games/hearthstone.webp', alt: '炉石传说封面' },
  { src: '/assets/about-games/hades.webp', alt: '哈迪斯封面' },
  { src: '/assets/about-games/kingdom-rush.webp', alt: '王国保卫战封面' },
  { src: '/assets/about-games/nine-kings.webp', alt: '九王封面' },
  { src: '/assets/about-games/dead-cells.webp', alt: '死亡细胞封面' },
  { src: '/assets/about-games/turing-complete.webp', alt: '图灵完备封面' }
] as const;
---

<article class="identity-card" aria-labelledby="about-name">
  <div class="identity-card__trace" aria-hidden="true"></div>

  <header class="identity-header">
    <div class="portrait-housing">
      <img
        src={SITE.author.avatar}
        alt={`${SITE.author.name} 的头像`}
        width="795"
        height="795"
        loading="eager"
        decoding="async"
      />
      <span aria-hidden="true"></span>
    </div>

    <div class="identity-copy">
      <h1 id="about-name">{SITE.author.name}</h1>
      <p lang="en">
        PhD student <a href="https://github.com/ININ-Polaris" target="_blank" rel="noreferrer">@ININ-Polaris</a>
        at Beijing Institute of Technology, interested in Hardware Acceleration, Computer Architecture and AI Accelerators.
      </p>
      <p>入门级科研工作者，机器人全栈开发菜鸟，RM 退役队员，设计爱好者。除了编码，我还喜欢记录学到的东西，收集有趣的小玩意儿，间歇性发疯，偶尔心血来潮。</p>
    </div>

    <nav class="social-links" aria-label="社交媒体联系方式">
      {SITE.socials.map((social) => (
        <a
          href={social.url}
          aria-label={social.label}
          target={social.url.startsWith('http') ? '_blank' : undefined}
          rel={social.url.startsWith('http') ? 'me noreferrer' : undefined}
          style={`--social-color: ${social.color}`}
        >
          <SocialIcon id={social.id} />
          <span>{social.label}</span>
        </a>
      ))}
    </nav>
  </header>

  <section class="expertise" aria-labelledby="expertise-title">
    <div class="section-heading">
      <h2 id="expertise-title">专业领域</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="expertise__panel">
      <img
        src="/assets/about-interests/hardware-acceleration-card.webp"
        alt="硬件加速芯片与蓝金色电路走线"
        width="2172"
        height="724"
        loading="eager"
        decoding="async"
      />
      <div class="expertise__copy">
        <p>聚焦硬件加速，探索专用计算架构、并行处理、数据流优化与软硬件协同设计。通过分析计算与存储瓶颈，提升计算密集型任务的处理速度和能效，为复杂应用提供更高效的算力支持。</p>
      </div>
    </div>
  </section>

  <section class="interests" aria-labelledby="interests-title">
    <div class="section-heading">
      <h2 id="interests-title">生活爱好</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class="interest-grid">
      <article class="interest-card interest-card--singing">
        <img src="/assets/about-interests/singing.webp" alt="KTV 包厢里的麦克风" width="2172" height="724" loading="lazy" decoding="async" />
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M20.7 4.8a5.1 5.1 0 0 1 2.8 6.7l-3.2 7a5.1 5.1 0 0 1-9.3-4.2l3.2-7a5.1 5.1 0 0 1 6.5-2.5Z" />
            <path d="m12.2 18.2-6.6 9.1m3.2-4.4 4.8 3.5M19 20.5l4.6 3.3" />
          </svg>
          <div>
            <h3>唱 K</h3>
            <p>音色能打，KTV 绝不冷场，5 小时战绩可查。</p>
          </div>
        </div>
      </article>

      <article class="interest-card interest-card--running">
        <img src="/assets/about-interests/long-run.webp" alt="清晨沿河长跑的人" width="2171" height="724" loading="lazy" decoding="async" />
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="20.5" cy="6.5" r="2.5" />
            <path d="m18 11-4.2 4.3-5.3 1.2m9.5-5.5 4.5 4.4 4.7.6M14.5 15.2l3.7 4.4-5.7 7.2m5.7-7.2 6.2 6.1M9 26.8H4.8" />
          </svg>
          <div>
            <h3>长跑</h3>
            <p>弱于常人的身体素质，超乎常人的意志品质。</p>
          </div>
        </div>
      </article>

      <article class="interest-card interest-card--painting">
        <img src="/assets/about-interests/model-painting.webp" alt="用细笔为模型上色" width="2164" height="727" loading="lazy" decoding="async" />
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="m22.5 4.7 4.8 4.8-11.8 11.8-6.7 1.9 1.9-6.7L22.5 4.7Z" />
            <path d="m19.5 7.7 4.8 4.8M8.8 23.2 5 27m1.5-5.4 3.9 3.9" />
          </svg>
          <div>
            <h3>笔涂</h3>
            <p>白模上色，还原那些鲜有人注意的精巧细节。</p>
          </div>
        </div>
      </article>

      <article class="interest-card interest-card--anime">
        <img src="/assets/about-interests/anime.webp" alt="夜晚在客厅观看动画" width="2172" height="724" loading="lazy" decoding="async" />
        <div class="interest-card__copy">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect x="4.5" y="7.5" width="23" height="17" rx="2" />
            <path d="m13.5 12.5 7 3.5-7 3.5v-7Zm-4-9 6.5 4 6.5-4M12 28h8" />
          </svg>
          <div>
            <h3>追番</h3>
            <p>保持初心和纯粹，动漫就是成年人的童话。</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="games" aria-labelledby="games-title">
    <div class="section-heading">
      <h2 id="games-title">在玩</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="game-covers">
      {games.map((game) => (
        <figure>
          <img src={game.src} alt={game.alt} width="480" height="720" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>
</article>

<style>
  .identity-card {
    --about-surface: rgb(24 23 32 / 96%);
    --about-inset: rgb(10 13 19 / 92%);
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 31%) minmax(0, 1fr);
    grid-template-rows: minmax(0, 0.93fr) minmax(0, 1.18fr) minmax(0, 1fr);
    gap: clamp(0.65rem, 1vw, 0.92rem) clamp(0.75rem, 1.25vw, 1.1rem);
    isolation: isolate;
    width: min(100%, 1478px);
    height: min(898px, calc(100dvh - var(--header-height) - 1rem));
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid rgb(216 140 60 / 50%);
    border-radius: var(--radius-card);
    padding: clamp(0.85rem, 1.5vw, 1.1rem);
    background:
      radial-gradient(circle at 10% 0%, rgb(0 221 235 / 9%), transparent 25rem),
      radial-gradient(circle at 94% 12%, rgb(255 210 0 / 7%), transparent 22rem),
      linear-gradient(145deg, rgb(245 224 193 / 5%), transparent 26%),
      var(--about-surface);
    box-shadow:
      inset 0 0 0 6px rgb(4 8 16 / 54%),
      inset 0 0 0 7px rgb(216 140 60 / 14%),
      0 28px 64px rgb(3 4 8 / 42%);
  }

  .identity-card::before,
  .identity-card::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .identity-card::before {
    inset: 13px;
    border: 1px solid rgb(190 174 204 / 12%);
    border-radius: 4px;
  }

  .identity-card::after {
    top: 0;
    left: 8%;
    width: 52%;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-copper) 16%, var(--color-accent) 50%, var(--color-link) 84%, transparent);
    box-shadow: 31vw calc(100% - 3px) 0 rgb(0 221 235 / 72%);
  }

  .identity-card__trace {
    position: absolute;
    z-index: -1;
    top: 1.25rem;
    right: 1.1rem;
    bottom: 1.25rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgb(216 140 60 / 48%) 12%, rgb(0 221 235 / 30%) 72%, transparent);
  }

  .identity-card__trace::before,
  .identity-card__trace::after {
    content: '';
    position: absolute;
    right: -3px;
    width: 7px;
    aspect-ratio: 1;
    border: 1px solid var(--color-copper);
    border-radius: 50%;
    background: var(--about-surface);
    box-shadow: 0 0 12px rgb(216 140 60 / 34%);
  }

  .identity-card__trace::before { top: 18%; }
  .identity-card__trace::after { bottom: 14%; border-color: var(--color-link); }

  .identity-header {
    position: relative;
    display: grid;
    grid-column: 1;
    grid-row: 1 / -1;
    grid-template-columns: clamp(82px, 8vw, 104px) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 1rem 0.9rem;
    align-content: center;
    align-items: start;
    min-height: 0;
    padding: 0.5rem 1rem 0.5rem 0.35rem;
  }

  .identity-header::after {
    content: '';
    position: absolute;
    top: 0.6rem;
    right: 0;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgb(216 140 60 / 70%) 8%, rgb(0 221 235 / 45%) 74%, transparent);
  }

  .portrait-housing {
    position: relative;
    width: 100%;
    max-width: 104px;
    aspect-ratio: 1;
    border: 1px solid rgb(216 140 60 / 74%);
    border-radius: 50%;
    padding: 7px;
    background: conic-gradient(from 40deg, var(--color-link), var(--color-copper), var(--color-accent), var(--color-link));
    box-shadow: 0 12px 26px rgb(4 5 10 / 40%);
  }

  .portrait-housing::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 3px solid var(--about-surface);
    border-radius: inherit;
    pointer-events: none;
  }

  .portrait-housing img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .portrait-housing span {
    position: absolute;
    right: 3%;
    bottom: 13%;
    width: 16px;
    aspect-ratio: 1;
    border: 3px solid var(--about-surface);
    border-radius: 50%;
    background: var(--color-link);
    box-shadow: 0 0 14px rgb(0 221 235 / 72%);
  }

  .identity-copy { min-width: 0; }

  .identity-copy h1 {
    margin: 0 0 0.65rem;
    color: var(--color-heading);
    font-family: 'Orbitron', var(--font-body);
    font-size: clamp(1.8rem, 3vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-shadow: 0 0 24px rgb(0 221 235 / 16%);
  }

  .identity-copy p {
    max-width: 72ch;
    margin: 0.48rem 0 0;
    color: var(--color-text);
    font-size: clamp(0.76rem, 0.92vw, 0.88rem);
    line-height: 1.58;
  }

  .identity-copy p[lang='en'] { color: #d9d2dc; }

  .identity-copy a {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: rgb(0 221 235 / 45%);
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .identity-copy a:hover {
    color: var(--color-accent-strong);
    text-decoration-color: currentColor;
  }

  .social-links {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    align-content: center;
  }

  .social-links a {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    min-height: 46px;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgb(190 174 204 / 20%);
    border-radius: var(--radius-control);
    padding: 0.55rem 0.7rem;
    background: linear-gradient(110deg, rgb(255 255 255 / 4%), transparent), var(--about-inset);
    color: var(--social-color, var(--color-link));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 4%);
    transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .social-links a:hover {
    border-color: var(--social-color, var(--color-link));
    background-color: rgb(255 255 255 / 4%);
    transform: translateY(-2px);
  }

  .social-links a:active { transform: translateY(0); }
  .social-links :global(svg) { width: 24px; height: 24px; }
  .social-links span { color: var(--color-heading); font-size: 0.83rem; font-weight: 650; }

  .expertise {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    margin: 0;
  }

  .expertise__panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-radius: 5px;
    background: #080c12;
    box-shadow: 0 18px 36px rgb(3 4 8 / 34%);
  }

  .expertise__panel::before,
  .expertise__panel::after {
    content: '';
    position: absolute;
    z-index: 2;
    pointer-events: none;
  }

  .expertise__panel::before {
    inset: 0;
    border: 1px solid rgb(0 221 235 / 38%);
    border-radius: inherit;
    box-shadow: inset 0 0 0 5px rgb(4 8 16 / 28%);
  }

  .expertise__panel::after {
    inset: 0;
    background: linear-gradient(90deg, rgb(8 10 15 / 98%) 0%, rgb(8 10 15 / 90%) 43%, rgb(8 10 15 / 25%) 74%, rgb(8 10 15 / 10%));
  }

  .expertise__panel > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .expertise__copy {
    position: relative;
    z-index: 3;
    display: grid;
    height: 100%;
    width: min(65%, 680px);
    align-content: center;
    padding: clamp(0.9rem, 1.7vw, 1.35rem);
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    line-height: 1.2;
  }

  .expertise p {
    max-width: 56ch;
    margin: 0;
    color: #eee9e2;
    font-size: clamp(0.76rem, 0.95vw, 0.88rem);
    line-height: 1.58;
    text-shadow: 0 2px 12px rgb(0 0 0 / 72%);
  }

  .interests,
  .games {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    margin-top: 0;
  }

  .interests { grid-column: 2; grid-row: 2; }
  .games { grid-column: 2; grid-row: 3; }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }

  .section-heading span {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgb(216 140 60 / 72%), rgb(0 221 235 / 36%), transparent);
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    min-height: 0;
    gap: 0.55rem 0.65rem;
  }

  .interest-card {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--interest-color);
    border-radius: 5px;
    background: #101218;
    box-shadow: 0 10px 24px rgb(3 4 8 / 26%);
  }

  .interest-card::before,
  .interest-card::after {
    content: '';
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .interest-card::before {
    inset: 0;
    background: linear-gradient(90deg, rgb(13 14 20 / 98%) 0%, rgb(13 14 20 / 92%) 36%, rgb(13 14 20 / 24%) 66%, rgb(13 14 20 / 4%));
  }

  .interest-card::after {
    right: 0;
    bottom: 0;
    width: 42%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--interest-color));
  }

  .interest-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.94) brightness(0.92);
    transition: filter var(--duration-normal) var(--ease-out), transform 420ms var(--ease-out);
  }

  .interest-card:hover > img {
    filter: saturate(1) brightness(0.9);
    transform: scale(1.018);
  }

  .interest-card__copy {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    width: min(76%, 340px);
    height: 100%;
    min-height: 0;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem 0.45rem 0.75rem;
  }

  .interest-card__copy svg {
    width: 32px;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
    padding: 6px;
    color: var(--interest-color);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--interest-color) 42%, transparent));
  }

  .interest-card h3 {
    margin: 0;
    color: var(--interest-color);
    font-size: 0.86rem;
    line-height: 1.3;
  }

  .interest-card p {
    margin: 0.28rem 0 0;
    color: #eee9e2;
    font-size: clamp(0.75rem, 0.82vw, 0.8rem);
    line-height: 1.42;
    text-shadow: 0 2px 8px rgb(0 0 0 / 90%);
  }

  .interest-card--singing { --interest-color: #ff5bc8; }
  .interest-card--running { --interest-color: #43e5bd; }
  .interest-card--painting { --interest-color: #ffcc3f; }
  .interest-card--anime { --interest-color: #74caff; }

  .game-covers {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.55rem, 1.35vw, 1rem);
    min-height: 0;
    perspective: 1000px;
  }

  .game-covers figure {
    position: relative;
    margin: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(190 174 204 / 24%);
    border-radius: 5px;
    background: var(--about-inset);
    box-shadow: 0 12px 22px rgb(3 4 8 / 32%);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
  }

  .game-covers figure::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(125deg, rgb(255 255 255 / 13%), transparent 24% 76%, rgb(0 0 0 / 20%));
    pointer-events: none;
  }

  .game-covers figure:hover {
    z-index: 1;
    border-color: rgb(255 210 0 / 72%);
    box-shadow: 0 18px 30px rgb(3 4 8 / 42%);
    transform: translateY(-5px) rotateX(1deg);
  }

  .game-covers img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .identity-card {
      grid-template-columns: minmax(248px, 33%) minmax(0, 1fr);
      height: calc(100dvh - var(--header-height) - 1.25rem);
      padding: 0.75rem;
    }
    .identity-header { grid-template-columns: 76px minmax(0, 1fr); padding-right: 0.75rem; }
    .portrait-housing { max-width: 76px; }
    .identity-copy h1 { font-size: 1.75rem; }
    .identity-copy p { font-size: 0.75rem; }
    .social-links a { grid-template-columns: 22px minmax(0, 1fr); min-height: 44px; padding: 0.4rem 0.55rem; }
    .social-links :global(svg) { width: 21px; height: 21px; }
    .social-links span { font-size: 0.75rem; }
    .interest-card__copy { width: 84%; }
    .game-covers { gap: 0.5rem; }
  }

  @media (min-width: 901px) {
    .identity-header { grid-template-columns: clamp(90px, 8.8vw, 114px) minmax(0, 1fr); }
    .portrait-housing { max-width: 114px; }
    .identity-copy h1 { font-size: clamp(1.98rem, 3.3vw, 3.05rem); }
    .identity-copy p,
    .expertise p { font-size: clamp(0.82rem, 1vw, 0.97rem); }
    .social-links a { min-height: 50px; }
    .social-links :global(svg) { width: 26px; height: 26px; }
    .social-links span { font-size: 0.9rem; }
    .social-links a:nth-child(3) { margin-left: 3.75rem; }
    .section-heading h2 { font-size: clamp(1.15rem, 1.85vw, 1.6rem); }
    .interest-card__copy { grid-template-columns: 37px minmax(0, 1fr); }
    .interest-card__copy svg { width: 35px; }
    .interest-card h3 { font-size: 0.94rem; }
    .interest-card p { font-size: clamp(0.8rem, 0.9vw, 0.88rem); }
  }

  @media (max-width: 700px) {
    .identity-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1.7fr) minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 0.78fr);
      gap: 0.48rem;
      height: calc(100dvh - var(--header-height) - 1rem);
      padding: 0.65rem;
    }
    .identity-card::before { inset: 8px; }
    .identity-card__trace { display: none; }
    .identity-header {
      grid-column: 1;
      grid-row: 1;
      grid-template-columns: 86px minmax(0, 1fr);
