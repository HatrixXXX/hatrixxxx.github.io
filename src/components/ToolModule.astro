---
import ToolGlyph from '@/components/ToolGlyph.astro';
import type { SoftwareTool } from '@/data/software-tools';

interface Props {
  tool: SoftwareTool;
}

const { tool } = Astro.props;
---

<a
  class="tool-module"
  href={tool.href}
  target="_blank"
  rel="noreferrer"
  aria-label={`${tool.name}：${tool.description}（在新标签页打开）`}
  data-tool-module
  data-tool-name={tool.name}
  data-tool-description={tool.description}
  data-tool-kind={tool.kind}
>
  <span class="tool-module__face" data-tool-face>
    <span class="tool-module__screws" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </span>
    <span class="tool-module__signal" aria-hidden="true"></span>
    <span class="tool-module__icon" aria-hidden="true">
      <ToolGlyph name={tool.icon} />
    </span>
  </span>
  <span class="tool-module__name" data-tool-label>{tool.name}</span>
</a>

<style>
  .tool-module {
    display: block;
    min-width: 0;
    color: var(--color-link);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .tool-module__face {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    min-width: 0;
    border: 1px solid #625568;
    border-radius: 3px;
    background:
      linear-gradient(145deg, rgb(255 245 231 / 7%), transparent 34%),
      linear-gradient(160deg, #312c39, #211e29 62%, #191720);
    box-shadow:
      0 8px 16px rgb(5 4 8 / 24%),
      inset 0 1px rgb(255 255 255 / 6%),
      inset 0 -2px rgb(0 0 0 / 22%);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .tool-module__face::before,
  .tool-module__face::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .tool-module__face::before {
    inset: 6px;
    border: 1px solid rgb(190 174 204 / 13%);
  }

  .tool-module__face::after {
    right: 8px;
    bottom: 8px;
    width: 13px;
    height: 3px;
    background: rgb(243 187 98 / 66%);
    box-shadow: 0 0 7px rgb(243 187 98 / 14%);
  }

  .tool-module__screws {
    position: absolute;
    inset: 10px;
    pointer-events: none;
  }

  .tool-module__screws span {
    position: absolute;
    width: 3px;
    height: 3px;
    background: rgb(181 140 101 / 74%);
  }

  .tool-module__screws span:nth-child(1) { top: 0; left: 0; }
  .tool-module__screws span:nth-child(2) { top: 0; right: 0; }
  .tool-module__screws span:nth-child(3) { right: 0; bottom: 0; }
  .tool-module__screws span:nth-child(4) { bottom: 0; left: 0; }

  .tool-module__signal {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 18px;
    height: 2px;
    background: rgb(132 212 198 / 58%);
    box-shadow: 0 0 7px rgb(132 212 198 / 18%);
    transform: translateX(-50%);
  }

  .tool-module__icon {
    width: clamp(2.4rem, 4vw, 3.25rem);
    height: clamp(2.4rem, 4vw, 3.25rem);
    filter: drop-shadow(0 0 8px rgb(132 212 198 / 12%));
    transition:
      color var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .tool-module__name {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-text);
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    overflow-wrap: anywhere;
  }

  :global(html[data-theme='light'] body.software-page) .tool-module {
    color: #9de9dc;
  }

  .tool-module:hover .tool-module__face,
  .tool-module:focus-visible .tool-module__face,
  .tool-module[data-active] .tool-module__face {
    border-color: rgb(132 212 198 / 76%);
    box-shadow:
      0 10px 20px rgb(5 4 8 / 30%),
      inset 0 0 0 1px rgb(132 212 198 / 13%),
      inset 0 0 1.5rem rgb(132 212 198 / 6%);
    transform: translateY(-2px);
  }

  .tool-module:hover .tool-module__icon,
  .tool-module:focus-visible .tool-module__icon,
  .tool-module[data-active] .tool-module__icon {
    color: #a9eee2;
    filter: drop-shadow(0 0 9px rgb(132 212 198 / 24%));
    transform: scale(1.04);
  }

  .tool-module:focus-visible {
    border-radius: 3px;
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 420px) {
    .tool-module__face::before {
      inset: 5px;
    }

    .tool-module__screws {
      inset: 8px;
    }

    .tool-module__signal {
      top: 8px;
      width: 14px;
    }

    .tool-module__icon {
      width: 2.15rem;
      height: 2.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-module__face,
    .tool-module__icon,
    .tool-module:hover .tool-module__face,
    .tool-module:focus-visible .tool-module__face,
    .tool-module[data-active] .tool-module__face,
    .tool-module:hover .tool-module__icon,
    .tool-module:focus-visible .tool-module__icon,
    .tool-module[data-active] .tool-module__icon {
      transform: none;
      transition: none;
    }
  }
</style>
