<dialog class="search-overlay" aria-labelledby="search-heading" data-search-overlay>
  <section class="search-panel">
    <header>
      <div>
        <p class="search-kicker">站内检索</p>
        <h2 id="search-heading">搜索文章</h2>
      </div>
      <button type="button" aria-label="关闭搜索" data-close-search>×</button>
    </header>

    <label class="search-field">
      <span class="sr-only">搜索文章</span>
      <input type="search" aria-label="搜索文章" placeholder="输入标题、分类、标签或正文关键词" data-search-input />
      <kbd>Esc</kbd>
    </label>

    <p class="search-status" aria-live="polite" data-search-status>输入关键词开始搜索</p>
    <ol class="search-results" data-search-results></ol>
  </section>
</dialog>

<style>
  .search-overlay {
    width: min(calc(100% - 32px), 760px);
    max-height: min(80vh, 720px);
    margin: 10vh auto 0;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-panel);
  }

  .search-overlay::backdrop {
    background: rgb(5 7 10 / 72%);
    backdrop-filter: blur(5px);
  }

  .search-panel {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  header,
  .search-field {
    display: flex;
    align-items: center;
  }

  header {
    justify-content: space-between;
    gap: 1rem;
  }

  h2,
  .search-kicker {
    margin: 0;
  }

  h2 {
    color: var(--color-heading, var(--color-text));
    font-size: 1.35rem;
  }

  .search-kicker {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  [data-close-search] {
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface-raised);
    cursor: pointer;
    font-size: 1.4rem;
  }

  .search-field {
    gap: 0.7rem;
    margin-top: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 9px;
    padding: 0 0.8rem;
    background: var(--color-bg);
  }

  .search-field:focus-within {
    border-color: var(--color-accent);
  }

  input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    padding: 0.9rem 0;
    background: transparent;
  }

  kbd {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .search-status {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .search-results {
    display: grid;
    max-height: 50vh;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  .search-results :global(a) {
    display: block;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
    background: var(--color-surface-raised);
  }

  .search-results :global(a:hover) {
    border-color: var(--color-accent);
  }

  .search-results :global(strong) {
    display: block;
    color: var(--color-heading, var(--color-text));
  }

  .search-results :global(span) {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
