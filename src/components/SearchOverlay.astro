<dialog class="search-overlay" aria-labelledby="search-heading" data-search-overlay>
  <section class="search-panel">
    <header>
      <div>
        <h2 id="search-heading">搜索文章</h2>
      </div>
      <button type="button" aria-label="关闭搜索" data-close-search><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    </header>

    <label class="search-field">
      <span class="sr-only">搜索文章</span>
      <input type="search" aria-label="搜索文章" placeholder="输入标题、摘要或正文关键词" data-search-input />
      <kbd>Esc</kbd>
    </label>

    <p class="search-status" aria-live="polite" data-search-status>输入关键词开始搜索</p>
    <ol class="search-results" data-search-results></ol>
  </section>
</dialog>

<style>
  .search-overlay {
    width: min(calc(100% - 32px), 760px);
    max-height: min(80vh, 720px);
    margin: 10vh auto 0;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    background: var(--surface-sheen), var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-inset), var(--shadow-panel);
  }

  .search-overlay[open] {
    animation: search-panel-enter 190ms var(--ease-out) both;
  }

  .search-overlay::backdrop {
    background: rgb(23 21 29 / 72%);
    backdrop-filter: blur(5px);
  }

  .search-overlay[open]::backdrop {
    animation: search-backdrop-enter 190ms ease-out both;
  }

  .search-panel {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  header,
  .search-field {
    display: flex;
    align-items: center;
  }

  header {
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    margin: 0;
  }

  h2 {
    color: var(--color-heading, var(--color-text));
    font-size: 1.35rem;
  }

  [data-close-search] {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    background: var(--color-surface-raised);
    cursor: pointer;
    font-size: 1.4rem;
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease, background-color var(--duration-fast) ease, transform 100ms ease;
  }

  [data-close-search] svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }

  [data-close-search]:hover {
    border-color: var(--color-copper);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  [data-close-search]:active {
    transform: translateY(1px);
  }

  [data-close-search]:focus-visible,
  .search-results :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .search-field {
    gap: 0.7rem;
    margin-top: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: 0 0.8rem;
    background: var(--color-inset);
    box-shadow: var(--shadow-inset);
    transition: border-color var(--duration-fast) ease;
  }

  .search-field:focus-within {
    border-color: var(--color-accent);
  }

  input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    padding: 0.9rem 0;
    background: transparent;
    caret-color: var(--color-accent);
  }

  input::placeholder { color: var(--color-muted); opacity: 1; }

  kbd {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: 0.1rem 0.35rem;
    color: var(--color-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
  }

  .search-status {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .search-results {
    display: grid;
    max-height: 50vh;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    scrollbar-color: var(--color-copper) var(--color-inset);
  }

  .search-results :global(a) {
    display: block;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: 0.75rem 0.9rem;
    background: var(--color-surface-raised);
    transition: border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .search-results :global(a:hover) {
    border-color: var(--color-copper);
    background: var(--color-accent-soft);
  }

  .search-results :global(strong) {
    display: block;
    color: var(--color-heading, var(--color-text));
  }

  .search-results :global(span) {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .search-results :global([data-search-excerpt]) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .search-results :global(mark) {
    border-radius: 3px;
    padding: 0 0.1em;
    background: var(--color-accent-soft);
    color: inherit;
  }

  .search-results :global(.search-lock-indicator) {
    display: inline;
    margin: 0 0 0 0.25em;
    color: inherit;
    font-size: 0.78em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .search-overlay {
      margin-top: 4vh;
    }
  }

  @keyframes search-panel-enter {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes search-backdrop-enter {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay,
    .search-overlay::backdrop,
    .search-overlay *,
    .search-results :global(a) {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
