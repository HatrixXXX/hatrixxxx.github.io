---
import type { Bookmark } from '@/data/bookmarks';

interface Props {
  bookmarks: Bookmark[];
}

const { bookmarks } = Astro.props;
const first = bookmarks[0];
---

<section class="favorites-console" data-favorites aria-label="收藏夹转轴">
  <div class="favorites-machine">
    <div class="favorites-machine__bezel">
        <div class="favorites-reel" data-favorites-reel tabindex="0" role="group" aria-label="网址转轴，点击侧边叶片选择，点击中间叶片访问；也可用滚轮、拖拽或上下方向键选择">
          <div class="favorites-reel__well" aria-hidden="true"></div>
          {bookmarks.map((bookmark, index) => (
            <button
              class="favorites-reel__item"
              type="button"
              data-favorites-item
              data-title={bookmark.title}
              data-description={bookmark.description}
              data-url={bookmark.url}
              data-index={index}
              tabindex="-1"
              aria-label={`选择 ${bookmark.title}`}
            ><span class="favorites-reel__title">{bookmark.title}</span><span class="favorites-reel__signal" aria-hidden="true"></span></button>
          ))}
          <div class="favorites-reel__focus" aria-hidden="true"></div>
          <div class="favorites-reel__shine" aria-hidden="true"></div>
        </div>
    </div>

    <div class="favorites-machine__console">
      <aside class="favorites-readout" aria-label="当前收藏网站">
        <h2 data-favorites-selected>{first?.title}</h2>
        <p class="favorites-readout__description" data-favorites-description>{first?.description}</p>
      </aside>
      <div class="favorites-actions">
        <button class="favorites-random" data-favorites-random type="button" aria-label="随机转一个链接"><span class="favorites-random__label">试试手气</span></button>
      </div>
    </div>
    <div class="favorites-machine__frame" aria-hidden="true"></div>
    <div class="favorites-reel__selectors">
      <button class="favorites-reel__paddle favorites-reel__paddle--left" data-favorites-arrow data-favorites-previous type="button" aria-label="上一个链接"><span class="favorites-reel__paddle-plate" aria-hidden="true"></span><span class="favorites-reel__paddle-screw" aria-hidden="true"></span></button>
      <button class="favorites-reel__paddle favorites-reel__paddle--right" data-favorites-arrow data-favorites-next type="button" aria-label="下一个链接"><span class="favorites-reel__paddle-plate" aria-hidden="true"></span><span class="favorites-reel__paddle-screw" aria-hidden="true"></span></button>
    </div>
  </div>
  <p class="favorites-status" data-favorites-status role="status" aria-live="polite" aria-atomic="true">已选中：{first?.title}</p>
</section>
