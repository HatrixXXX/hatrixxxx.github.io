---
import { projectPanel, type Point } from '@/lib/home-projection';
interface Props {
  name: string;
  width: number;
  height: number;
  corners?: readonly Point[];
  x?: number;
  y?: number;
}
const { name, width, height, corners, x = 0, y = 0 } = Astro.props;
const transform = corners ? `matrix3d(${projectPanel(width, height, corners).join(',')})` : 'none';
---
<div class="home-panel" data-home-panel={name} style={`left:${x}px;top:${y}px;width:${width}px;height:${height}px;transform:${transform}`}>
  <slot />
</div>
<style>
  .home-panel { position: absolute; inset: 0 auto auto 0; transform-origin: 0 0; }
  .home-panel:focus-within { z-index: 5; }
</style>
