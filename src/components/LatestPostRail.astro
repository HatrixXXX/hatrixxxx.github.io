---
import { Image } from 'astro:assets';
import type { PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Props { posts: readonly PostEntry[]; limit: number; }
const { posts, limit } = Astro.props;
const latest = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, limit);

---
{latest.length > 0 && <section class="latest-posts" data-latest-posts aria-label="最新文章">
  <h2>最新文章</h2>
  <div class="latest-list">
    {latest.map((post) => <a class="latest-item" href={postPath(post.data.legacySlug)}>
      <Image src={post.data.cover || '/assets/blog-cards/default-cover.webp'} alt="" width={176} height={112} quality={75} loading="lazy" decoding="async" />
      <span>{post.data.title}</span>
    </a>)}
  </div>
</section>}

<style>
  .latest-posts {
    margin-top: 0.15rem;
    border: 1px solid var(--chassis-edge);
    border-radius: var(--radius-card);
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: inset 0 0 0 4px var(--chassis-groove), 0 10px 24px rgb(3 5 11 / 24%);
    overflow: hidden;
  }

  h2 {
    margin: 0;
    border-bottom: 1px solid var(--color-line);
    padding: 0.9rem 1.1rem 0.8rem;
    color: var(--color-heading);
    font-size: 0.94rem;
    font-weight: 650;
    background: linear-gradient(90deg, rgb(216 140 60 / 11%), transparent 80%);
  }

  .latest-list { padding: 0.35rem 0.7rem 0.6rem; }

  .latest-item {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    min-height: 76px;
    border-bottom: 1px solid var(--color-line);
    padding: 0.55rem 0.35rem;
    color: var(--color-heading);
    font-size: 0.82rem;
    line-height: 1.45;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .latest-item:last-child { border-bottom: 0; }

  .latest-item :global(img) {
    width: 88px;
    height: 56px;
    border: 1px solid var(--chassis-edge);
    border-radius: var(--radius-control);
    object-fit: cover;
    box-shadow: 0 3px 8px rgb(0 0 0 / 30%);
  }

  .latest-item span {
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .latest-item:hover,
  .latest-item:focus-visible { background: rgb(0 221 235 / 6%); }

  .latest-item:hover span,
  .latest-item:focus-visible span { color: var(--color-link); }

</style>
