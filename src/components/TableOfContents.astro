---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth >= 2 && depth <= 4);
---

{
  headings.length > 0 && (
    <aside class="toc" data-table-of-contents>
      <div class="toc-desktop" data-toc-desktop>
        <h2>目录</h2>
        <nav aria-label="文章目录">
          <ol>
            {headings.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
      <details class="toc-mobile" data-toc-mobile open>
        <summary>目录</summary>
        <nav aria-label="文章目录">
          <ol>
            {headings.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </aside>
  )
}

<style>
  .toc {
    position: sticky;
    top: 1.25rem;
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    max-height: calc(100vh - 2.5rem);
    overflow: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
  }

  .toc-desktop,
  .toc-mobile {
    padding: 1rem 1.1rem;
  }

  .toc-mobile {
    display: none;
  }

  h2,
  summary {
    margin: 0;
    color: #fff;
    font-size: 0.94rem;
    font-weight: 800;
  }

  summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    cursor: pointer;
  }

  ol {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.35rem;
  }

  li[data-depth='3'] {
    padding-left: 0.8rem;
  }

  li[data-depth='4'] {
    padding-left: 1.6rem;
  }

  a {
    display: block;
    border-left: 2px solid transparent;
    padding-left: 0.65rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  a:hover,
  a[aria-current='location'] {
    border-left-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .toc {
      position: static;
      grid-column: 1;
      grid-row: 1;
      max-height: none;
    }

    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
    }
  }
</style>
