---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth >= 2 && depth <= 4);
---

{
  headings.length > 0 && (
    <aside class="toc" data-table-of-contents>
      <div class="toc-desktop" data-toc-desktop>
        <h2>目录</h2>
        <nav aria-label="文章目录">
          <ol>
            {headings.map((heading) => (
              <li data-depth={heading.depth}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  data-toc-depth={heading.depth}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
      <details class="toc-mobile" data-toc-mobile open>
        <summary>目录</summary>
        <nav aria-label="文章目录">
          <ol>
            {headings.map((heading) => (
              <li data-depth={heading.depth}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  data-toc-depth={heading.depth}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </aside>
  )
}

<style>
  .toc {
    position: static;
    min-width: 0;
    border: 1px solid var(--chassis-edge);
    border-radius: var(--radius-card);
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: inset 0 0 0 4px var(--chassis-groove), 0 10px 24px rgb(3 5 11 / 24%);
    min-height: 0;
    overflow: hidden;
  }

  .toc-desktop,
  .toc-mobile {
    min-height: 0;
  }

  .toc-mobile {
    display: block;
  }

  h2,
  summary {
    margin: 0;
    border-bottom: 1px solid var(--color-line);
    padding: 0.9rem 1.1rem 0.8rem;
    color: var(--color-heading);
    font-size: 0.94rem;
    font-weight: 650;
    background: linear-gradient(90deg, rgb(216 140 60 / 11%), transparent 80%);
  }

  summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }

  summary::after {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--color-copper);
    border-bottom: 1px solid var(--color-copper);
    transform: rotate(45deg);
  }

  details[open] summary::after {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  ol {
    margin: 0;
    padding: 0.75rem 1.1rem 0.85rem;
    list-style: none;
  }

  li + li {
    margin-top: 0.35rem;
  }

  li[data-depth='3'] {
    padding-left: 0.8rem;
  }

  li[data-depth='4'] {
    padding-left: 1.6rem;
  }

  a {
    display: block;
    border-left: 2px solid transparent;
    border-radius: 2px;
    padding-left: 0.65rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  a:hover,
  a:focus-visible {
    border-left-color: var(--color-link);
    color: var(--color-link);
    background: rgb(0 221 235 / 7%);
  }

  a[aria-current='location'] {
    border-left-color: var(--color-accent);
    color: var(--color-heading);
    background: var(--color-accent-soft);
    box-shadow: inset 0 1px 0 rgb(255 210 0 / 10%);
  }

  .toc-desktop {
    display: none;
  }

  @media (min-width: 1280px) {
    .toc-desktop {
      display: block;
    }

    .toc-mobile {
      display: none;
    }
  }
</style>
