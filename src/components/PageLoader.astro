---
---
<div id="page-loader" aria-hidden="true" transition:persist="page-loader"></div>

<style is:global>
  /* 隐藏态：display:none，不占位不拦截事件 */
  #page-loader { display: none; }

  /* 显示态 */
  #page-loader.pl-visible {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: #17151d;
    opacity: 1;
    transition: opacity 0.5s cubic-bezier(.4, 0, .2, 1);
  }
  :root[data-theme='light'] #page-loader.pl-visible { background: #f0ece4; }

  /* 淡出态 */
  #page-loader.pl-visible.pl-done {
    opacity: 0;
    pointer-events: none;
  }

  /* 圆弧容器 */
  #page-loader .pl-ring-wrap {
    position: relative;
    width: min(220px, 52vw);
    height: min(220px, 52vw);
    flex-shrink: 0;
  }

  #page-loader .pl-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    transform: rotate(-90deg);
  }

  #page-loader .pl-track {
    fill: none;
    stroke: #f3bb6218;
    stroke-width: 8;
  }
  :root[data-theme='light'] #page-loader .pl-track { stroke: #75522618; }

  #page-loader .pl-arc {
    fill: none;
    stroke-linecap: round;
  }
  #page-loader .pl-arc--halo {
    stroke: #f3bb6266;
    stroke-width: 20;
    filter: blur(8px);
    opacity: 0.7;
  }
  :root[data-theme='light'] #page-loader .pl-arc--halo { stroke: #75522666; }

  #page-loader .pl-arc--tube {
    stroke: #f3bb62;
    stroke-width: 10;
    filter: blur(2px) drop-shadow(0 0 6px #f3bb62bb) drop-shadow(0 0 14px #f3bb6244);
    opacity: 0.88;
  }
  :root[data-theme='light'] #page-loader .pl-arc--tube {
    stroke: #755226;
    filter: blur(2px) drop-shadow(0 0 6px #755226bb) drop-shadow(0 0 14px #75522644);
  }

  #page-loader .pl-arc--body {
    stroke: #f3bb62;
    stroke-width: 7;
    filter: drop-shadow(0 0 3px #f3bb62cc) drop-shadow(0 0 8px #f3bb6244);
  }
  :root[data-theme='light'] #page-loader .pl-arc--body {
    stroke: #755226;
    filter: drop-shadow(0 0 3px #755226cc) drop-shadow(0 0 8px #75522644);
  }

  /* 百分比，绝对居中 */
  #page-loader .pl-pct {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'IBM Plex Mono', monospace;
    font-variant-numeric: tabular-nums;
    color: #f5f0e8;
    filter: drop-shadow(0 0 6px #f3bb6266);
    pointer-events: none;
  }
  :root[data-theme='light'] #page-loader .pl-pct { color: #322d38; filter: drop-shadow(0 0 6px #75522666); }

  #page-loader .pl-pct-num {
    font-size: clamp(22px, 5vw, 30px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* LOADING 文字 */
  #page-loader .pl-label {
    position: relative;
    display: grid;
    place-items: center;
  }

  #page-loader .pl-text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(18px, 3.8vw, 26px);
    font-weight: 400;
    letter-spacing: 0.12em;
    grid-area: 1 / 1;
    animation: pl-pulse 2.4s ease-in-out infinite;
  }
  #page-loader .pl-text--halo {
    color: transparent;
    -webkit-text-stroke: 5px #f3bb6255;
    filter: blur(7px) drop-shadow(0 0 18px #f3bb6244);
    opacity: 0.85;
    animation-delay: 0s;
  }
  #page-loader .pl-text--tube {
    color: #f3bb62;
    -webkit-text-stroke: 1px #f3bb6299;
    filter: blur(0.3px) drop-shadow(0 0 8px #f3bb6294);
    animation-delay: -0.35s;
  }
  #page-loader .pl-text--core {
    color: #f5f0e8;
    filter: drop-shadow(0 0 3px #f5f0e86a);
    animation-delay: -0.6s;
  }

  :root[data-theme='light'] #page-loader .pl-text--halo {
    color: transparent;
    -webkit-text-stroke-color: #75522655;
    filter: blur(7px) drop-shadow(0 0 18px #75522444);
  }
  :root[data-theme='light'] #page-loader .pl-text--tube {
    color: #755226;
    -webkit-text-stroke-color: #75522699;
    filter: blur(0.3px) drop-shadow(0 0 8px #75522694);
  }
  :root[data-theme='light'] #page-loader .pl-text--core { color: #322d38; }

  @keyframes pl-pulse {
    0%, 100% { opacity: 0.88; }
    50%       { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #page-loader .pl-text { animation: none; }
    #page-loader.pl-visible { transition-duration: 0.1s; }
  }
</style>