---
---
<div id="page-loader" aria-hidden="true" transition:persist="page-loader">
  <div class="pl-ring-wrap">
    <svg class="pl-svg" viewBox="0 0 200 200" aria-hidden="true">
      <circle class="pl-track" cx="100" cy="100" r="80"></circle>
      <circle class="pl-arc pl-arc--halo" cx="100" cy="100" r="80" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"></circle>
      <circle class="pl-arc pl-arc--tube" cx="100" cy="100" r="80" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"></circle>
      <circle class="pl-arc pl-arc--body" cx="100" cy="100" r="80" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"></circle>
    </svg>
    <div class="pl-pct" aria-hidden="true">
      <span class="pl-pct-num">0%</span>
    </div>
  </div>
  <div class="pl-label" aria-label="加载中">
    <span class="pl-text pl-text--halo" aria-hidden="true">LOADING</span>
    <span class="pl-text pl-text--tube" aria-hidden="true">LOADING</span>
    <span class="pl-text pl-text--core" aria-hidden="true">LOADING</span>
  </div>
</div>

<style is:global>
  /* 隐藏态：display:none，不占位不拦截事件 */
  #page-loader { display: none; }

  /* 显示态 */
  #page-loader.pl-visible,
  :root[data-initial-page-loader='visible'] #page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: #17151d;
    opacity: 1;
  }

  /* 淡出态 */
  #page-loader.pl-visible.pl-done {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(.4, 0, .2, 1);
  }

  /* 圆弧容器 */
  #page-loader .pl-ring-wrap {
    position: relative;
    width: min(220px, 52vw);
    height: min(220px, 52vw);
    flex-shrink: 0;
  }

  #page-loader .pl-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    transform: rotate(-90deg);
  }

  #page-loader .pl-track {
    fill: none;
    stroke: #ffd20018;
    stroke-width: 8;
  }

  #page-loader .pl-arc {
    fill: none;
    stroke-linecap: round;
  }
  #page-loader .pl-arc--halo {
    stroke: #ffd20066;
    stroke-width: 20;
    filter: blur(8px);
    opacity: 0.7;
  }

  #page-loader .pl-arc--tube {
    stroke: #ffd200;
    stroke-width: 10;
    filter: blur(2px) drop-shadow(0 0 6px #ffd200bb) drop-shadow(0 0 14px #ffd20044);
    opacity: 0.88;
  }

  #page-loader .pl-arc--body {
    stroke: #ffd200;
    stroke-width: 7;
    filter: drop-shadow(0 0 3px #ffd200cc) drop-shadow(0 0 8px #ffd20044);
  }

  /* 百分比，绝对居中 */
  #page-loader .pl-pct {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'IBM Plex Mono', monospace;
    font-variant-numeric: tabular-nums;
    color: #f5f0e8;
    filter: drop-shadow(0 0 6px #ffd20066);
    pointer-events: none;
  }

  #page-loader .pl-pct-num {
    font-size: clamp(22px, 5vw, 30px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* LOADING 文字 */
  #page-loader .pl-label {
    position: relative;
    display: grid;
    place-items: center;
  }

  #page-loader .pl-text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(18px, 3.8vw, 26px);
    font-weight: 400;
    letter-spacing: 0.12em;
    grid-area: 1 / 1;
    animation: pl-pulse 2.4s ease-in-out infinite;
  }
  #page-loader .pl-text--halo {
    color: transparent;
    -webkit-text-stroke: 5px #ffd20055;
    filter: blur(7px) drop-shadow(0 0 18px #ffd20044);
    opacity: 0.85;
    animation-delay: 0s;
  }
  #page-loader .pl-text--tube {
    color: #ffd200;
    -webkit-text-stroke: 1px #ffd20099;
    filter: blur(0.3px) drop-shadow(0 0 8px #ffd20094);
    animation-delay: -0.35s;
  }
  #page-loader .pl-text--core {
    color: #f5f0e8;
    filter: drop-shadow(0 0 3px #f5f0e86a);
    animation-delay: -0.6s;
  }

  @keyframes pl-pulse {
    0%, 100% { opacity: 0.88; }
    50%       { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #page-loader .pl-text { animation: none; }
    #page-loader.pl-visible,
    :root[data-initial-page-loader='visible'] #page-loader { transition-duration: 0.1s; }
  }

  #page-loader.pl-visible.pl-transition {
    display: block;
    overflow: hidden;
    background: transparent;
  }

  #page-loader .pl-shutter-leaf {
    position: absolute;
    inset: 0;
    background: #17151d url('/assets/transitions/mecha-shutter-v1.webp') center / cover no-repeat;
    will-change: transform;
  }

  #page-loader .pl-shutter-leaf--left {
    clip-path: inset(0 50% 0 0);
    transform: translateX(-50%);
  }

  #page-loader .pl-shutter-leaf--right {
    clip-path: inset(0 0 0 50%);
    transform: translateX(50%);
  }

  #page-loader.pl-visible.pl-transition.pl-done {
    opacity: 1;
    pointer-events: auto;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #page-loader.pl-transition.pl-closed .pl-shutter-leaf { transform: translateX(0); }
    #page-loader.pl-transition.pl-done .pl-shutter-leaf--left { transform: translateX(-50%); }
    #page-loader.pl-transition.pl-done .pl-shutter-leaf--right { transform: translateX(50%); }
  }
</style>
