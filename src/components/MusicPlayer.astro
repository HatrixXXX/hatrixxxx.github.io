---
import { playlist } from '@/data/playlist';
const isEmpty = playlist.length === 0;
const current = playlist[0];
---
<aside class="music-player" aria-label="音乐播放器" data-music-player data-empty={String(isEmpty)} transition:persist="music-player">
  <div class="player-main">
    <div class="track-copy"><strong data-player-title>{isEmpty ? '歌单待添加' : current?.title}</strong><span data-player-artist>{isEmpty ? '' : current?.artist}</span></div>
    <div class="player-controls" aria-label="播放控制">
      <button type="button" aria-label="上一首" data-player-prev disabled={isEmpty}>⏮</button>
      <button type="button" aria-label="播放" data-player-play disabled={isEmpty}>▶</button>
      <button type="button" aria-label="下一首" data-player-next disabled={isEmpty}>⏭</button>
      <button type="button" class="mode-button" aria-label="播放模式：列表循环" data-player-mode data-mode="list" disabled={isEmpty}>
        <svg data-mode-icon="shuffle" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h2c3 0 4 10 8 10h6M16 5h4v4M20 15v4h-4M4 17h2c1.5 0 2.5-1.4 3.4-3" /></svg>
        <svg data-mode-icon="list" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h9a4 4 0 0 1 4 4v1m-3-3 3 3 3-3M17 19H8a4 4 0 0 1-4-4v-1m3 3-3-3-3 3" /></svg>
        <svg data-mode-icon="single" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h11a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Zm7 3v8m-2-6 2-2 2 2" /></svg>
      </button>
    </div>
    <label class="volume-control"><span class="volume-label">音量</span><input type="range" min="0" max="1" step="0.02" value="0.7" aria-label="音量" data-player-volume /></label>
  </div>
  <div class="turntable" aria-hidden="true"><div class="turntable-platter"><div class="turntable-record" data-turntable-record></div></div><div class="turntable-tonearm"><div class="turntable-cartridge"></div></div><i class="turntable-light" data-player-light></i></div>
</aside>
<style>
.music-player{--record-size:126px;--arm-angle:19deg;position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,1fr) 140px;gap:.7rem;align-items:center;width:100%;box-sizing:border-box;overflow:visible;border:1px solid var(--color-line);border-radius:var(--radius-card);padding:1rem 1.1rem;background:linear-gradient(135deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 80%,#000));color:var(--color-text);box-shadow:var(--shadow-panel),0 22px 30px rgb(0 0 0 / 18%)}
.player-main{min-width:0;display:grid;gap:.8rem;align-content:center}.track-copy{min-width:0;display:flex;flex-direction:column}.track-copy strong,.track-copy span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.track-copy strong{font-size:.85rem}.track-copy span,.volume-control span{color:var(--color-muted);font-size:.7rem}.player-controls{display:flex;gap:.45rem;align-items:center;min-height:96px}.player-controls button{width:34px;height:34px;padding:0;border:0;border-radius:50%;background:#26132b;color:#fff;box-shadow:inset 0 1px rgb(255 255 255 / 12%),0 5px 10px #0005;font-size:.9rem}.player-controls button[data-player-play]{width:48px;height:38px;border-radius:22px;background:#9ebbd2;color:#34203a;font-size:1rem}.player-controls button:disabled{opacity:.45}.mode-button{display:grid!important;place-items:center;margin-left:.1rem;background:transparent!important;box-shadow:none!important;border:1px solid var(--color-line)!important}.mode-button svg{display:none;width:19px;height:19px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.mode-button[data-mode='shuffle'] [data-mode-icon='shuffle'],.mode-button[data-mode='list'] [data-mode-icon='list'],.mode-button[data-mode='single'] [data-mode-icon='single']{display:block}.volume-control{position:relative;display:grid;place-items:center;width:44px;height:96px;margin-left:.15rem;border-left:1px solid var(--color-line);padding-left:.45rem}.volume-label{position:absolute;top:3px;color:var(--color-muted);font-size:.52rem;writing-mode:vertical-rl}.volume-control input{width:84px;height:18px;accent-color:var(--color-accent);writing-mode:vertical-lr;direction:rtl;transform:rotate(180deg);cursor:ns-resize}.volume-control input::-webkit-slider-runnable-track{width:4px;background:linear-gradient(180deg,var(--color-line),var(--color-accent));border-radius:99px}.volume-control input::-webkit-slider-thumb{cursor:ns-resize}.turntable{position:absolute;right:-64px;top:50%;width:140px;height:140px;transform:translate3d(0,-50%,0);filter:drop-shadow(10px 16px 12px rgb(0 0 0 / 28%));pointer-events:none}.turntable-platter{position:absolute;inset:5px;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle,#555 0 58%,#292929 59% 72%,#111 73%);box-shadow:inset 0 0 0 6px #333,0 5px 14px #0008}.turntable-record{width:var(--record-size);height:var(--record-size);border-radius:50%;background:repeating-radial-gradient(circle,#171717 0 2px,#2b2b2b 2px 3px);box-shadow:inset 0 0 0 18px #111,inset 0 0 20px #000}.turntable-record::after{content:"";display:block;width:28%;height:28%;margin:36%;border-radius:50%;background:var(--color-accent);box-shadow:0 0 0 5px #111,0 0 14px #ff8fa666}.turntable-tonearm{position:absolute;width:82px;height:7px;top:3px;right:0;border-radius:99px;background:linear-gradient(#d9d9d9,#626262);transform-origin:right center;transform:rotate(var(--arm-angle));transition:transform .3s ease;box-shadow:0 2px 3px #0008}.turntable-cartridge{position:absolute;left:-6px;top:-4px;width:14px;height:14px;border-radius:3px;background:#444;box-shadow:0 2px 3px #000}.turntable-light{position:absolute;right:3px;bottom:7px;width:8px;height:8px;border-radius:50%;background:#888}.music-player[data-playback-state='playing'] .turntable-record{animation:record-spin 2.2s linear infinite}.music-player[data-playback-state='playing'] .turntable-tonearm{--arm-angle:32deg}.music-player[data-playback-state='playing'] .turntable-light{background:#70d98a;box-shadow:0 0 9px #70d98a}@keyframes record-spin{to{transform:rotate(360deg)}}
@media(max-width:600px){.music-player{grid-template-columns:1fr;position:relative;width:100%;padding-right:1rem}.turntable{position:absolute;right:-1rem;top:-70px;transform:scale(.75);transform-origin:right bottom}.player-main{padding-right:3.5rem}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}}
</style>





