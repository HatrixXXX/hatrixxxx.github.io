---
import { playlist } from '@/data/playlist';

interface Props {
  mode?: 'home' | 'dock';
}

const { mode = 'dock' } = Astro.props;
const isEmpty = playlist.length === 0;
const currentTrack = playlist[0];
---

<aside
  class="music-player"
  aria-label="音乐播放器"
  data-music-player
  data-empty={String(isEmpty)}
  data-display-mode={mode}
  data-layout-state={mode === 'home' ? 'pending' : 'ready'}
  data-ui-state={mode === 'home' ? 'expanded' : 'collapsed'}
  data-playback-state="paused"
  transition:persist="music-player"
>
  <button
    class="player-toggle"
    type="button"
    data-player-toggle
    aria-label="展开音乐播放器"
    aria-expanded="false"
    aria-controls="music-player-inner"
  ></button>

  <div class="player-inner" id="music-player-inner" data-player-main inert={mode === 'dock'}>
    <div class="deck-stage">
      <svg class="machine-body" viewBox="0 0 376 289" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="deck-surface" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#38333d" />
            <stop offset=".56" stop-color="#292630" />
            <stop offset="1" stop-color="#1d1d27" />
          </linearGradient>
          <radialGradient id="pivot-metal">
            <stop offset="0" stop-color="#b9b5ae" />
            <stop offset=".45" stop-color="#666b6f" />
            <stop offset="1" stop-color="#14171b" />
          </radialGradient>
        </defs>

        <rect x="2" y="2" width="372" height="285" rx="10" fill="#10131b" stroke="#d88c3c" stroke-width="1.5" />
        <rect x="5" y="5" width="366" height="279" rx="8" fill="url(#deck-surface)" stroke="#625444" stroke-width="1" />
        <path d="M17 17h69M17 17v25" fill="none" stroke="#ffd200" stroke-opacity=".72" stroke-width="1.5" />
        <path d="M17 48v99M17 153v43M359 102v102" fill="none" stroke="#00ddeb" stroke-opacity=".22" stroke-width="1" />
        <circle cx="20" cy="25" r="2" fill="#6b5b48" stroke="#bba47b" stroke-width=".7" />
        <circle cx="356" cy="25" r="2" fill="#6b5b48" stroke="#bba47b" stroke-width=".7" />
        <circle cx="20" cy="265" r="2" fill="#6b5b48" stroke="#bba47b" stroke-width=".7" />
        <circle cx="356" cy="265" r="2" fill="#6b5b48" stroke="#bba47b" stroke-width=".7" />

        <circle cx="176" cy="139" r="129" fill="#0c0e12" stroke="#806744" stroke-width="2" />
        <circle cx="176" cy="139" r="126" fill="#24242a" stroke="#393c3f" stroke-width="2" />

        <rect x="307" y="27" width="58" height="72" rx="9" fill="#0e1116" stroke="#807058" stroke-width="1.5" />
        <rect x="313" y="33" width="46" height="60" rx="6" fill="#1a1c21" stroke="#30343a" stroke-width="1" />
        <circle cx="340" cy="53" r="21" fill="#0c0f13" stroke="#474b4c" stroke-width="2" />
        <circle cx="340" cy="53" r="13" fill="url(#pivot-metal)" />
        <circle cx="340" cy="53" r="4" fill="#161a1f" stroke="#c8bdab" stroke-width="1" />
        <path d="M313 85h46" stroke="#d88c3c" stroke-opacity=".55" stroke-width="1" />

        <path d="M273 251h82" stroke="#9c7c50" stroke-opacity=".55" stroke-width="1" />
        <text x="271" y="275" fill="#e8e0d1" font-family="Orbitron, Arial, sans-serif" font-size="19" font-weight="800" letter-spacing="2">HATRIX</text>
        <circle cx="345" cy="236" r="2.6" fill="#ffd200" />
      </svg>

      <div class="record-assembly">
        <div class="record-disc" data-turntable-record aria-hidden="true"></div>
        <button
          class="record-button"
          type="button"
          data-player-record
          aria-label={isEmpty ? '歌单待添加' : '播放唱片，双击随机下一曲'}
          aria-describedby="record-track record-help"
          aria-keyshortcuts="Shift+Enter"
          aria-pressed="false"
          disabled={isEmpty}
        ></button>
      </div>

      <svg class="tonearm" data-turntable-tonearm viewBox="0 0 140 220" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="arm-shaft" x1="0" x2="1">
            <stop offset="0" stop-color="#12161b" />
            <stop offset=".5" stop-color="#a1a5a3" />
            <stop offset="1" stop-color="#1c2025" />
          </linearGradient>
        </defs>
        <circle cx="110" cy="25" r="16" fill="#101318" stroke="#6c6660" stroke-width="2" />
        <circle cx="110" cy="25" r="8" fill="#30363b" stroke="#bdad8f" stroke-width="1.5" />
        <path d="M106 40 37 177" fill="none" stroke="#0a0c0f" stroke-width="14" stroke-linecap="round" />
        <path d="M106 40 37 177" fill="none" stroke="url(#arm-shaft)" stroke-width="8" stroke-linecap="round" />
        <path d="M103 43 34 174" fill="none" stroke="#d9d6ca" stroke-opacity=".28" stroke-width="1.5" stroke-linecap="round" />
        <path d="M97 57 105 61" stroke="#d88c3c" stroke-width="5" />
        <path d="m27 171 26 13-12 20-28-13Z" fill="#16191d" stroke="#6f6860" stroke-width="1.5" />
        <path d="m16 190 18 8-5 10-18-8Z" fill="#292d31" />
        <circle cx="31" cy="185" r="3" fill="#d88c3c" />
        <path d="m28 205-2 7" stroke="#b9b5ae" stroke-width="2" />
      </svg>

      <span class="track-tooltip" id="record-track" data-player-track aria-live="polite" aria-atomic="true">
        {currentTrack ? `${currentTrack.title}-${currentTrack.artist}` : '歌单待添加'}
      </span>
    </div>
    <span class="sr-only" id="record-help">单击播放或暂停，双击随机下一曲；键盘可按 Shift 加 Enter 切歌。</span>
  </div>
</aside>

<style>
  .music-player {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    overflow: visible;
    border: 1px solid var(--color-copper);
    border-radius: 10px;
    background: #211e29;
    box-shadow: 0 10px 24px #080a12a8;
    contain: layout;
    transition: transform 280ms cubic-bezier(.2, .8, .2, 1), border-color 180ms, box-shadow 180ms;
  }
  .music-player[data-display-mode='home'] { position: absolute; width: 376px; height: 289px; }
  .music-player[data-display-mode='dock'] {
    position: fixed;
    z-index: 90;
    left: 0;
    bottom: 28px;
    width: 330px;
    height: 254px;
  }
  .music-player[data-layout-state='pending'] {
    visibility: hidden;
    transition: none;
  }
  .player-inner, .deck-stage { position: relative; width: 100%; height: 100%; }
  .machine-body { position: absolute; inset: 0; width: 100%; height: 100%; }

  .record-assembly {
    position: absolute;
    z-index: 2;
    left: 13.03%;
    top: 4.15%;
    width: 67.55%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #0b0d10;
    box-shadow: 0 0 0 2px #524b42, 0 5px 10px #05070aa6, inset 0 0 0 3px #1a1c20;
    transition: transform 280ms cubic-bezier(.2, .8, .2, 1);
  }
  .record-disc {
    position: absolute;
    inset: 1.6%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #121417 0 1px, #292b2f 1px 2px, #15171a 2px 4px);
    box-shadow: inset 0 0 0 2px #303136, inset 0 0 20px 4px #050608;
  }
  .record-disc::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 18deg, transparent 0 10%, #d7e4e414 15%, transparent 25% 40%, #fff4da1c 46%, transparent 54% 71%, #d7e4e413 78%, transparent 85%);
  }
  .record-disc::after {
    content: '';
    position: absolute;
    inset: 34%;
    border-radius: 50%;
    background: radial-gradient(circle, #7f8585 0 3%, #11161c 4% 6%, #c3a776 7% 9%, var(--record-label, #3b3540) 10% 66%, var(--record-label-edge, #524858) 100%);
    box-shadow: 0 0 0 2px #121519, inset 0 0 0 2px #a57c46;
  }
  .music-player[data-record-variant='1'] { --record-label: #344650; --record-label-edge: #566671; }
  .music-player[data-record-variant='2'] { --record-label: #4b3934; --record-label-edge: #735247; }
  .music-player[data-playback-state='playing'] .record-disc,
  .music-player[data-playback-state='buffering'] .record-disc { animation: record-spin 1.8s linear infinite; }
  @keyframes record-spin { to { transform: rotate(360deg); } }
  .music-player[data-record-swap='true'] .record-assembly {
    animation: record-exchange 560ms cubic-bezier(.4, 0, .2, 1) 160ms both;
  }
  @keyframes record-exchange {
    0% { opacity: 1; transform: none; }
    45% { opacity: 0; transform: translate(-24%, -8%) rotate(-10deg) scale(.88); }
    49% { opacity: 0; transform: translate(-27%, -9%) rotate(-12deg) scale(.86); }
    50% { opacity: 0; transform: translate(27%, -9%) rotate(12deg) scale(.86); }
    100% { opacity: 1; transform: none; }
  }

  .record-button {
    position: absolute;
    z-index: 3;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: var(--cursor-link, pointer);
    touch-action: manipulation;
  }
  .record-button:active { box-shadow: inset 0 0 0 5px #ffd20055; }
  .record-button:focus-visible { outline: 4px solid #ffd200; outline-offset: 3px; }
  .record-button:disabled { cursor: not-allowed; }
  .music-player[data-empty='true'] .record-disc { filter: saturate(.4) brightness(.75); }

  .tonearm {
    position: absolute;
    z-index: 4;
    left: 61.17%;
    top: 9.69%;
    width: 37.23%;
    height: 76.12%;
    overflow: visible;
    pointer-events: none;
    transform-origin: 78.57% 11.36%;
    transform: rotate(-24deg);
    transition: transform 660ms cubic-bezier(.2, .7, .18, 1);
    filter: drop-shadow(2px 3px 2px #080a0d9c);
  }
  .music-player[data-playback-state='playing'] .tonearm,
  .music-player[data-playback-state='buffering'] .tonearm { transform: rotate(0); }
  .music-player[data-playback-state='changing'] .tonearm { transition-duration: 180ms; }

  .track-tooltip {
    position: absolute;
    z-index: 6;
    top: 0;
    left: 47%;
    max-width: 72%;
    overflow: hidden;
    padding: 6px 12px;
    border: 1px solid #d88c3c;
    border-radius: 3px;
    background: #201e24f2;
    box-shadow: 0 5px 14px #090b12b0;
    color: #f5f0e8;
    font-size: 12px;
    line-height: 1.2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 9px);
    transition: opacity 160ms ease, transform 220ms cubic-bezier(.2, .8, .2, 1), visibility 0s linear 220ms;
  }
  .music-player:not([data-record-swap='true']) .record-assembly:hover ~ .track-tooltip,
  .music-player[data-playback-state='buffering'] .track-tooltip,
  .music-player[data-input-mode='keyboard']:not([data-record-swap='true']) .record-assembly:has(.record-button:focus-visible) ~ .track-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -10px);
    transition: opacity 160ms ease, transform 220ms cubic-bezier(.2, .8, .2, 1), visibility 0s;
  }

  .player-toggle { display: none; }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] {
    transform: translateX(calc(-100% + 80px));
    overflow: hidden;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .machine-body,
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .tonearm,
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .track-tooltip { visibility: hidden; }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .record-assembly {
    transform: translateX(65%);
    filter: drop-shadow(2px 5px 7px #080a0daa);
  }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .player-toggle {
    position: absolute;
    z-index: 5;
    top: 0;
    right: 0;
    display: block;
    width: 80px;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: var(--cursor-link, pointer);
  }
  .player-toggle:focus-visible { outline: 4px solid #ffd200; outline-offset: -5px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 400px) {
    .music-player[data-display-mode='dock'] { bottom: 20px; width: min(330px, calc(100vw - 12px)); height: auto; aspect-ratio: 376 / 289; }
  }
  @media (prefers-reduced-motion: reduce) {
    .music-player, .music-player *, .music-player *::before, .music-player *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
