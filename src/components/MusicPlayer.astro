---
import { playlist } from '@/data/playlist';

interface Props {
  mode?: 'home' | 'dock';
}

const { mode = 'dock' } = Astro.props;
const isEmpty = playlist.length === 0;
const currentTrack = playlist[0];
const cover = currentTrack?.cover;
---

<aside
  class="music-player"
  aria-label="音乐播放器"
  data-music-player
  data-empty={String(isEmpty)}
  data-display-mode={mode}
  data-ui-state={mode === 'home' ? 'expanded' : 'collapsed'}
  transition:persist="music-player"
>
  <button
    class="player-toggle"
    type="button"
    data-player-toggle
    aria-label="展开音乐播放器"
    aria-expanded="false"
    aria-controls="music-player-controls"
  ></button>

  <div class="player-main" id="music-player-controls" data-player-main inert={mode === 'dock'}>
    <div class="player-heading">
      <span>音乐播放器</span>
      <button class="player-collapse" type="button" data-player-collapse aria-label="收起音乐播放器">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
      </button>
    </div>
    <div class="track-copy" aria-live="polite" aria-atomic="true">
      <strong data-player-title title={currentTrack?.title}>
        {currentTrack?.title ?? '歌单待添加'}
      </strong>
      <span data-player-artist title={currentTrack?.artist}>{currentTrack?.artist ?? ''}</span>
    </div>

    <div class="player-controls" aria-label="播放控制">
      <div class="control-item">
        <button type="button" aria-label="上一曲" data-player-prev disabled={isEmpty}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 5v14M18 6 9 12l9 6V6Z" />
          </svg>
        </button>
        <span>上一曲</span>
      </div>

      <div class="control-item">
        <button
          type="button"
          class="play-button"
          aria-label="播放"
          aria-pressed="false"
          data-player-play
          disabled={isEmpty}
        >
          <svg data-play-icon viewBox="0 0 24 24" aria-hidden="true">
            <path d="m8 5 11 7-11 7V5Z" />
          </svg>
          <svg data-pause-icon viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14M16 5v14" />
          </svg>
        </button>
        <span>播放/暂停</span>
      </div>

      <div class="control-item">
        <button type="button" aria-label="下一曲" data-player-next disabled={isEmpty}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 5v14M6 6l9 6-9 6V6Z" />
          </svg>
        </button>
        <span>下一曲</span>
      </div>

      <div class="control-item volume-item">
        <label class="volume-control">
          <span class="visually-hidden">音量调节</span>
          <input
            type="range"
            min="0"
            max="1"
            step="0.02"
            value="0.7"
            aria-label="音量调节"
            data-player-volume
            disabled={isEmpty}
          />
        </label>
        <span>音量调节</span>
      </div>
    </div>

    <div class="progress-row">
      <span class="progress-time" data-player-current-time>0:00</span>
      <input
        class="progress-slider"
        type="range"
        min="0"
        max="0"
        step="0.1"
        value="0"
        aria-label="播放进度"
        data-player-progress
        disabled={isEmpty}
      />
      <span class="progress-time" data-player-duration>0:00</span>
    </div>
  </div>

  <figure class="turntable" aria-hidden="true">
    <div class="turntable-platter">
      <div
        class="turntable-record"
        data-turntable-record
        style={cover ? `--record-cover: url(${cover})` : undefined}
      ></div>
    </div>

    <div class="turntable-tonearm" data-turntable-tonearm>
      <span class="tonearm-cap"></span>
      <span class="tonearm-pivot" data-turntable-pivot></span>
      <span class="tonearm-post" data-turntable-post></span>
      <span class="tonearm-arm"></span>
      <span class="tonearm-head"></span>
    </div>

    <figcaption class="turntable-caption">唱片机</figcaption>
  </figure>
</aside>

<style>
  .music-player {
    --record-size: 118px;
    --player-ink: #e6eff0;
    --player-muted: #aac1c5;
    --player-accent: #72bdc6;
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
    padding: 19px 18px 16px;
    border: 1px solid #a4c4cc50;
    border-radius: 0;
    background: #172a31;
    color: var(--player-ink);
    isolation: isolate;
  }

  .music-player[data-display-mode='dock'] {
    position: fixed;
    z-index: 90;
    left: 0;
    bottom: 28px;
    width: 330px;
    height: 196px;
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), background-color 180ms ease, border-color 180ms ease;
  }

  .player-main {
    position: relative;
    z-index: 2;
    width: calc(100% - 123px);
    height: 100%;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .player-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 19px;
    margin-bottom: 10px;
    color: var(--player-muted);
    font-size: 11px;
    letter-spacing: .09em;
  }

  .track-copy { display: grid; gap: 3px; min-width: 0; }
  .track-copy strong, .track-copy span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .track-copy strong { color: var(--player-ink); font-size: 19px; line-height: 1.25; }
  .track-copy span { color: var(--player-muted); font-size: 12px; line-height: 1.4; }
  .player-controls { display: flex; align-items: center; gap: 8px; min-width: 0; margin-top: auto; }
  .control-item { display: flex; align-items: center; min-width: 0; }
  .control-item > span { display: none; }

  .player-controls button, .player-collapse {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 29px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--player-ink);
    cursor: pointer;
  }

  .player-controls button:hover:not(:disabled), .player-collapse:hover { color: var(--player-accent); }
  .player-controls button:focus-visible, .player-toggle:focus-visible,
  .player-collapse:focus-visible, input:focus-visible {
    outline: 2px solid var(--player-accent);
    outline-offset: 3px;
  }
  .player-controls button svg, .player-collapse svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
  .player-controls .play-button { width: 35px; height: 35px; background: var(--player-accent); color: #12242c; }
  .player-controls .play-button:hover:not(:disabled) { background: #a0d4db; color: #12242c; }
  .play-button [data-pause-icon], .music-player[data-playback-state='playing'] .play-button [data-play-icon] { display: none; }
  .music-player[data-playback-state='playing'] .play-button [data-pause-icon] { display: block; }
  .player-controls button:disabled, input:disabled { opacity: .4; cursor: not-allowed; }
  .volume-item { flex: 1; min-width: 25px; }
  .volume-control { display: flex; align-items: center; width: 100%; height: 32px; }

  input[type='range'] {
    appearance: none;
    width: 100%;
    min-width: 0;
    height: 3px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #6c8b945c;
    accent-color: var(--player-accent);
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track { height: 3px; background: transparent; }
  input[type='range']::-moz-range-track { height: 3px; border: 0; background: transparent; }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 8px;
    height: 11px;
    margin-top: -4px;
    border: 0;
    border-radius: 0;
    background: var(--player-ink);
  }
  input[type='range']::-moz-range-thumb { width: 8px; height: 11px; border: 0; border-radius: 0; background: var(--player-ink); }
  .progress-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 7px; margin-top: 12px; color: var(--player-muted); font-size: 10px; font-variant-numeric: tabular-nums; }
  .progress-time { white-space: nowrap; }
  input.progress-slider { background: linear-gradient(90deg, var(--player-accent) var(--played, 0%), #6c8b945c var(--played, 0%)); }

  .turntable {
    position: absolute;
    z-index: 1;
    right: 12px;
    top: 50%;
    width: var(--record-size);
    height: var(--record-size);
    margin: 0;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .turntable-platter { position: absolute; inset: 0; border-radius: 50%; background: #0e171c; border: 2px solid #49616a; }
  .turntable-record {
    position: absolute;
    inset: 5px;
    border: 5px solid #101d24;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #11222a 0 2px, #22343c 2px 3px);
  }
  .turntable-record::after {
    content: '';
    position: absolute;
    inset: 31%;
    border: 6px solid #193440;
    border-radius: 50%;
    background: var(--record-cover, #72a5af);
    background-size: cover;
    background-position: center;
  }
  .turntable-tonearm { position: absolute; inset: -5px 0; }
  .tonearm-cap { position: absolute; right: 0; top: 0; width: 11px; height: 11px; border-radius: 50%; background: #a1b8bd; }
  .tonearm-pivot { position: absolute; right: 3px; top: 3px; width: 5px; height: 5px; border-radius: 50%; background: #243a43; }
  .tonearm-post { position: absolute; right: 4px; top: 9px; width: 3px; height: 55px; background: #91a6ac; transform: rotate(16deg); transform-origin: top; }
  .tonearm-arm { position: absolute; right: 12px; top: 61px; width: 3px; height: 24px; background: #91a6ac; transform: rotate(43deg); transform-origin: top; }
  .tonearm-head { position: absolute; right: 27px; top: 76px; width: 7px; height: 12px; background: #c9d7d9; transform: rotate(43deg); }
  .turntable-caption { position: absolute; top: calc(100% + 10px); width: 100%; color: var(--player-muted); text-align: center; font-size: 10px; letter-spacing: .15em; }
  .music-player[data-playback-state='playing'] .turntable-record { animation: record-spin 5s linear infinite; }
  @keyframes record-spin { to { transform: rotate(360deg); } }

  .player-toggle { position: absolute; z-index: 4; right: 12px; top: 50%; width: var(--record-size); height: var(--record-size); transform: translateY(-50%); padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .player-collapse { width: 20px; height: 19px; }
  .music-player[data-display-mode='home'] .player-toggle,
  .music-player[data-display-mode='home'] .player-collapse { display: none; }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] { transform: translateX(calc(-100% + 71px)); border-color: transparent; background: transparent; }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .player-main,
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .turntable-tonearm,
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .turntable-caption { visibility: hidden; }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .turntable { filter: drop-shadow(3px 5px 8px #0006); }
  .music-player[data-display-mode='dock'][data-ui-state='collapsed'] .player-toggle { clip-path: inset(0 0 0 50%); }

  @media (max-width: 400px) { .music-player[data-display-mode='dock'] { bottom: 20px; } }
  @media (prefers-reduced-motion: reduce) {
    .music-player, .music-player *, .music-player *::before, .music-player *::after { animation: none !important; transition: none !important; }
  }
</style>
