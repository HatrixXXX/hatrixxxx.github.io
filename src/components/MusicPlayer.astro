---
import { playlist } from '@/data/playlist';

const isEmpty = playlist.length === 0;
---

<aside
  class="music-player"
  aria-label="音乐播放器"
  data-music-player
  data-empty={String(isEmpty)}
  transition:persist="music-player"
>
  <div class="track-copy">
    <strong>{isEmpty ? '歌单待添加' : playlist[0]?.title}</strong>
    <span>{isEmpty ? '播放器已就绪' : playlist[0]?.artist}</span>
  </div>
  <div class="player-controls" aria-label="播放控制">
    <button type="button" aria-label="上一首" disabled={isEmpty}>‹</button>
    <button type="button" aria-label="播放" disabled={isEmpty}>▶</button>
    <button type="button" aria-label="下一首" disabled={isEmpty}>›</button>
  </div>
  <label class="volume-control">
    <span>音量</span>
    <input type="range" min="0" max="1" step="0.05" value="0.7" data-player-volume />
  </label>
  <div class="player-progress">
    <progress aria-label="播放进度" aria-valuenow="0" value="0" max="1">0%</progress>
    <span>0:00 / 0:00</span>
  </div>
</aside>

<style>
  .music-player {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1rem 1.1rem;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-panel);
  }

  .track-copy,
  .volume-control {
    display: flex;
  }

  .track-copy {
    min-width: 0;
    flex-direction: column;
  }

  .track-copy strong,
  .track-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track-copy strong {
    font-size: 0.85rem;
  }

  .track-copy span,
  .volume-control span {
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .player-controls {
    display: flex;
    justify-content: center;
    gap: 0.3rem;
  }

  button {
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .volume-control {
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
  }

  .player-progress {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .player-progress progress {
    height: 4px;
    min-width: 0;
    flex: 1;
    accent-color: var(--color-accent);
  }

  .player-progress span {
    color: var(--color-muted);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  input {
    width: 76px;
    accent-color: var(--color-accent);
  }

</style>
