---
import { playlist } from '@/data/playlist';
const isEmpty = playlist.length === 0;
const isContentPage = Astro.url.pathname.startsWith('/posts/');
const current = playlist[0];
---
<aside class="music-player" aria-label="音乐播放器" data-music-player data-empty={String(isEmpty)} data-content-page={isContentPage ? 'true' : undefined} transition:persist="music-player">
  <div class="player-main"><div class="track-copy"><strong data-player-title>{isEmpty ? '歌单待添加' : current?.title}</strong><span data-player-artist>{isEmpty ? '播放器已就绪' : current?.artist}</span></div><div class="player-controls" aria-label="播放控制"><button type="button" aria-label="上一首" data-player-prev disabled={isEmpty}>⏮</button><button type="button" aria-label="播放" data-player-play disabled={isEmpty}>▶</button><button type="button" aria-label="下一首" data-player-next disabled={isEmpty}>⏭</button><button type="button" aria-label="播放模式：顺序播放" data-player-mode disabled={isEmpty}>顺序</button></div><div class="player-progress"><input type="range" min="0" max="1" step="0.001" value="0" aria-label="播放进度" data-player-progress disabled={isEmpty} /><span data-player-time>0:00 / 0:00</span></div><label class="volume-control"><span>音量</span><input type="range" min="0" max="1" step="0.05" value="0.7" aria-label="音量" data-player-volume /></label></div>
  <div class="turntable" aria-hidden="true"><div class="turntable-platter"><div class="turntable-record" data-turntable-record></div></div><div class="turntable-tonearm"><div class="turntable-cartridge"></div></div><i class="turntable-light" data-player-light></i></div>
  {isContentPage && <button class="player-fold" type="button" aria-label="折叠音乐播放器" aria-expanded="true" data-player-fold>收起</button>}
</aside>
<style>
.music-player{--record-size:108px;--arm-angle:19deg;position:relative;display:grid;grid-template-columns:minmax(0,1fr) 120px;gap:.75rem;align-items:center;width:100%;box-sizing:border-box;overflow:visible;border:1px solid var(--color-line);border-radius:var(--radius-card);padding:1rem 1.1rem;background:var(--color-surface);color:var(--color-text);box-shadow:var(--shadow-panel);transition:transform .28s ease,opacity .2s ease}.player-main{min-width:0;display:grid;gap:.65rem}.track-copy{min-width:0;display:flex;flex-direction:column}.track-copy strong,.track-copy span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.track-copy strong{font-size:.85rem}.track-copy span,.volume-control span,.player-progress span{color:var(--color-muted);font-size:.7rem}.player-controls{display:flex;gap:.3rem;align-items:center}button{border:1px solid var(--color-line);border-radius:999px;background:var(--color-surface-raised);color:var(--color-text);cursor:pointer}.player-controls button{width:30px;height:30px;padding:0}.player-controls [data-player-mode]{width:auto;padding:0 .55rem;font-size:.65rem}button:disabled{cursor:not-allowed;opacity:.45}button:focus-visible,input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}.volume-control{display:flex;align-items:center;gap:.45rem}input{accent-color:var(--color-accent);min-width:0}.volume-control input{width:76px}.player-progress{display:flex;align-items:center;gap:.65rem}.player-progress input{width:100%}.player-progress span{white-space:nowrap}.turntable{position:relative;width:120px;height:120px;transform:translate3d(18px,-8px,0)}.turntable-platter{position:absolute;inset:6px;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle,#444 0 58%,#222 59% 72%,#111 73%);box-shadow:inset 0 0 0 5px #333,0 5px 14px #0006}.turntable-record{width:var(--record-size);height:var(--record-size);border-radius:50%;background:repeating-radial-gradient(circle,#171717 0 2px,#252525 2px 3px);box-shadow:inset 0 0 0 17px #111,inset 0 0 18px #000}.turntable-record::after{content:"";display:block;width:28%;height:28%;margin:36%;border-radius:50%;background:var(--color-accent);box-shadow:0 0 0 5px #111}.turntable-tonearm{position:absolute;width:72px;height:6px;top:4px;right:2px;border-radius:99px;background:#888;transform-origin:right center;transform:rotate(var(--arm-angle));transition:transform .3s ease}.turntable-cartridge{position:absolute;left:-5px;top:-3px;width:12px;height:12px;border-radius:2px;background:#555}.turntable-light{position:absolute;right:5px;bottom:8px;width:7px;height:7px;border-radius:50%;background:#888}[data-playback-state=playing] .turntable-record{animation:record-spin 2.2s linear infinite}[data-playback-state=playing] .turntable-tonearm{--arm-angle:32deg}[data-playback-state=playing] .turntable-light{background:#70d98a;box-shadow:0 0 8px #70d98a}[data-ui-state=collapsed]{transform:translateX(calc(-100% - 1rem));opacity:.15}.player-fold{position:absolute;right:-1.8rem;top:1rem;padding:.5rem .35rem;writing-mode:vertical-rl;border-radius:0 .5rem .5rem 0}@keyframes record-spin{to{transform:rotate(360deg)}}@media(max-width:600px){.music-player{grid-template-columns:1fr;position:fixed;z-index:30;left:0;right:0;bottom:0;width:auto;border-radius:1rem 1rem 0 0;transform:none}.turntable{position:absolute;right:.25rem;top:-72px;transform:scale(.8)}[data-ui-state=collapsed]{transform:translateY(calc(100% - 2.5rem));opacity:1}.player-fold{right:.75rem;top:-2.2rem;writing-mode:horizontal-tb;border-radius:.5rem .5rem 0 0}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}}
</style>
