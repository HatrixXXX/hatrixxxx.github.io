---
import MusicPlayer from '@/components/MusicPlayer.astro';
import SiteStats from '@/components/SiteStats.astro';
import type { PostEntry } from '@/lib/content';
import { buildSiteStats } from '@/lib/site-stats';

interface Props {
  posts: readonly PostEntry[];
  showClock: boolean;
  showStats?: boolean;
}

const { posts, showClock, showStats = true } = Astro.props;
---

<aside class="sidebar-stack" data-sidebar-stack data-content-page={Astro.url.pathname.startsWith('/posts/') ? 'true' : undefined} aria-label="站点侧栏">
  <slot />
  {showStats && <SiteStats stats={buildSiteStats(posts)} showClock={showClock} />}
  <MusicPlayer />
</aside>

<style>
  .sidebar-stack {
    position: relative;
    z-index: 16;
    display: grid;
    width: min(100%, 280px);
    min-width: 0;
    gap: 1rem;
    justify-self: center;
  }

  @media (min-width: 1280px) and (min-height: 900px) {
    .sidebar-stack {
      position: sticky;
      top: 1.5rem;
    }
  }
</style>
