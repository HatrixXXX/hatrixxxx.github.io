---
import { SITE } from '@/config/site';
import darkThemeCss from '@/styles/giscus-dark.css?raw';
import darkThemePath from '@/styles/giscus-dark.css?url';

interface Props {
  title?: string;
}

const { repo, repoId, category, categoryId, mapping } = SITE.giscus;
const { title = '评论' } = Astro.props;
const darkTheme = import.meta.env.DEV
  ? `data:text/css;charset=utf-8,${encodeURIComponent(darkThemeCss)}`
  : new URL(darkThemePath, SITE.url).href;
---

<section
  class="comments"
  aria-label={title}
  data-giscus-comments
  data-giscus-repo={repo}
  data-giscus-repo-id={repoId}
  data-giscus-category={category}
  data-giscus-category-id={categoryId}
  data-giscus-mapping={mapping}
  data-giscus-dark-theme={darkTheme}
>
  <p class="comments-status" data-giscus-status>评论正在加载…</p>
  <noscript>评论需要 JavaScript。</noscript>
</section>

<style>
  .comments {
    margin-top: 2.5rem;
  }

  .comments-status,
  noscript {
    color: var(--color-muted);
    font-size: 0.88rem;
  }
</style>