---
import { Image } from 'astro:assets';
import readingTime from 'reading-time';
import type { PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const href = postPath(post.data.legacySlug);
const minutes = Math.max(1, Math.ceil(readingTime(post.body ?? '').minutes));
const published = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(post.data.pubDate);
---

<article data-post-card class="post-card">
  <a class="post-card-media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={post.data.cover || '/images/default-cover.svg'}
      alt=""
      width={720}
      height={480}
      layout="constrained"
      widths={[360, 540, 720]}
      loading="lazy"
      decoding="async"
      data-decorative-motion
    />
  </a>
  <div class="post-card-content">
    <h2><a href={href}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{published}</time>
      <span aria-label={`预计阅读 ${minutes} 分钟`}>{minutes} 分钟</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex: 0 0 clamp(17rem, 27vw, 22rem);
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
    scroll-snap-align: start;
  }

  .post-card-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-raised);
    user-select: none;
    -webkit-user-drag: none;
  }

  .post-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
    -webkit-user-drag: none;
  }

  .post-card:hover .post-card-media :global(img) {
    transform: scale(1.035);
  }

  .post-card-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.35rem;
  }

  h2 {
    margin: 0;
    color: var(--color-heading, #fff);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  p {
    display: -webkit-box;
    margin: 0.85rem 0 0;
    overflow: hidden;
    color: var(--color-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: auto;
    padding-top: 1.15rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  @media (max-width: 768px) {
    .post-card {
      flex-basis: min(84vw, 21rem);
    }

    .post-card-content {
      padding: 1.25rem;
    }
  }
</style>
