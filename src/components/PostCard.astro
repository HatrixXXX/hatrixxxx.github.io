---
import { Image } from 'astro:assets';
import readingTime from 'reading-time';
import LockIndicator from '@/components/LockIndicator.astro';
import type { PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Props {
  post: PostEntry;
  index?: number;
  total?: number;
}

const { post, index = 0, total = 1 } = Astro.props;
const href = postPath(post.data.legacySlug);
const isAboveFold = index < 2;
const minutes = Math.max(1, Math.ceil(readingTime(post.body ?? '').minutes));
const published = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(post.data.pubDate);
const position = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
const coverProps = post.data.cover && !post.data.cover.startsWith('/')
  ? { inferSize: true as const }
  : { width: 1600, height: 900 };
---

<article data-post-card class="post-card">
  <div class="post-card-media" aria-hidden="true">
    <Image
      src={post.data.cover || '/assets/blog-cards/default-cover.webp'}
      alt=""
      {...coverProps}
      layout="constrained"
      widths={[480, 768, 1024, 1280, 1440]}
      quality={90}
      loading={isAboveFold ? "eager" : "lazy"}
      decoding={isAboveFold ? "sync" : "async"}
      fetchpriority={isAboveFold ? "high" : "auto"}
      data-decorative-motion
    />
  </div>
  <div class="post-card-content">
    <div class="post-card-header">
      <span class="post-card-position" aria-label={`第 ${index + 1} 篇，共 ${total} 篇`}>{position}</span>
      <time datetime={post.data.pubDate.toISOString()}>{published}</time>
    </div>
    <div class="post-card-body">
      <h2>
        <a href={href} data-locked-link={post.data.locked ? '' : undefined}>
          {post.data.title}{post.data.locked && <LockIndicator />}
        </a>
      </h2>
      <p class="post-card-excerpt">{post.data.summary}</p>
    </div>
    <div class="post-card-footer">
      <span aria-label={`预计阅读 ${minutes} 分钟`}>{minutes} 分钟</span>
      <svg class="post-card-terminal" width="72" height="20" viewBox="0 0 72 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M1 16h35l7-7h16M17 4h42M43 9V4" stroke="var(--color-copper)" stroke-width="1.25" />
        <path d="M1 12h20M1 8h12" stroke="var(--color-copper)" stroke-width="1.25" opacity=".55" />
        <rect x="63" y="6" width="7" height="7" fill="var(--color-link)" stroke="var(--color-copper)" />
      </svg>
    </div>
  </div>
  <span class="post-card-clamp post-card-clamp--left" aria-hidden="true"></span>
  <span class="post-card-clamp post-card-clamp--right" aria-hidden="true"></span>
</article>

<style>
  /* PostList owns outer dimensions and the vertical coverflow transforms. */
  .post-card {
    position: relative;
    width: 100%;
    height: 100%;
    isolation: isolate;
    backface-visibility: hidden;
  }

  .post-card::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: url('/assets/blog-cards/desktop-frame.webp') center 45% / 100% auto no-repeat;
    content: '';
    pointer-events: none;
  }

  .post-card:nth-child(even)::before {
    transform: scaleX(-1);
  }

  .post-card::after {
    position: absolute;
    z-index: 2;
    top: 18%;
    bottom: 22%;
    left: 41.4%;
    width: 3px;
    background: linear-gradient(180deg, transparent, rgb(255 210 0 / 80%) 48%, transparent);
    content: '';
    opacity: calc(var(--center-proximity, 0) * .7);
    pointer-events: none;
  }

  .post-card:nth-child(even)::after {
    right: 41.4%;
    left: auto;
  }

  .post-card-clamp {
    position: absolute;
    z-index: 3;
    top: 50%;
    width: clamp(56px, 7.2%, 80px);
    aspect-ratio: 971 / 798;
    background: url('/assets/blog-cards/locking-clamp.webp') center / contain no-repeat;
    filter: drop-shadow(0 5px 8px rgb(0 0 0 / 60%));
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, transform 280ms var(--ease-out);
  }

  .post-card-clamp--left {
    left: -12px;
    transform: translate(-18px, -50%);
  }

  .post-card-clamp--right {
    right: -12px;
    transform: translate(18px, -50%) scaleX(-1);
  }

  .post-card[data-active='true'] .post-card-clamp--left {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .post-card[data-active='true'] .post-card-clamp--right {
    opacity: 1;
    transform: translate(0, -50%) scaleX(-1);
  }

  .post-card[data-active='true']::after {
    animation: card-dock-light 460ms var(--ease-out);
  }

  @keyframes card-dock-light {
    from { opacity: 0; filter: brightness(1); }
    55% { opacity: 1; filter: brightness(1.6); }
    to { opacity: .7; filter: brightness(1); }
  }

  .post-card-media {
    position: absolute;
    z-index: 1;
    top: 10.5%;
    bottom: 20.5%;
    left: 6.5%;
    display: block;
    width: 31.5%;
    overflow: hidden;
    clip-path: polygon(3% 0, 97% 0, 100% 6%, 100% 94%, 97% 100%, 3% 100%, 0 94%, 0 6%);
    background: var(--color-inset);
    user-select: none;
    -webkit-user-drag: none;
  }

  .post-card:nth-child(even) .post-card-media {
    right: 6.5%;
    left: auto;
  }

  .post-card-media::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgb(3 5 9 / 14%), transparent 25% 75%, rgb(3 5 9 / 36%));
    box-shadow: inset 0 0 14px rgb(0 0 0 / 68%);
    content: '';
    pointer-events: none;
  }

  .post-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    -webkit-user-drag: none;
  }

  .post-card-content {
    position: absolute;
    z-index: 1;
    inset: 10.5% 6.1% 20.5% 45.6%;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.8rem 1.4rem;
    gap: 0.35rem;
    overflow: hidden;
  }

  .post-card:nth-child(even) .post-card-content {
    right: 45.6%;
    left: 6.1%;
  }

  .post-card-header,
  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .post-card-header {
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgb(216 140 60 / 28%);
  }

  .post-card-position {
    color: var(--color-copper);
    font-family: var(--font-data);
    letter-spacing: 0.06em;
  }

  .post-card-body {
    display: grid;
    gap: 0.35rem;
    margin-block: auto;
  }

  h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-excerpt {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
  }

  h2 a:hover {
    color: var(--color-link);
  }

  h2 a:focus-visible {
    color: var(--color-link);
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }

  .post-card-footer {
    padding-top: 0.3rem;
    border-top: 1px solid rgb(216 140 60 / 28%);
  }

  .post-card-terminal {
    width: 72px;
    height: 20px;
    flex: none;
  }

  @media (min-width: 1051px) and (max-width: 1100px) {
    .post-card-content {
      padding-block: 0.7rem;
    }
  }

  @media (max-width: 1050px) and (min-width: 721px) {
    .post-card-content {
      padding: 0.2rem 0.9rem;
      gap: 0;
    }

    .post-card-header,
    .post-card-footer {
      line-height: 1.3;
    }

    .post-card-header {
      padding-bottom: 0.15rem;
    }

    .post-card-footer {
      padding-top: 0.15rem;
    }

    h2 {
      font-size: clamp(1.05rem, 2vw, 1.4rem);
    }

    .post-card-excerpt {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 720px) {
    .post-card-clamp {
      display: none;
    }

    .post-card::before {
      background-image: url('/assets/blog-cards/mobile-frame.webp');
      background-position: center;
      background-size: 100% 100%;
    }

    .post-card:nth-child(even)::before {
      transform: none;
    }

    .post-card::after,
    .post-card:nth-child(even)::after {
      top: 48.4%;
      right: 36%;
      bottom: auto;
      left: 36%;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgb(255 210 0 / 80%) 50%, transparent);
    }

    .post-card-media,
    .post-card:nth-child(even) .post-card-media {
      top: 10.5%;
      right: auto;
      bottom: auto;
      left: 11.8%;
      width: 76.4%;
      height: 34.5%;
    }

    .post-card-content,
    .post-card:nth-child(even) .post-card-content {
      inset: 52% 11.8% 14.4%;
      padding: 0.45rem 1.1rem;
      gap: 0;
    }

    .post-card-header,
    .post-card-footer {
      line-height: 1.25;
    }

    .post-card-header {
      padding-bottom: 0.15rem;
    }

    .post-card-footer {
      padding-top: 0.15rem;
    }

    h2 {
      font-size: clamp(1.05rem, 4.5vw, 1.4rem);
      -webkit-line-clamp: 2;
    }

    .post-card-terminal {
      width: 48px;
      height: auto;
    }

    .post-card-excerpt {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card[data-active='true']::after {
      animation: none;
    }

    .post-card-clamp {
      transition: none;
    }
  }
</style>
