---
import { Image } from 'astro:assets';
import readingTime from 'reading-time';
import LockIndicator from '@/components/LockIndicator.astro';
import type { PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Props {
  post: PostEntry;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const href = postPath(post.data.legacySlug);
const isAboveFold = index < 4;
const minutes = Math.max(1, Math.ceil(readingTime(post.body ?? '').minutes));
const published = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(post.data.pubDate);
---

<article data-post-card class="post-card">
  <a
    class="post-card-media"
    href={href}
    tabindex="-1"
    aria-hidden="true"
    data-locked-link={post.data.locked ? '' : undefined}
  >
    <Image
      src={post.data.cover || '/images/default-cover.svg'}
      alt=""
      width={480}
      height={270}
      layout="constrained"
      widths={[240, 360, 480]}
      loading={isAboveFold ? "eager" : "lazy"}
      decoding={isAboveFold ? "sync" : "async"}
      fetchpriority={isAboveFold ? "high" : "auto"}
      data-decorative-motion
    />
  </a>
  <div class="post-card-content">
    <div class="post-type-tag">{post.data.type}</div>
    <h2>
      <a href={href} data-locked-link={post.data.locked ? '' : undefined}>
        {post.data.title}{post.data.locked && <LockIndicator />}
      </a>
    </h2>
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{published}</time>
      <span aria-label={`预计阅读 ${minutes} 分钟`}>{minutes} 分钟</span>
    </div>
  </div>
</article>

<style>
  /* PostCard is sized by its parent (.coverflow-scene via data-post-card selector).
     Width and height are fully controlled by PostList.astro / coverflow JS.
     We only define internal layout here. */

  .post-card {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset), var(--shadow-panel);
    transition: border-color var(--duration-fast) var(--ease-out);
    backface-visibility: hidden;
  }

  .post-card[data-active='true'],
  .post-card:focus-within {
    border-color: var(--color-line-strong);
  }

  /* Cover image: fixed height at top of card (roughly 40% of card height) */
  .post-card-media {
    display: block;
    flex: 0 0 42%;
    overflow: hidden;
    background: var(--color-surface-raised);
    box-shadow: inset 0 -1px var(--color-line);
    user-select: none;
    -webkit-user-drag: none;
  }

  .post-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-normal) var(--ease-out);
    -webkit-user-drag: none;
  }

  .post-card[data-active='true'] .post-card-media :global(img),
  .post-card:hover .post-card-media :global(img) {
    transform: scale(1.03);
  }

  .post-card-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.1rem 1.25rem 1.25rem;
    gap: 0.5rem;
  }

  .post-type-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-copper, #b87333);
    text-transform: uppercase;
    opacity: 0.85;
  }

  h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-link);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card:hover .post-card-media :global(img),
    .post-card[data-active='true'] .post-card-media :global(img) {
      transform: none;
    }
  }
</style>
