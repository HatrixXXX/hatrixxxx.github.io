---
import { Image } from 'astro:assets';
import readingTime from 'reading-time';
import type { PostEntry } from '@/lib/content';
import { categoryPath, postPath } from '@/lib/urls';

interface Props {
  post: PostEntry;
  index: number;
}

const { post, index } = Astro.props;
const side = index % 2 === 0 ? 'left' : 'right';
const href = postPath(post.data.legacySlug);
const minutes = Math.max(1, Math.ceil(readingTime(post.body ?? '').minutes));
const published = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(post.data.pubDate);
---

<article data-post-card data-side={side} class="post-card">
  <a class="post-card-media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={post.data.cover || '/images/default-cover.svg'}
      alt=""
      width={720}
      height={480}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="post-card-content">
    <a class="post-category" href={categoryPath(post.data.category)}>{post.data.category}</a>
    <h2><a href={href}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{published}</time>
      <span aria-label={`预计阅读 ${minutes} 分钟`}>{minutes} 分钟</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
  }

  .post-card[data-side='right'] {
    grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
  }

  .post-card[data-side='right'] .post-card-media {
    order: 2;
  }

  .post-card-media {
    display: block;
    min-height: 260px;
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .post-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
  }

  .post-card:hover .post-card-media :global(img) {
    transform: scale(1.035);
  }

  .post-card-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }

  .post-category {
    align-self: flex-start;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0.55rem 0 0;
    color: #fff;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  p {
    display: -webkit-box;
    margin: 0.85rem 0 0;
    overflow: hidden;
    color: var(--color-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 1.15rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  @media (max-width: 768px) {
    .post-card,
    .post-card[data-side='right'] {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-card[data-side='right'] .post-card-media {
      order: 0;
    }

    .post-card-media {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .post-card-content {
      padding: 1.25rem;
    }
  }
</style>
