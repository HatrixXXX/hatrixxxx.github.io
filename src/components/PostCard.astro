---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';
import { DEFAULT_ARTICLE_COVER } from '@/config/article-images';
import type { PostEntry } from '@/lib/content';
import { sanctuaryPath } from '@/lib/sanctuary';
import { postPath } from '@/lib/urls';

type Props = ({ post: PostEntry; sanctuary?: never } | { sanctuary: CollectionEntry<'sanctuary'>; post?: never }) & {
  index?: number;
  total?: number;
};

const { post, sanctuary, index = 0, total = 1 } = Astro.props;
const href = post ? postPath(post.data.legacySlug) : sanctuaryPath(sanctuary!.id);
const title = post?.data.title ?? sanctuary!.data.title;
const summary = post?.data.summary ?? sanctuary!.data.summary;
const pubDate = post?.data.pubDate ?? sanctuary!.data.pubDate;
const body = post ? post.body : sanctuary!.body;
const cover = post?.data.cover ?? sanctuary?.data.cover;
const isAboveFold = index < 2;
const minutes = Math.max(1, Math.ceil(readingTime(body ?? '').minutes));
const published = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(pubDate);
const position = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
const coverProps = cover?.startsWith('/')
  ? { width: 1600, height: 900 }
  : { width: 768, height: 404 };
---

<article data-post-card class="post-card">
  <div class="post-card-media" aria-hidden="true">
    <Image
      src={cover || DEFAULT_ARTICLE_COVER}
      alt=""
      {...coverProps}
      layout="constrained"
      widths={[320, 480, 640, 768]}
      sizes="(max-width: 720px) 275px, (max-width: 1050px) 320px, 353px"
      quality={75}
      loading={isAboveFold ? "eager" : "lazy"}
      decoding={isAboveFold ? "sync" : "async"}
      fetchpriority={isAboveFold ? "high" : "auto"}
      data-decorative-motion
    />
  </div>
  <div class="post-card-content">
    <div class="post-card-header">
      <span class="post-card-position" aria-label={`第 ${index + 1} 篇，共 ${total} 篇`}>{position}</span>
      <time datetime={pubDate.toISOString()}>{published}</time>
    </div>
    <div class="post-card-body">
      <h2>
        <a href={href}>
          {title}
        </a>
      </h2>
      <p class="post-card-excerpt">{summary}</p>
    </div>
    <div class="post-card-footer">
      {sanctuary && !sanctuary.body?.trim() ? <span>正文待补充</span> : <span aria-label={`预计阅读 ${minutes} 分钟`}>{minutes} 分钟</span>}
      <svg class="post-card-terminal" width="72" height="20" viewBox="0 0 72 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M1 16h35l7-7h16M17 4h42M43 9V4" stroke="var(--color-copper)" stroke-width="1.25" />
        <path d="M1 12h20M1 8h12" stroke="var(--color-copper)" stroke-width="1.25" opacity=".55" />
        <rect x="63" y="6" width="7" height="7" fill="var(--color-link)" stroke="var(--color-copper)" />
      </svg>
    </div>
  </div>
  <span class="post-card-clamp post-card-clamp--left" aria-hidden="true"></span>
  <span class="post-card-clamp post-card-clamp--right" aria-hidden="true"></span>
</article>

<style>
  /* PostList owns outer dimensions and the vertical coverflow transforms. */
  .post-card {
    position: relative;
    width: 100%;
    height: 100%;
    isolation: isolate;
    backface-visibility: hidden;
  }

  .post-card::before {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: url('/assets/blog-cards/desktop-frame.webp') center 45% / 100% auto no-repeat;
    content: '';
    pointer-events: none;
  }

  .post-card:nth-child(even)::before {
    transform: scaleX(-1);
  }

  .post-card::after {
    position: absolute;
    z-index: 3;
    top: 18%;
    bottom: 22%;
    left: 41.4%;
    width: 3px;
    background: linear-gradient(180deg, transparent, rgb(255 210 0 / 80%) 48%, transparent);
    content: '';
    opacity: calc(var(--center-proximity, 0) * .7 + var(--dock-light, 0) * .3);
    filter: brightness(calc(1 + var(--dock-light, 0) * .6));
    pointer-events: none;
  }

  .post-card:nth-child(even)::after {
    right: 41.4%;
    left: auto;
  }

  .post-card-clamp {
    position: absolute;
    z-index: 4;
    top: 50%;
    width: clamp(56px, 7.2%, 80px);
    aspect-ratio: 971 / 798;
    background: url('/assets/blog-cards/locking-clamp.webp') center / contain no-repeat;
    filter: drop-shadow(0 5px 8px rgb(0 0 0 / 60%));
    opacity: .9;
    pointer-events: none;
    transition: opacity 120ms ease, filter 180ms var(--ease-out);
  }

  .post-card-clamp--left {
    left: 12px;
    transform: translate(-50%, -50%);
  }

  .post-card-clamp--right {
    right: 12px;
    transform: translate(50%, -50%) scaleX(-1);
  }

  .post-card[data-active='true'] .post-card-clamp {
    opacity: 1;
    filter: brightness(1.2) drop-shadow(0 5px 8px rgb(0 0 0 / 60%));
  }

  .post-card-media {
    position: absolute;
    z-index: 1;
    top: 10.5%;
    bottom: 20.5%;
    left: 6.5%;
    display: block;
    width: 31.5%;
    overflow: hidden;
    clip-path: polygon(3% 0, 97% 0, 100% 6%, 100% 94%, 97% 100%, 3% 100%, 0 94%, 0 6%);
    background: var(--color-inset);
    user-select: none;
    -webkit-user-drag: none;
  }

  .post-card:nth-child(even) .post-card-media {
    right: 6.5%;
    left: auto;
  }

  .post-card-media::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgb(3 5 9 / 14%), transparent 25% 75%, rgb(3 5 9 / 36%));
    box-shadow: inset 0 0 14px rgb(0 0 0 / 68%);
    content: '';
    pointer-events: none;
  }

  .post-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    -webkit-user-drag: none;
  }

  .post-card-content {
    --info-panel-bg: #1e3637ed;
    --info-panel-active: #1e3637f5;
    --info-panel-hover: #2c5656f5;
    --info-panel-accent: #57decc;
    --info-panel-signal: #87e1d5;
    position: absolute;
    z-index: 1;
    inset: 10.5% 5.4% 15.5% 44.1%;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.85rem 1.5rem;
    gap: 0.35rem;
    overflow: hidden;
    isolation: isolate;
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 9px 100%, 0 calc(100% - 9px));
    background:
      radial-gradient(circle at 84% 38%, rgb(87 222 204 / 14%), transparent 43%),
      linear-gradient(115deg, rgb(239 225 204 / 5%), transparent 55%),
      var(--info-panel-bg);
    box-shadow:
      inset 0 0 0 1px rgb(87 222 204 / 68%),
      inset 0 0 0 4px rgb(6 12 20 / 42%),
      inset 0 1px rgb(209 239 245 / 14%);
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }

  .post-card:nth-child(even) .post-card-content {
    right: 44.1%;
    left: 5.4%;
  }

  .post-card-content::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      linear-gradient(90deg, var(--info-panel-accent), var(--info-panel-accent)) 19px 11px / 104px 1px no-repeat,
      linear-gradient(90deg, var(--info-panel-signal), transparent) calc(100% - 96px) 11px / 77px 1px no-repeat,
      linear-gradient(180deg, transparent 0 49%, rgb(135 225 213 / 3.5%) 50%, transparent 51%) 0 0 / 100% 9px,
      linear-gradient(90deg, transparent, rgb(87 222 204 / 7%), transparent);
    content: '';
    opacity: .9;
    pointer-events: none;
  }

  .post-card-content::after {
    position: absolute;
    z-index: 0;
    right: 14px;
    bottom: 12px;
    width: 9px;
    height: 9px;
    border-right: 1px solid var(--info-panel-signal);
    border-bottom: 1px solid var(--info-panel-signal);
    content: '';
    opacity: .82;
    pointer-events: none;
  }

  .post-card-content > * {
    position: relative;
    z-index: 1;
  }

  .post-card[data-active='true'] .post-card-content {
    background:
      radial-gradient(circle at 84% 38%, rgb(87 222 204 / 18%), transparent 43%),
      linear-gradient(115deg, rgb(239 225 204 / 7%), transparent 55%),
      var(--info-panel-active);
    box-shadow:
      inset 0 0 0 1px rgb(135 225 213 / 84%),
      inset 0 0 0 4px rgb(6 12 20 / 42%),
      inset 0 1px rgb(209 239 245 / 19%);
  }

  @media (hover: hover) {
    .post-card[data-active='true']:hover .post-card-content {
      background-color: var(--info-panel-hover);
      box-shadow:
        inset 0 0 0 1px var(--info-panel-accent),
        inset 0 0 0 4px rgb(6 12 20 / 42%),
        inset 0 1px rgb(209 239 245 / 24%);
    }
  }

  .post-card-header,
  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .post-card-header {
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgb(87 222 204 / 42%);
  }

  .post-card-position {
    color: var(--info-panel-signal);
    font-family: var(--font-data);
    letter-spacing: 0.06em;
    text-shadow: 0 0 8px rgb(87 222 204 / 24%);
  }

  .post-card-header time { color: color-mix(in srgb, var(--info-panel-signal) 72%, white); }

  .post-card-body {
    display: grid;
    gap: 0.35rem;
    margin-block: auto;
  }

  h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 0 rgb(0 0 0 / 72%), 0 0 10px rgb(87 222 204 / 12%);
  }

  .post-card-excerpt {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--info-panel-signal) 42%, var(--color-text));
    font-size: 0.82rem;
    line-height: 1.5;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
  }

  h2 a:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }

  .post-card-footer {
    padding-top: 0.3rem;
    border-top: 1px solid rgb(87 222 204 / 36%);
    color: color-mix(in srgb, var(--info-panel-signal) 68%, var(--color-muted));
  }

  .post-card-terminal {
    width: 72px;
    height: 20px;
    flex: none;
  }

  @media (min-width: 1051px) and (max-width: 1100px) {
    .post-card-content {
      padding-block: 0.7rem;
    }
  }

  @media (max-width: 1050px) and (min-width: 721px) {
    .post-card-content {
      padding: 0.35rem 1rem;
      gap: 0;
    }

    .post-card-header,
    .post-card-footer {
      line-height: 1.3;
    }

    .post-card-header {
      padding-bottom: 0.15rem;
    }

    .post-card-footer {
      padding-top: 0.15rem;
    }

    h2 {
      font-size: clamp(1.05rem, 2vw, 1.4rem);
    }

    .post-card-excerpt {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 720px) {
    .post-card-clamp {
      width: clamp(30px, 10%, 38px);
    }

    .post-card::before {
      background-image: url('/assets/blog-cards/mobile-frame.webp');
      background-position: center;
      background-size: 100% 100%;
    }

    .post-card:nth-child(even)::before {
      transform: none;
    }

    .post-card::after,
    .post-card:nth-child(even)::after {
      top: 48.4%;
      right: 36%;
      bottom: auto;
      left: 36%;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgb(255 210 0 / 80%) 50%, transparent);
    }

    .post-card-media,
    .post-card:nth-child(even) .post-card-media {
      top: 10.5%;
      right: auto;
      bottom: auto;
      left: 11.8%;
      width: 76.4%;
      height: 34.5%;
    }

    .post-card-content,
    .post-card:nth-child(even) .post-card-content {
      inset: 52% 11.8% 10.5%;
      padding: 0.52rem 1.05rem;
      gap: 0;
    }

    .post-card-content::before {
      background:
        linear-gradient(90deg, var(--info-panel-accent), var(--info-panel-accent)) 14px 8px / 54px 1px no-repeat,
        linear-gradient(90deg, var(--info-panel-signal), transparent) calc(100% - 62px) 8px / 48px 1px no-repeat,
        linear-gradient(180deg, transparent 0 49%, rgb(135 225 213 / 3.5%) 50%, transparent 51%) 0 0 / 100% 8px;
    }

    .post-card-header,
    .post-card-footer {
      line-height: 1.25;
    }

    .post-card-header {
      padding-bottom: 0.15rem;
    }

    .post-card-footer {
      padding-top: 0.15rem;
    }

    h2 {
      font-size: clamp(1.05rem, 4.5vw, 1.4rem);
      -webkit-line-clamp: 2;
    }

    .post-card-terminal {
      width: 48px;
      height: auto;
    }

    .post-card-excerpt {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card-clamp {
      transition: none;
    }

    .post-card-content {
      transition: none;
    }
  }
</style>
