<div
  class="loading-overlay"
  data-loading-overlay
  data-loading-state="hidden"
  transition:persist="loading-overlay"
  role="status"
  aria-live="polite"
  aria-label="页面加载中"
>
  <svg class="loading-overlay__grid" data-loading-grid viewBox="0 0 1000 1000" aria-hidden="true">
    <defs>
      <polygon id="loading_hexagon" points="0,-50 43.3,-25 43.3,25 0,50 -43.3,25 -43.3,-25" fill="#171717" />
    </defs>
    {Array.from({ length: 15 }, (_, line) => (
      <g>
        {Array.from({ length: 15 }, (_, row) => (
          <use
            class="loading-overlay__block"
            href="#loading_hexagon"
            x={line % 2 ? 86.5 * row : 86.5 * row + 43.3}
            y={74.5 * line}
            transform-origin="50 50"
          />
        ))}
      </g>
    ))}
  </svg>
  <span class="loading-overlay__label" data-loading-status>LOADING</span>
</div>

<script>
  const overlay = document.querySelector<HTMLElement>('[data-loading-overlay]');
  if (overlay) {
    const blocks = Array.from(overlay.querySelectorAll<SVGUseElement>('.loading-overlay__block'));
    let animations: Animation[] = [];
    const stopAnimations = () => {
      animations.forEach((animation) => animation.cancel());
      animations = [];
    };
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveal = () => {
      stopAnimations();
      if (reducedMotion()) {
        blocks.forEach((block) => {
          block.style.strokeDashoffset = '0'; block.style.strokeOpacity = '1'; block.style.opacity = '1';
        });
        return;
      }
      const shuffled = [...blocks].sort(() => Math.random() - 0.5);
      const order = new Map(shuffled.map((block, index) => [block, index]));
      blocks.forEach((block) => {
        const offset = Math.random() > 0.5 ? -100 : 100;
        block.style.strokeDashoffset = String(offset); block.style.strokeOpacity = '0'; block.style.opacity = '1';
        animations.push(block.animate(
          [{ strokeDashoffset: offset, strokeOpacity: 0 }, { strokeDashoffset: 0, strokeOpacity: 1 }],
          { duration: 500, delay: (order.get(block) ?? 0) * 2, easing: 'cubic-bezier(0.76, 0, 0.24, 1)', fill: 'forwards' }
        ));
      });
    };
    const collapse = () => {
      stopAnimations();
      const centerOrder = new Map(
        blocks
          .map((block, index) => {
            const line = Math.floor(index / 15); const row = index % 15;
            return { block, distance: Math.hypot(row - 7, line - 7) };
          })
          .sort((a, b) => a.distance - b.distance)
          .map(({ block }, index) => [block, index])
      );
      blocks.forEach((block) => {
        block.style.strokeDashoffset = '0'; block.style.strokeOpacity = '1'; block.style.opacity = '1';
        if (reducedMotion()) { block.style.opacity = '0'; return; }
        animations.push(block.animate(
          [{ transform: 'scale(1)', opacity: 1 }, { transform: 'scale(0)', opacity: 0 }],
          { duration: 1000, delay: (centerOrder.get(block) ?? 0) * 4, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
        ));
      });
    };
    const observer = new MutationObserver(() => {
      if (overlay.dataset.loadingState === 'loading') reveal();
      if (overlay.dataset.loadingState === 'finishing') collapse();
      if (overlay.dataset.loadingState === 'hidden') stopAnimations();
    });
    observer.observe(overlay, { attributes: true, attributeFilter: ['data-loading-state'] });
  }
</script>

<style>
  .loading-overlay {
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background-color: #000;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  .loading-overlay[data-loading-state='hidden'] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .loading-overlay[data-loading-state='finishing'] {
    pointer-events: none;
  }

  .loading-overlay[data-loading-state='finishing'] .loading-overlay__block {
    stroke-dashoffset: 0;
    stroke-opacity: 1;
  }

  .loading-overlay__grid {
    position: absolute;
    width: 100%;
    height: auto;
  }

  .loading-overlay__block {
    stroke: #17f700;
    stroke-width: 0.8;
    stroke-opacity: 0;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform-box: fill-box;
  }

  .loading-overlay__label {
    position: relative;
    z-index: 1;
    color: #17f700;
    font: 700 16px/1 monospace;
    letter-spacing: 0.2em;
    text-shadow: 0 0 10px rgb(23 247 0 / 70%);
  }

  @keyframes loading-cell-out {
    to { opacity: 0; transform: scale(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-overlay { transition: none; }
  }
</style>
