<div
  class="loading-overlay"
  data-loading-overlay
  data-loading-state="hidden"
  transition:persist="loading-overlay"
  role="status"
  aria-live="polite"
  aria-label="页面加载中"
>
  <svg class="loading-overlay__grid" data-loading-grid viewBox="0 0 1000 1000" aria-hidden="true">
    <defs>
      <polygon id="loading_hexagon" points="0,-50 43.3,-25 43.3,25 0,50 -43.3,25 -43.3,-25" fill="#171717" />
    </defs>
    {Array.from({ length: 15 }, (_, line) => (
      <g data-loading-row={line}>
        {Array.from({ length: 15 }, (_, row) => (
          <use
            class="loading-overlay__block"
            href="#loading_hexagon"
            x={line % 2 ? 86.5 * row : 86.5 * row + 43.3}
            y={74.5 * line}
            data-loading-row-index={line}
            data-loading-column={row}
          />
        ))}
      </g>
    ))}
  </svg>
</div>

<script>
  const overlay = document.querySelector<HTMLElement>('[data-loading-overlay]');
  if (overlay) {
    const blocks = Array.from(overlay.querySelectorAll<SVGUseElement>('.loading-overlay__block'));
    let animations: Animation[] = [];
    let revealTimer: number | undefined;
    const stopAnimations = () => {
      if (revealTimer !== undefined) window.clearTimeout(revealTimer);
      revealTimer = undefined;
      animations.forEach((animation) => animation.cancel());
      animations = [];
    };
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ROW_GROUP_DELAY = 180;
    const BUILD_DURATION = 420;
    const SHRINK_DURATION = 420;
    const STAGGER_DURATION = 24;
    const ROW_ORDER = [
      [7],
      [6, 8],
      [5, 9],
      [4, 10],
      [3, 11],
      [2, 12],
      [1, 13],
      [0, 14]
    ];
    const reveal = () => {
      stopAnimations();
      if (reducedMotion()) {
        blocks.forEach((block) => {
          block.style.strokeDashoffset = '0'; block.style.strokeOpacity = '1'; block.style.opacity = '1';
        });
        return;
      }
      const rowOrder = new Map<number, number>();
      ROW_ORDER.forEach((rows, index) => rows.forEach((row) => rowOrder.set(row, index)));
      blocks.forEach((block, index) => {
        const row = Number(block.dataset.loadingRowIndex ?? Math.floor(index / 15));
        const column = Number(block.dataset.loadingColumn ?? index % 15);
        const offset = Math.random() > 0.5 ? -100 : 100;
        const groupIndex = rowOrder.get(row) ?? ROW_ORDER.length;
        const withinGroupIndex = column + (row % 2 ? 0.5 : 0);
        const delay = groupIndex * ROW_GROUP_DELAY + withinGroupIndex * STAGGER_DURATION;
        block.style.strokeDashoffset = String(offset);
        block.style.strokeOpacity = '0';
        block.style.opacity = '0';
        block.style.transform = 'scale(1)';
        animations.push(block.animate(
          [
            { strokeDashoffset: offset, strokeOpacity: 0, opacity: 0, transform: 'scale(1)' },
            { strokeDashoffset: 0, strokeOpacity: 1, opacity: 1, transform: 'scale(1)', offset: BUILD_DURATION / (BUILD_DURATION + SHRINK_DURATION) },
            { strokeDashoffset: 0, strokeOpacity: 1, opacity: 0, transform: 'scale(0)' }
          ],
          {
            duration: BUILD_DURATION + SHRINK_DURATION,
            delay,
            easing: 'cubic-bezier(0.76, 0, 0.24, 1)',
            fill: 'forwards'
          }
        ));
      });
    };
    const collapse = () => {
      if (reducedMotion()) {
        stopAnimations();
        blocks.forEach((block) => { block.style.opacity = '0'; });
      }
    };
    const startReveal = () => {
      if (overlay.dataset.loadingHomepage !== 'true') {
        reveal();
        return;
      }
      revealTimer = window.setTimeout(() => {
        revealTimer = undefined;
        if (overlay.dataset.loadingState === 'loading') reveal();
      }, 1000);
    };
    const observer = new MutationObserver(() => {
      if (overlay.dataset.loadingState === 'loading') startReveal();
      if (overlay.dataset.loadingState === 'finishing') collapse();
      if (overlay.dataset.loadingState === 'hidden') stopAnimations();
    });
    observer.observe(overlay, { attributes: true, attributeFilter: ['data-loading-state'] });
  }
</script>

<style>
  .loading-overlay {
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background-color: #000;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  .loading-overlay[data-loading-state='hidden'] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .loading-overlay[data-loading-state='finishing'] {
    pointer-events: none;
  }

  .loading-overlay[data-loading-state='finishing'] .loading-overlay__block {
    stroke-dashoffset: 0;
    stroke-opacity: 1;
  }

  .loading-overlay__grid {
    position: absolute;
    width: 100%;
    height: auto;
  }

  .loading-overlay__block {
    stroke: #17f700;
    stroke-width: 0.8;
    stroke-opacity: 0;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform-box: fill-box;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-overlay { transition: none; }
  }
</style>
