<div
  class="loading-overlay"
  data-loading-overlay
  data-loading-state="hidden"
  transition:persist="loading-overlay"
  role="status"
  aria-live="polite"
  aria-label="页面加载中"
>
  <div class="loading-overlay__backdrop"></div>
  <svg
    class="loading-overlay__grid"
    data-loading-grid
    viewBox="0 0 1298 1118"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <polygon
        id="loading-hexagon"
        points="0,-50 43.3,-25 43.3,25 0,50 -43.3,25 -43.3,-25"
        fill="#171717"
      />
    </defs>
    <g class="loading-overlay__cells">
      <!-- 15×15 hexagon grid -->
      {Array.from({ length: 225 }, (_, index) => {
        const row = Math.floor(index / 15);
        const column = index % 15;
        const x = column * 86.5 + (row % 2 ? 0 : 43.3);
        const y = row * 74.5;
        const distance = Math.abs(column - 7) + Math.abs(row - 7);
        const stagger = (index * 73) % 225;
        return <use href="#loading-hexagon" x={x} y={y} transform="translate(0 50)" style={`--cell-delay: ${stagger}; --cell-distance: ${distance}`} />;
      })}
    </g>
  </svg>
  <div class="loading-overlay__center" aria-hidden="true">
    <span class="loading-overlay__pulse"></span>
    <span class="loading-overlay__label" data-loading-status>LOADING</span>
    <span class="loading-overlay__line"></span>
  </div>
</div>

<style>
  .loading-overlay {
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-bg, #161a20);
    color: var(--color-accent, #ff8fa6);
    opacity: 1;
    pointer-events: auto;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  .loading-overlay[data-loading-state='hidden'] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .loading-overlay[data-loading-state='finishing'] {
    pointer-events: none;
  }

  .loading-overlay[data-loading-state='hidden'] .loading-overlay__cells use,
  .loading-overlay[data-loading-state='hidden'] .loading-overlay__pulse,
  .loading-overlay[data-loading-state='hidden'] .loading-overlay__line::after {
    animation-play-state: paused;
  }

  .loading-overlay[data-loading-state='finishing'] .loading-overlay__cells use {
    stroke-dashoffset: 0;
    stroke-opacity: 1;
    opacity: 0.95;
    animation: loading-cell-out 260ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--cell-distance) * 4ms);
  }

  .loading-overlay[data-loading-state='finishing'] .loading-overlay__center {
    animation: loading-center-out 260ms ease-out forwards;
  }

  .loading-overlay__backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, rgb(111 255 233 / 8%), transparent 36%),
      linear-gradient(135deg, rgb(255 143 166 / 5%), transparent 42%);
  }

  .loading-overlay__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  .loading-overlay__cells use {
    fill: #171717;
    stroke: #17f700;
    stroke-width: 0.8;
    stroke-opacity: 0;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgb(23 247 0 / 24%));
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: loading-cell-in 500ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
    animation-delay: calc(var(--cell-delay) * 2ms);
  }

  .loading-overlay__center {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.75rem;
    width: 180px;
    color: var(--color-text, #d8d9dc);
    font: 700 0.7rem/1 var(--font-mono, 'IBM Plex Mono', monospace);
    letter-spacing: 0.22em;
  }

  .loading-overlay__pulse {
    width: 10px;
    height: 10px;
    border: 1px solid var(--color-accent, #ff8fa6);
    box-shadow: 0 0 18px var(--color-accent, #ff8fa6);
    transform: rotate(30deg);
    animation: loading-pulse 1.3s ease-in-out infinite;
  }

  .loading-overlay__label {
    color: var(--color-accent, #ff8fa6);
    text-shadow: 0 0 14px rgb(255 143 166 / 55%);
  }

  .loading-overlay__line {
    width: 100%;
    height: 1px;
    overflow: hidden;
    background: var(--color-line, rgb(255 255 255 / 10%));
  }

  .loading-overlay__line::after {
    display: block;
    width: 35%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-accent, #ff8fa6), transparent);
    content: '';
    animation: loading-scan 1.1s ease-in-out infinite;
  }

  @keyframes loading-cell-in {
    to { stroke-dashoffset: 0; stroke-opacity: 1; opacity: 0.95; }
  }

  @keyframes loading-cell-out {
    to { opacity: 0; transform: translate(0 50) scale(0); }
  }

  @keyframes loading-center-out {
    to { opacity: 0; transform: scale(0.84); }
  }

  @keyframes loading-pulse {
    50% { transform: rotate(210deg) scale(1.35); opacity: 0.45; }
  }

  @keyframes loading-scan {
    from { transform: translateX(-290%); }
    to { transform: translateX(290%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-overlay,
    .loading-overlay__cells use,
    .loading-overlay__pulse,
    .loading-overlay__line::after {
      animation: none;
      transition: none;
    }

    .loading-overlay__cells use {
      stroke-dashoffset: 0;
      stroke-opacity: 1;
      opacity: 0.82;
    }

    .loading-overlay[data-loading-state='finishing'] .loading-overlay__cells use,
    .loading-overlay[data-loading-state='finishing'] .loading-overlay__center {
      animation: none;
      opacity: 0;
    }
  }
</style>
