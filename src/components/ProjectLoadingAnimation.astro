---
---

<section class="project-load-shell" aria-label="作品页加载动画" aria-live="polite">
  <div class="project-load-stage">
    <svg class="project-load-svg" viewBox="0 0 600 600" aria-hidden="true">
      <!-- 轨道底环 -->
      <circle class="project-load-track" cx="300" cy="300" r="230" />

      <!-- 光晕层（模糊宽弧，营造辉光感） -->
      <circle class="project-load-arc project-load-arc--halo" cx="300" cy="300" r="230" />

      <!-- 发光层（tube） -->
      <circle class="project-load-arc project-load-arc--tube" cx="300" cy="300" r="230" />

      <!-- 主体弧线 -->
      <circle class="project-load-arc project-load-arc--body" cx="300" cy="300" r="230" />

      <!-- LOADING 文字，三层辉光管效果 -->
      <text
        class="project-load-text project-load-text--halo"
        x="300" y="308"
        text-anchor="middle" dominant-baseline="middle"
        textLength="172" lengthAdjust="spacing"
      >LOADING</text>
      <text
        class="project-load-text project-load-text--tube"
        x="300" y="308"
        text-anchor="middle" dominant-baseline="middle"
        textLength="172" lengthAdjust="spacing"
      >LOADING</text>
      <text
        class="project-load-text project-load-text--core"
        x="300" y="308"
        text-anchor="middle" dominant-baseline="middle"
        textLength="172" lengthAdjust="spacing"
      >LOADING</text>
    </svg>
  </div>
</section>

<style>
  /*
   * 圆周 = 2π × 230 ≈ 1445.13
   * 弧长约占 28%：1445.13 × 0.28 ≈ 404.6
   * stroke-dasharray: <弧长> <空白>  →  404.6  1040.53
   * 旋转从 12 点位置（-90°）开始，整圈用 transform rotate 动画驱动
   */

  .project-load-shell {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-bg);
  }

  .project-load-stage {
    width: min(420px, 72vw);
    aspect-ratio: 1;
  }

  .project-load-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  /* ── 轨道底环 ─────────────────────────── */
  .project-load-track {
    fill: none;
    stroke: color-mix(in srgb, var(--color-accent) 13%, transparent);
    stroke-width: 14;
  }

  /* ── 弧线公共基础 ─────────────────────── */
  .project-load-arc {
    fill: none;
    stroke-linecap: round;
    /*
     * 弧段约 28% 圆周；其余为透明间隔
     * 注意：实际因 round cap 会略微延长，视觉上微调到约 26% 圆周
     */
    stroke-dasharray: 374 1071;
    /* 从 12 点位置（−90°）开始绕圈 */
    transform-origin: 300px 300px;
    animation: project-load-spin 3.4s linear infinite;
  }

  /* ── halo：宽模糊光晕 ─────────────────── */
  .project-load-arc--halo {
    stroke: color-mix(in srgb, var(--color-accent) 50%, transparent);
    stroke-width: 30;
    filter: blur(10px);
    opacity: 0.65;
  }

  /* ── tube：中层发光 ───────────────────── */
  .project-load-arc--tube {
    stroke: var(--color-accent);
    stroke-width: 18;
    filter:
      blur(2.5px)
      drop-shadow(0 0 7px color-mix(in srgb, var(--color-accent) 75%, transparent))
      drop-shadow(0 0 18px color-mix(in srgb, var(--color-accent) 30%, transparent));
    opacity: 0.9;
  }

  /* ── body：主体弧线 ───────────────────── */
  .project-load-arc--body {
    stroke: var(--color-accent);
    stroke-width: 14;
    filter:
      drop-shadow(0 0 3px color-mix(in srgb, var(--color-accent) 80%, transparent))
      drop-shadow(0 0 10px color-mix(in srgb, var(--color-accent) 35%, transparent));
  }

  @keyframes project-load-spin {
    from { transform: rotate(-90deg); }
    to   { transform: rotate(270deg); }
  }

  /* ── LOADING 文字 ─────────────────────── */
  .project-load-text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0;
    paint-order: stroke fill;
    animation: project-load-text-pulse 2.2s ease-in-out infinite;
  }

  .project-load-text--halo {
    fill: none;
    stroke: color-mix(in srgb, var(--color-accent) 60%, transparent);
    stroke-width: 8;
    opacity: 0.9;
    filter: blur(8px) drop-shadow(0 0 22px color-mix(in srgb, var(--color-accent) 32%, transparent));
    animation-delay: 0s;
  }

  .project-load-text--tube {
    fill: var(--color-accent);
    stroke: var(--color-accent);
    stroke-width: 1.8;
    filter: blur(0.35px) drop-shadow(0 0 10px color-mix(in srgb, var(--color-accent) 58%, transparent));
    animation-delay: -0.35s;
  }

  .project-load-text--core {
    fill: var(--color-heading);
    stroke: none;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-heading) 42%, transparent));
    animation-delay: -0.6s;
  }

  @keyframes project-load-text-pulse {
    0%, 100% { opacity: 0.92; }
    50%       { opacity: 1; }
  }

  /* ── 响应式 ───────────────────────────── */
  @media (max-width: 768px) {
    .project-load-stage {
      width: min(300px, 72vw);
    }

    .project-load-text {
      font-size: 26px;
    }

    .project-load-track  { stroke-width: 11; }
    .project-load-arc--halo { stroke-width: 22; }
    .project-load-arc--tube { stroke-width: 14; }
    .project-load-arc--body { stroke-width: 11; }

    .project-load-text--halo { stroke-width: 6; }
    .project-load-text--tube { stroke-width: 1.5; }
  }

  /* ── 减少动态效果 ─────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .project-load-arc { animation: none; }
    .project-load-text { animation: none; }

    /* 静止时显示一段固定弧，视觉上仍清晰 */
    .project-load-arc {
      transform: rotate(-90deg);
    }
  }
</style>
