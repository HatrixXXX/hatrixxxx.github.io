---
import PostCard from '@/components/PostCard.astro';
import type { PostEntry } from '@/lib/content';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<div
  class="coverflow-shell"
  aria-label="文章列表"
  aria-describedby="post-list-instructions"
  tabindex="0"
  data-post-coverflow
>
  <div class="coverflow-scene">
    {posts.map((post, index) => <PostCard post={post} index={index} total={posts.length} />)}
    <div class="coverflow-rails" aria-hidden="true">
      <img class="coverflow-rail coverflow-rail--left" src="/assets/blog-cards/guide-rail.webp" alt="" width="167" height="2160" loading="eager" decoding="async" />
      <img class="coverflow-rail coverflow-rail--right" src="/assets/blog-cards/guide-rail.webp" alt="" width="167" height="2160" loading="eager" decoding="async" />
    </div>
  </div>
</div>
<p id="post-list-instructions" class="post-list-instructions">
  滚动鼠标滚轮、上下滑动或使用上下方向键浏览文章，点击当前卡片进入文章，点击相邻卡片切换文章。
</p>

<script>
  import '@/scripts/post-coverflow';

  const syncBlogMotion = () => {
    document.querySelectorAll<HTMLElement>('[data-post-coverflow]').forEach((rail) => {
      rail.toggleAttribute('data-page-hidden', document.hidden);
    });
  };

  document.addEventListener('visibilitychange', syncBlogMotion);
  document.addEventListener('astro:page-load', syncBlogMotion);
  syncBlogMotion();
</script>

<style>
  /* Fill the viewport below the fixed navigation. */
  .coverflow-shell {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    overflow: visible;
    outline: none;
  }

  .coverflow-shell:focus-visible {
    outline: 2px solid var(--color-copper, #b87333);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .coverflow-scene {
    --card-w: min(1120px, calc(100vw - 7rem));
    --card-h: min(270px, calc(var(--card-w) * .245));
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .coverflow-rails {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .coverflow-rail {
    position: absolute;
    top: 50%;
    width: auto;
    height: calc(100% + 1rem);
    object-fit: contain;
    opacity: .84;
    filter: brightness(.8) drop-shadow(0 8px 14px rgb(0 0 0 / 55%));
    user-select: none;
  }

  .coverflow-rail--left {
    left: calc(50% - var(--card-w) / 2 + 12px);
    transform: translate(-50%, -50%);
  }

  .coverflow-rail--right {
    right: calc(50% - var(--card-w) / 2 + 12px);
    transform: translate(50%, -50%) scaleX(-1);
  }

  /* Horizontal cards keep their edges aligned with the straight guide rails. */
  .coverflow-scene :global([data-post-card]) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: center center;
    transform-style: flat;
    will-change: transform, opacity;
    width: var(--card-w);
    margin-left: calc(var(--card-w) / -2);
    height: var(--card-h);
    margin-top: calc(var(--card-h) / -2);
    transition: opacity 0.1s linear;
    cursor: url('/assets/cursors/link.cur') 47 80, pointer;
    cursor: image-set(url('/assets/cursors/link.cur') 2x) 24 40, pointer;
  }

  .coverflow-scene :global([data-post-card][data-near-center]) {
    filter: drop-shadow(0 8px 12px rgb(0 0 0 / 60%));
  }

  @media (prefers-reduced-motion: no-preference) {
    .coverflow-scene :global([data-post-card]) {
      animation: archive-active-breathe 4.8s ease-in-out .5s infinite backwards;
    }

    .coverflow-shell[data-page-hidden] .coverflow-scene :global([data-post-card]) {
      animation-play-state: paused;
    }
  }

  @keyframes archive-active-breathe {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 calc(-11px * var(--center-proximity, 0)); }
  }

  .post-list-instructions {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 1050px) and (min-width: 721px) {
    .coverflow-scene {
      --card-w: calc(100vw - 3rem);
      --card-h: calc(var(--card-w) * .245);
    }
  }

  @media (max-width: 720px) {
    .coverflow-shell {
      min-height: 480px;
    }

    .coverflow-scene {
      --card-w: min(360px, calc(100vw - 2rem));
      --card-h: min(var(--card-w), 350px, calc(100dvh - var(--blog-header-height, 60px) - 5rem));
    }

    .coverflow-rail {
      opacity: .52;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverflow-scene :global([data-post-card]) {
      transition: none;
    }
  }
</style>
