---
import PostCard from '@/components/PostCard.astro';
import type { PostEntry } from '@/lib/content';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<div
  class="coverflow-shell"
  aria-label="文章列表"
  aria-describedby="post-list-instructions"
  tabindex="0"
  data-post-coverflow
>
  <div class="coverflow-scene">
    {posts.map((post, index) => <PostCard post={post} index={index} total={posts.length} />)}
  </div>
</div>
<p id="post-list-instructions" class="post-list-instructions">
  滚动鼠标滚轮、上下滑动或使用上下方向键浏览文章，点击当前卡片进入文章，点击相邻卡片切换文章。
</p>

<script>
  import '@/scripts/post-coverflow';

  const syncBlogMotion = () => {
    document.querySelectorAll<HTMLElement>('[data-post-coverflow]').forEach((rail) => {
      rail.toggleAttribute('data-page-hidden', document.hidden);
    });
  };

  document.addEventListener('visibilitychange', syncBlogMotion);
  document.addEventListener('astro:page-load', syncBlogMotion);
  syncBlogMotion();
</script>

<style>
  /* Fill the viewport below the fixed navigation. */
  .coverflow-shell {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    overflow: visible;
    outline: none;
  }

  .coverflow-shell:focus-visible {
    outline: 2px solid var(--color-copper, #b87333);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .coverflow-scene {
    position: absolute;
    inset: 0;
    perspective: 1400px;
    perspective-origin: 50% 50%;
    overflow: hidden;
  }

  /* Long horizontal cards leave room for the surrounding depth layers. */
  .coverflow-scene :global([data-post-card]) {
    --card-w: min(1120px, calc(100vw - 7rem));
    --card-h: clamp(240px, 31dvh, 270px);
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: center center;
    transform-style: preserve-3d;
    will-change: transform, opacity;
    width: var(--card-w);
    margin-left: calc(var(--card-w) / -2);
    height: var(--card-h);
    margin-top: calc(var(--card-h) / -2);
    transition: opacity 0.1s linear;
    cursor: pointer;
  }

  .coverflow-scene :global([data-post-card][data-active='true']) {
    cursor: default;
  }

  .coverflow-scene :global([data-post-card]) {
    border-color: color-mix(in srgb, var(--color-line-strong), var(--color-accent) calc(var(--center-proximity, 0) * 100%));
  }

  .coverflow-scene :global([data-post-card]::after) {
    position: absolute;
    z-index: 3;
    inset: 0;
    box-shadow: inset 0 0 0 3px rgb(255 210 0 / calc(var(--center-proximity, 0) * .7));
    content: '';
    pointer-events: none;
  }

  .coverflow-scene :global([data-post-card][data-near-center]) {
    filter:
      brightness(var(--post-hover-brightness, 1))
      drop-shadow(0 0 8px rgb(255 210 0 / calc(var(--center-proximity) * .9)))
      drop-shadow(0 0 22px rgb(255 210 0 / calc(var(--center-proximity) * .55)));
  }

  .coverflow-scene :global([data-post-card][data-near-center]:hover) {
    --post-hover-brightness: 1.08;
  }

  .coverflow-scene :global([data-post-card] .post-card-content) {
    position: relative;
    isolation: isolate;
  }

  .coverflow-scene :global([data-post-card] .post-card-content::before) {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(ellipse at 100% 50%, color-mix(in srgb, var(--color-copper) 18%, transparent), transparent 72%);
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  /* The selected card breathes independently of the coverflow's inline transforms. */
  @media (prefers-reduced-motion: no-preference) {
    .coverflow-scene :global([data-post-card]) {
      animation: archive-active-breathe 4.8s ease-in-out .5s infinite backwards;
    }

    .coverflow-scene :global([data-post-card] .post-card-content::before) {
      animation: archive-surface-breathe 4.8s ease-in-out .5s infinite backwards;
    }

    .coverflow-shell[data-page-hidden] .coverflow-scene :global([data-post-card]),
    .coverflow-shell[data-page-hidden] .coverflow-scene :global([data-post-card] .post-card-content::before) {
      animation-play-state: paused;
    }
  }

  @keyframes archive-active-breathe {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 calc(-11px * var(--center-proximity, 0)); }
  }

  @keyframes archive-surface-breathe {
    0%, 100% { opacity: calc(var(--center-proximity, 0) * .2); }
    50% { opacity: calc(var(--center-proximity, 0) * .55); }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverflow-scene :global([data-post-card] .post-card-content::before) {
      opacity: calc(var(--center-proximity, 0) * .3);
    }
  }

  .post-list-instructions {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) and (min-width: 601px) {
    .coverflow-scene :global([data-post-card]) {
      --card-w: calc(100vw - 3rem);
      --card-h: clamp(240px, 29dvh, 260px);
    }
  }

  @media (max-width: 600px) {
    .coverflow-shell {
      min-height: 480px;
    }
    .coverflow-scene :global([data-post-card]) {
      --card-w: calc(100vw - 2rem);
      --card-h: min(350px, calc(100dvh - var(--blog-header-height, 60px) - 5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverflow-scene :global([data-post-card]) {
      transition: none;
    }
  }
</style>
