---
import PostCard from '@/components/PostCard.astro';
import type { PostEntry } from '@/lib/content';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<div
  class="coverflow-shell"
  aria-label="文章列表"
  aria-describedby="post-list-instructions"
  tabindex="0"
  data-post-coverflow
>
  <div class="coverflow-scene">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </div>
</div>
<p id="post-list-instructions" class="post-list-instructions">
  滚动鼠标滚轮或使用方向键浏览文章，点击侧边卡片直接跳转。
</p>

<script>
  import '@/scripts/post-coverflow';
</script>

<style>
  /*
   * Shell fills everything below the compact banner.
   * Banner compact total = --inner-page-banner-height + --header-height.
   */
  .coverflow-shell {
    position: relative;
    width: 100%;
    height: calc(100dvh - var(--inner-page-banner-height, 240px) - var(--header-height, 56px));
    min-height: 400px;
    overflow: visible;
    outline: none;
    cursor: default;
  }

  .coverflow-shell:focus-visible {
    outline: 2px solid var(--color-copper, #b87333);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .coverflow-scene {
    position: absolute;
    inset: 0;
    perspective: 1400px;
    perspective-origin: 50% 50%;
    overflow: hidden;
  }

  /* Active card centred; height fills ~88% of the shell */
  .coverflow-scene :global([data-post-card]) {
    --card-h: clamp(360px, calc((100dvh - var(--inner-page-banner-height, 240px) - var(--header-height, 56px)) * 0.88), 760px);
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: center center;
    transform-style: preserve-3d;
    will-change: transform, opacity;
    width: clamp(280px, 28vw, 420px);
    margin-left: calc(clamp(280px, 28vw, 420px) / -2);
    height: var(--card-h);
    margin-top: calc(var(--card-h) / -2);
    transition: opacity 0.1s linear;
    cursor: pointer;
  }

  .coverflow-scene :global([data-post-card][data-active='true']) {
    cursor: default;
  }

  .post-list-instructions {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .coverflow-shell {
      min-height: 360px;
    }
    .coverflow-scene :global([data-post-card]) {
      width: clamp(200px, 70vw, 300px);
      margin-left: calc(clamp(200px, 70vw, 300px) / -2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverflow-scene :global([data-post-card]) {
      transition: none;
    }
  }
</style>
