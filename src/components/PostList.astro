---
import PostCard from '@/components/PostCard.astro';
import type { PostEntry } from '@/lib/content';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<div
  class="coverflow-shell"
  aria-label="文章列表"
  aria-describedby="post-list-instructions"
  tabindex="0"
  data-post-coverflow
>
  <div class="coverflow-scene">
    {posts.map((post, index) => <PostCard post={post} index={index} total={posts.length} />)}
  </div>
</div>
<p id="post-list-instructions" class="post-list-instructions">
  滚动鼠标滚轮、上下滑动或使用上下方向键浏览文章，点击当前卡片进入文章，点击相邻卡片切换文章。
</p>

<script>
  import '@/scripts/post-coverflow';
</script>

<style>
  /* Fill the viewport below the fixed navigation. */
  .coverflow-shell {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    overflow: visible;
    outline: none;
  }

  .coverflow-shell:focus-visible {
    outline: 2px solid var(--color-copper, #b87333);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .coverflow-scene {
    position: absolute;
    inset: 0;
    perspective: 1400px;
    perspective-origin: 50% 50%;
    overflow: hidden;
  }

  /* Long horizontal cards leave room for the surrounding depth layers. */
  .coverflow-scene :global([data-post-card]) {
    --card-w: min(1120px, calc(100vw - 7rem));
    --card-h: clamp(240px, 31dvh, 270px);
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: center center;
    transform-style: preserve-3d;
    will-change: transform, opacity;
    width: var(--card-w);
    margin-left: calc(var(--card-w) / -2);
    height: var(--card-h);
    margin-top: calc(var(--card-h) / -2);
    transition: opacity 0.1s linear;
    cursor: pointer;
  }

  .coverflow-scene :global([data-post-card][data-active='true']) {
    cursor: default;
  }

  .post-list-instructions {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) and (min-width: 601px) {
    .coverflow-scene :global([data-post-card]) {
      --card-w: calc(100vw - 3rem);
      --card-h: clamp(240px, 29dvh, 260px);
    }
  }

  @media (max-width: 600px) {
    .coverflow-shell {
      min-height: 480px;
    }
    .coverflow-scene :global([data-post-card]) {
      --card-w: calc(100vw - 2rem);
      --card-h: min(350px, calc(100dvh - var(--blog-header-height, 60px) - 5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverflow-scene :global([data-post-card]) {
      transition: none;
    }
  }
</style>
