---
interface Props {
  id: 'rss' | 'github' | 'bilibili' | 'zhihu' | 'xiaohongshu' | 'wechat' | 'qqmusic' | 'email';
}

const { id } = Astro.props;
---

<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {id === 'rss' && (
    <>
      <circle cx="5" cy="19" r="2" fill="currentColor" />
      <path d="M4 11a9 9 0 0 1 9 9M4 5a15 15 0 0 1 15 15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
    </>
  )}
  {id === 'github' && (
    <path fill="currentColor" d="M12 2.2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.72a9.5 9.5 0 0 1 2.5.34c1.92-1.3 2.76-1.03 2.76-1.03.54 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v3.07c0 .27.18.58.69.48A10 10 0 0 0 12 2.2Z" />
  )}
  {id === 'bilibili' && (
    <>
      <path d="m8 5-2-2m10 2 2-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <rect x="3" y="6" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="9" cy="13" r="1.3" fill="currentColor" />
      <circle cx="15" cy="13" r="1.3" fill="currentColor" />
    </>
  )}
  {id === 'zhihu' && <text x="12" y="17" text-anchor="middle" font-size="14" font-weight="800" fill="currentColor">知</text>}
  {id === 'xiaohongshu' && <text x="12" y="17" text-anchor="middle" font-size="14" font-weight="800" fill="currentColor">红</text>}
  {id === 'wechat' && (
    <>
      <path d="M3 9.5c0-3 3-5.5 6.7-5.5s6.7 2.5 6.7 5.5-3 5.5-6.7 5.5c-.7 0-1.4-.1-2-.3L4.5 16l.8-2.5A5.2 5.2 0 0 1 3 9.5Z" fill="currentColor" />
      <path d="M10.5 14.2c0-2.5 2.4-4.5 5.3-4.5s5.2 2 5.2 4.5-2.3 4.5-5.2 4.5c-.6 0-1.1-.1-1.6-.2l-2.5 1 .6-2a4.3 4.3 0 0 1-1.8-3.3Z" fill="currentColor" stroke="var(--color-surface)" stroke-width="1.2" />
    </>
  )}
  {id === 'qqmusic' && <path fill="currentColor" d="M15 3v11.1a4.5 4.5 0 1 1-2-3.74V6.2l8-2V11a4.5 4.5 0 1 1-2-3.74V2.5L15 3Zm-6.5 15a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm6.5-9.5 4-1V6.56l-4 1V8.5ZM17.5 15a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z" />}
  {id === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    </>
  )}
</svg>
