---
import { SITE } from '@/config/site';
import '@/styles/twikoo.css';

interface Props {
  title?: string;
  variant?: 'default' | 'guestbook';
  path?: string;
}

const { title = '评论', variant = 'default', path = Astro.url.pathname } = Astro.props;
---

<section
  class="comments twikoo-comments"
  aria-label={title}
  data-twikoo-comments
  data-twikoo-env-id={SITE.twikoo.envId}
  data-twikoo-path={path}
  data-twikoo-variant={variant}
>
  <p class="comments-status" role="status" data-twikoo-status>评论正在加载…</p>
  <div id="tcomment" data-twikoo-root></div>
  <noscript>评论需要 JavaScript。</noscript>
</section>

<style>
  .comments {
    margin-top: 2.5rem;
  }

  .comments-status,
  noscript {
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }
</style>
