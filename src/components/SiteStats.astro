---
import { formatClockTime } from '@/lib/dot-clock';
import { formatSiteDate, runningDaysAt, type BuiltSiteStats } from '@/lib/site-stats';

interface Props {
  stats: BuiltSiteStats;
}

const { stats } = Astro.props;
const now = new Date();
const clockText = formatClockTime(now);
---

<section class="site-stats" aria-labelledby="site-stats-heading" data-site-stats>
  <h2 id="site-stats-heading">站点统计</h2>
  <dl>
    <div><dt>文章</dt><dd data-stat="posts">{stats.postCount}</dd></div>
    <div><dt>字数</dt><dd data-stat="words">{stats.wordCount.toLocaleString('zh-CN')}</dd></div>
    <div><dt>运行天数</dt><dd data-stat="running-days">{runningDaysAt(now)}</dd></div>
    <div><dt>访客</dt><dd data-stat="visitors">—</dd></div>
  </dl>
  <p>
    最后更新
    <time datetime={stats.lastUpdated.toISOString()} data-stat="last-updated">
      {formatSiteDate(stats.lastUpdated)}
    </time>
  </p>
  <div class="clock" aria-label="当前时间">
    <time datetime={now.toISOString()} data-clock-text>{clockText}</time>
    <canvas width="240" height="56" data-dot-clock aria-hidden="true"></canvas>
  </div>
</section>

<style>
  .site-stats {
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.1rem 1.2rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);
  }

  h2 {
    margin: 0 0 0.9rem;
    color: var(--color-heading, var(--color-text));
    font-size: 1rem;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  dl div {
    min-width: 0;
  }

  dt,
  p {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  dd {
    margin: 0.1rem 0 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  p {
    margin: 0.9rem 0 0;
  }

  p time {
    margin-left: 0.35rem;
    color: var(--color-text);
  }

  .clock {
    position: relative;
    min-height: 56px;
    margin-top: 0.75rem;
  }

  [data-clock-text] {
    position: absolute;
    inset: 50% auto auto 50%;
    color: var(--color-accent);
    font: 700 1.15rem/1 ui-monospace, SFMono-Regular, Consolas, monospace;
    transform: translate(-50%, -50%);
  }

  canvas {
    display: block;
    width: 100%;
    height: 56px;
  }
</style>
