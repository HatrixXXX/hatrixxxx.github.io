---
import PostLink from '@/components/PostLink.astro';
import type { ArchiveMonth } from '@/lib/content';

interface Props {
  archives: ArchiveMonth[];
}

const { archives } = Astro.props;
---

<div class="archive-groups">
  {archives.map((archive) => (
    <section class="archive-month">
      <h2>{archive.year} 年 {archive.month} 月</h2>
      <ul>
        {archive.posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.getDate()} 日</time>
            <PostLink post={post} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .archive-groups {
    min-width: 0;
  }

  .archive-month {
    position: relative;
    margin-bottom: 1.1rem;
    border: 1px solid var(--chassis-edge);
    border-radius: 3px;
    padding: 1.15rem clamp(1rem, 3vw, 1.6rem) 1.35rem;
    background: linear-gradient(120deg, rgb(0 221 235 / 5%), transparent 44%), var(--color-surface);
    box-shadow: inset 0 0 0 4px var(--chassis-groove), 0 12px 25px rgb(4 5 10 / 20%);
  }

  .archive-month::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    width: min(35%, 180px);
    height: 2px;
    background: linear-gradient(90deg, var(--color-copper), var(--color-accent), transparent);
  }

  .archive-month::after {
    content: '';
    position: absolute;
    top: 1.35rem;
    right: 1.35rem;
    width: 7px;
    height: 7px;
    border: 1px solid var(--color-link);
    background: rgb(0 221 235 / 35%);
    box-shadow: 0 0 0 3px var(--chassis-groove);
  }

  .archive-month:last-child {
    margin-bottom: 0;
  }

  h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: 1.25rem;
    font-weight: 650;
  }

  ul {
    display: grid;
    gap: 0.6rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    min-width: 0;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.55rem;
  }

  li:last-child { border-bottom: 0; padding-bottom: 0; }

  time {
    flex: none;
    color: var(--color-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-groups :global(a) {
    overflow-wrap: anywhere;
  }

  .archive-groups :global(a:hover) {
    color: var(--color-link);
  }
</style>
