---
import type { CollectionEntry } from 'astro:content';
import ProjectArtwork from '@/components/ProjectArtwork.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const groups = Array.from({ length: Math.ceil(projects.length / 6) }, (_, page) => projects.slice(page * 6, page * 6 + 6));
---

<main class="project-showcase" data-project-showcase data-selected="0" data-mobile-view="catalog" aria-label="作品橱窗">
  <h1 class="visually-hidden">作品橱窗</h1>
  <div class="showcase-viewport">
    <div class="showcase-window" data-showcase-window>
      <span class="showcase-crest" data-showcase-crest aria-hidden="true"><img src="/assets/projects/project-showcase-crest.webp" width="220" height="220" alt="" /></span>
      <section class="showcase-catalog" data-catalog-panel aria-label="选择作品">
          {groups.length === 0 && <p class="showcase-empty">作品待加入。</p>}
          {groups.map((group, page) => (
            <div class="showcase-badge-grid" data-catalog-page={page} hidden={page !== 0}>
              {group.map((project, slot) => {
                const index = page * 6 + slot;
                return (
                  <button class="showcase-badge" type="button" data-project-badge={index} data-badge-theme={project.data.theme} aria-pressed={index === 0 ? 'true' : 'false'}>
                    <span class="showcase-badge-crown" aria-hidden="true"></span>
                    <span class="showcase-badge-art">
                      {project.data.cover ? <img src={project.data.cover} alt="" loading="lazy" decoding="async" /> : <ProjectArtwork theme={project.data.theme} />}
                    </span>
                    <span class="showcase-badge-name">{project.data.title}</span>
                    <span class="showcase-badge-medallion" aria-hidden="true"></span>
                  </button>
                );
              })}
              {Array.from({ length: 6 - group.length }, () => <span class="showcase-empty-mount" data-empty-mount aria-hidden="true"><span></span></span>)}
            </div>
          ))}
          {groups.length > 1 && (
            <div class="showcase-catalog-pagination">
              <button type="button" data-catalog-prev aria-label="上一组作品">‹</button>
              <span data-catalog-count>1 / {groups.length}</span>
              <button type="button" data-catalog-next aria-label="下一组作品">›</button>
            </div>
          )}
      </section>
      <section class="showcase-detail-shell" data-detail-panel aria-label="作品详情">
        {projects.map((project, index) => {
          const { title, description, category, theme, cover, coverAlt, experience, moment } = project.data;
          const gallery = project.data.gallery as { src: string; alt: string; caption?: string }[];
          const tags = project.data.tags as string[];
          const tech = project.data.tech as string[];
          const links = project.data.links as { label: string; url: string }[];
          const slideCount = gallery.length + 1;
          return (
            <article class="showcase-detail" data-project-detail={index} data-project-theme={theme} hidden={index !== 0}>
              <div class="showcase-detail-top">
                <button type="button" class="showcase-back-catalog" data-back-catalog aria-label="返回作品展位">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m13 5-7 7 7 7M6 12h13" /></svg>
                </button>
              </div>
              <div class="showcase-detail-scroll" data-detail-scroll data-lenis-prevent>
                <div class="showcase-media" data-carousel data-slide-count={slideCount}>
                  <div class="showcase-carousel-viewport" tabindex="0" role="region" aria-label={title + '图片展示'} data-carousel-viewport data-lenis-prevent-horizontal>
                    <div class="showcase-carousel-track" data-carousel-track>
                      <figure class="showcase-slide" data-carousel-slide>
                        {cover ? <img src={cover} alt={coverAlt || title + '的概念封面'} loading="lazy" decoding="async" /> : <ProjectArtwork theme={theme} />}
                        {!cover && <figcaption>概念封面 · 实际照片待补充</figcaption>}
                      </figure>
                      {gallery.map((photo) => (
                        <figure class="showcase-slide" data-carousel-slide>
                          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                          {photo.caption && <figcaption>{photo.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  </div>
                  {slideCount > 1 && (
                    <div class="showcase-carousel-controls">
                      <button type="button" data-carousel-prev aria-label="上一张图片"><span aria-hidden="true">‹</span></button>
                      <span data-carousel-counter>01 / {String(slideCount).padStart(2, '0')}</span>
                      <button type="button" data-carousel-next aria-label="下一张图片"><span aria-hidden="true">›</span></button>
                    </div>
                  )}
                </div>
                <div class="showcase-copy">
                  <h2>{title}</h2>
                  <div class="showcase-tags" aria-label="作品标签">
                    <span>{category}</span>
                    {tags.map((tag) => <span>{tag}</span>)}
                  </div>
                  <p class="showcase-description">{description}</p>
                  <div class="showcase-story">
                    <section><h3>制作经历</h3><p>{experience || '制作经历待补充。'}</p></section>
                    <section><h3>过程趣事</h3><p>{moment || '过程趣事待补充。'}</p></section>
                  </div>
                  {tech.length > 0 && <div class="showcase-tech" aria-label="相关技术">{tech.map((item) => <span>{item}</span>)}</div>}
                  {links.length > 0 && <div class="showcase-links">{links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
                </div>
              </div>
            </article>
          );
        })}
      </section>

    </div>
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-showcase-status>当前作品：{projects[0]?.data.title || '暂无作品'}</p>
  <noscript>
    <div class="showcase-nojs">
      {projects.map((project) => <section><h2>{project.data.title}</h2><p>{project.data.description}</p></section>)}
    </div>
  </noscript>
</main>
