---
import type { CollectionEntry } from 'astro:content';
import ProjectArtwork from '@/components/ProjectArtwork.astro';
import { previewDescription } from '@/lib/project-showcase';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const shelfCapacity = 5;
const shelves = Array.from({ length: Math.ceil(projects.length / shelfCapacity) }, (_, shelf) =>
  projects.slice(shelf * shelfCapacity, (shelf + 1) * shelfCapacity)
);
const jarSpecimenIds = new Set([
  'fpga-3dgs', 'robomaster', 'quadrotor', 'car-series', 'lab-wall',
  'armor-keychain', 'wheel-leg-keychain', 'rm-ruler', 'three-year-summary', 'conet',
  'infantry-handbook', 'painted-mouse', 'paper-models', 'personal-website', 'usb3-hub'
]);
const compactJarSpecimenIds = new Set([
  'armor-keychain', 'car-series', 'wheel-leg-keychain', 'rm-ruler', 'three-year-summary',
  'conet', 'infantry-handbook', 'paper-models', 'personal-website', 'usb3-hub'
]);
const jarImageFor = (project: CollectionEntry<'projects'>) =>
  jarSpecimenIds.has(project.id) ? `/assets/project-jar-specimens/${project.id}.webp` : project.data.cover;
---

<main class="project-showcase" data-project-showcase data-selected="0" aria-label="作品橱窗">
  <h1 class="visually-hidden">作品橱窗</h1>
  <div class="showcase-viewport">
    <div class="showcase-window" data-showcase-window>
      <section class="showcase-catalog" data-catalog-panel aria-label="作品展位">
          {shelves.map((shelf, shelfIndex) => (
            <div class="showcase-shelf-scroll">
            <section class="showcase-badge-grid" data-project-shelf aria-label={`第${shelfIndex + 1}层作品平台`}>
              <img class="showcase-shelf" src="/assets/projects/project-cabinet-shelf.webp" width="1600" height="247" alt="" aria-hidden="true" draggable="false" />
              {shelf.map((project, slot) => {
                const index = shelfIndex * shelfCapacity + slot;
                const jarImage = jarImageFor(project);
                return (
                  <button class="showcase-badge" type="button" data-project-badge={index} data-badge-theme={project.data.theme} aria-pressed={index === 0 ? 'true' : 'false'}>
                    <span class="showcase-vessel" data-compact-art={compactJarSpecimenIds.has(project.id) ? '' : undefined} aria-hidden="true">
                      <span class="showcase-badge-art">
                        {jarImage ? <img src={jarImage} alt="" loading="lazy" decoding="async" draggable="false" /> : <ProjectArtwork theme={project.data.theme} />}
                      </span>
                      <img class="showcase-jar" src="/assets/projects/project-cabinet-jar.webp" width="320" height="572" alt="" draggable="false" />
                    </span>
                    <span class="showcase-badge-name">{project.data.title}</span>
                  </button>
                );
              })}
            </section>
            </div>
          ))}
      </section>
      <dialog class="showcase-detail-shell" data-detail-panel data-project-dialog aria-label="作品详情" tabindex="-1">
        {projects.map((project, index) => {
          const { title, description, theme, cover, coverAlt } = project.data;
          const jarImage = jarImageFor(project);
          const gallery = project.data.gallery as { src: string; alt: string; caption?: string }[];
          const slideCount = gallery.length + (cover || gallery.length === 0 ? 1 : 0);
          return (
            <article class="showcase-detail" data-project-detail={index} data-project-theme={theme} hidden={index !== 0}>
              <div class="showcase-expanded-vessel" data-expanded-vessel data-compact-art={compactJarSpecimenIds.has(project.id) ? '' : undefined} aria-hidden="true">
                <span class="showcase-expanded-art">
                  {jarImage ? <img src={jarImage} alt="" loading="lazy" decoding="async" draggable="false" /> : <ProjectArtwork theme={theme} />}
                </span>
                <img class="showcase-expanded-jar" src="/assets/projects/project-cabinet-jar.webp" width="320" height="572" alt="" draggable="false" />
                <span class="showcase-expanded-name">{title}</span>
              </div>
              <div class="showcase-info-card" data-info-card>
                <div class="showcase-info-image" data-project-carousel data-slide-count={slideCount}>
                  <div class="showcase-carousel-viewport" data-carousel-viewport tabindex={slideCount > 1 ? 0 : undefined} role="region" aria-label={`${title}图片展示`}>
                    <div class="showcase-carousel-track" data-carousel-track>
                      {(cover || gallery.length === 0) && (
                        <figure class="showcase-carousel-slide" data-carousel-slide>
                          {cover ? <img src={cover} alt={coverAlt || title} loading="lazy" decoding="async" draggable="false" /> : <ProjectArtwork theme={theme} />}
                          {!cover && <figcaption>概念封面 · 实际照片待补充</figcaption>}
                        </figure>
                      )}
                      {gallery.map((photo) => (
                        <figure class="showcase-carousel-slide" data-carousel-slide>
                          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" draggable="false" />
                          {photo.caption && <figcaption>{photo.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  </div>
                  {slideCount > 1 && <span class="visually-hidden" data-carousel-counter aria-live="polite">01 / {String(slideCount).padStart(2, '0')}</span>}
                </div>
                <p data-project-intro>{previewDescription(description)}</p>
              </div>
            </article>
          );
        })}
      </dialog>

    </div>
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-showcase-status>当前作品：{projects[0]?.data.title || '暂无作品'}</p>
  <noscript>
    <div class="showcase-nojs">
      {projects.map((project) => <section><h2>{project.data.title}</h2><p>{project.data.description}</p></section>)}
    </div>
  </noscript>
</main>
