---
interface Props {
  direction?: 'top' | 'bottom';
}

const { direction = 'top' } = Astro.props;
---

<button class="back-to-top" type="button" aria-label={direction === 'top' ? '回到顶部' : '去往底部'} aria-hidden="true" inert data-back-to-top={direction === 'top' ? '' : undefined} data-back-to-bottom={direction === 'bottom' ? '' : undefined}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m6 10 6-6 6 6M12 4v16" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    z-index: 30;
    right: max(5rem, env(safe-area-inset-right));
    bottom: max(5rem, env(safe-area-inset-bottom));
    display: grid;
    width: 5.5rem;
    height: 5.5rem;
    place-items: center;
    border: 1px solid var(--color-copper);
    padding: 0;
    isolation: isolate;
    clip-path: polygon(0 18px, 18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%);
    background: linear-gradient(145deg, var(--color-surface-raised), var(--color-inset));
    box-shadow: inset 0 0 0 4px rgb(0 0 0 / 22%);
    color: var(--color-accent);
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(.96);
    transition:
      opacity 170ms ease-in,
      transform 170ms ease-in,
      visibility 0s linear 170ms,
      color 160ms ease,
      filter 160ms ease;
  }

  .back-to-top::before,
  .back-to-top::after {
    position: absolute;
    pointer-events: none;
    content: '';
  }

  .back-to-top::before {
    inset: 10px;
    border: 1px solid rgb(216 140 60 / 42%);
    clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
  }

  .back-to-top::after {
    top: 10px;
    right: 10px;
    width: 10px;
    height: 6px;
    background: var(--color-link);
    box-shadow: 0 0 7px var(--color-link);
  }

  .back-to-top[data-visible='true'] {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 240ms cubic-bezier(.16, 1, .3, 1),
      transform 240ms cubic-bezier(.16, 1, .3, 1),
      visibility 0s,
      color 160ms ease,
      filter 160ms ease;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    border-color: var(--color-copper);
    color: var(--color-accent-strong);
    transform: translateY(-2px);
    filter: brightness(1.18);
  }

  .back-to-top:focus-visible {
    box-shadow: inset 0 0 0 3px var(--color-link);
  }

  .back-to-top:active {
    transform: translateY(-3px) scale(.96);
    filter: brightness(1.35);
  }

  .back-to-top svg {
    width: 46px;
    height: 46px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-to-top[data-back-to-bottom] svg {
    transform: rotate(180deg);
  }

  .back-to-top[data-back-to-top] {
    bottom: calc(max(5rem, env(safe-area-inset-bottom)) + 6.5rem);
  }

  @media (max-width: 1199px) {
    .back-to-top {
      right: max(2.5rem, env(safe-area-inset-right));
      bottom: max(2.5rem, env(safe-area-inset-bottom));
    }

    .back-to-top[data-back-to-top] {
      bottom: calc(max(2.5rem, env(safe-area-inset-bottom)) + 6.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
