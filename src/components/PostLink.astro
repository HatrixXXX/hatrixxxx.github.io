---
import type { PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

interface Props {
  post: PostEntry;
  rel?: string;
  direction?: string;
  [attribute: string]: unknown;
}

const { post, rel, direction, ...attributes } = Astro.props;
---

<a
  {...attributes}
  href={postPath(post.data.legacySlug)}
  rel={rel}
>
  {
    direction ? (
      <>
        <span>{direction}</span>
        <strong>{post.data.title}</strong>
      </>
    ) : (
      <>{post.data.title}</>
    )
  }
</a>
