---
import { getCollection } from 'astro:content';
import LockIndicator from '@/components/LockIndicator.astro';
import { SITE } from '@/config/site';
import { sortPosts, type PostEntry } from '@/lib/content';
import { postPath } from '@/lib/urls';

const year = new Date().getFullYear();
const posts = sortPosts(await getCollection('posts', ({ data }: PostEntry) => !data.draft));
const newestPosts = posts.slice(0, 10);
const isPlaywrightTest = process.env.PLAYWRIGHT_TEST === '1';
const buildDate = isPlaywrightTest ? 'playwright-fixed' : new Date().toISOString().slice(0, 10);
let seed = 0;
for (const character of buildDate) seed = (seed * 31 + character.charCodeAt(0)) >>> 0;
const shuffledPosts = [...posts];
for (let index = shuffledPosts.length - 1; index > 0; index -= 1) {
  seed = (seed * 1664525 + 1013904223) >>> 0;
  const target = seed % (index + 1);
  [shuffledPosts[index], shuffledPosts[target]] = [shuffledPosts[target], shuffledPosts[index]];
}
const randomPosts = shuffledPosts.slice(0, 10);
---

<footer data-site-footer class="site-footer">
  <div class="footer-inner container">
    <div class="identity">
      <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="56" height="56" loading="lazy" />
      <div>
        <strong>{SITE.title}</strong>
        <p>{SITE.description}</p>
      </div>
    </div>

    <section
      aria-labelledby="footer-random-heading"
      data-footer-random
      data-test-seed={isPlaywrightTest ? buildDate : undefined}
    >
      <h2 id="footer-random-heading">随机文章</h2>
      <ul>
        {randomPosts.map((post) => (
          <li>
            <a
              href={postPath(post.data.legacySlug)}
              data-locked-link={post.data.locked ? '' : undefined}
            >
              {post.data.title}{post.data.locked && <LockIndicator />}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="footer-newest-heading">
      <h2 id="footer-newest-heading">最近更新</h2>
      <ul>
        {newestPosts.map((post) => (
          <li>
            <a
              href={postPath(post.data.legacySlug)}
              data-locked-link={post.data.locked ? '' : undefined}
            >
              {post.data.title}{post.data.locked && <LockIndicator />}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="footer-base">
      <nav aria-label="社交链接">
        {SITE.socials.map((social) => (
          <a href={social.url} target="_blank" rel="me noreferrer">{social.label}</a>
        ))}
      </nav>
      <small>© {year} {SITE.author.name}</small>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }

  .identity {
    display: flex;
    min-width: 0;
    align-items: center;
    align-self: start;
    gap: 0.85rem;
  }

  .identity img {
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
  }

  strong,
  h2 {
    color: var(--color-text);
  }

  .identity p {
    margin: 0.15rem 0 0;
    font-size: 0.84rem;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
  }

  ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  li a {
    display: block;
    overflow: hidden;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a {
    transition: color 160ms ease;
  }

  a:hover {
    color: var(--color-accent);
  }

  .footer-base {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  nav a,
  small {
    font-size: 0.8rem;
  }

  small {
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .identity {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .identity,
    .footer-base {
      grid-column: 1;
    }

    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
