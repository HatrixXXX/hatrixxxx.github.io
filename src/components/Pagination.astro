---
interface Props {
  current: number;
  total: number;
  basePath: string;
}

const { current, total, basePath } = Astro.props;
const pages = Array.from({ length: total }, (_, index) => index + 1);
const hrefFor = (page: number) => (page === 1 ? '/' : `${basePath}${page}/`);
---

{total > 1 && (
  <nav class="pagination" aria-label="文章分页">
    {current > 1 && <a class="pagination-step" href={hrefFor(current - 1)} rel="prev">上一页</a>}
    <div class="pagination-pages">
      {pages.map((page) => (
        page === current
          ? <span aria-current="page">{page}</span>
          : <a href={hrefFor(page)}>{page}</a>
      ))}
    </div>
    {current < total && <a class="pagination-step" href={hrefFor(current + 1)} rel="next">下一页</a>}
  </nav>
)}

<style>
  .pagination,
  .pagination-pages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .pagination {
    flex-wrap: wrap;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  a,
  span {
    display: grid;
    min-width: 2.4rem;
    min-height: 2.4rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    background: var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset);
    color: var(--color-text);
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  a:hover {
    border-color: var(--color-line-strong);
    background-color: var(--color-surface-raised);
    color: var(--color-link);
  }

  span[aria-current='page'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: 700;
  }

  .pagination-step {
    padding-inline: 1rem;
  }

  @media (max-width: 520px) {
    .pagination {
      gap: 0.75rem;
    }

    .pagination-pages {
      order: -1;
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>
