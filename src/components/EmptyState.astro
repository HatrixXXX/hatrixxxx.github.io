---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="empty-state" aria-live="polite">
  <svg class="empty-state-core" viewBox="0 0 128 88" fill="none" aria-hidden="true" focusable="false">
    <path d="M5 20h27l13 13-9 9 9 9-13 13H5l15-22L5 20Zm118 0H96L83 33l9 9-9 9 13 13h27l-15-22 15-22Z" fill="currentColor" fill-opacity=".12" stroke="currentColor" />
    <path d="M22 28h11m-11 28h11m73-28H95m11 28H95" stroke="currentColor" stroke-width="2" />
    <path d="m64 6 25 14 8 22-8 22-25 14-25-14-8-22 8-22L64 6Z" stroke="var(--color-copper)" stroke-width="2" />
    <path d="m64 18 18 10 5 14-5 14-18 10-18-10-5-14 5-14 18-10Z" fill="var(--color-inset)" stroke="var(--color-line-strong)" />
    <path d="M52 42h24M64 30v24" stroke="var(--color-link)" stroke-width="2" stroke-linecap="square" />
    <circle cx="64" cy="42" r="5" fill="var(--color-accent)" />
  </svg>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</section>

<style>
  .empty-state {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    clip-path: polygon(0 18px, 18px 0, calc(100% - 18px) 0, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 0 calc(100% - 18px));
    padding: clamp(2rem, 6vw, 3.5rem) 1.5rem;
    background:
      linear-gradient(135deg, transparent 44%, rgb(0 221 235 / 7%) 44.3%, transparent 45%) right top / 42% 100% no-repeat,
      repeating-linear-gradient(0deg, transparent 0 16px, rgb(190 174 204 / 4%) 16px 17px),
      var(--surface-sheen), var(--color-surface);
    box-shadow: var(--shadow-inset), inset 0 0 0 6px rgb(10 8 14 / 22%);
    text-align: center;
  }

  .empty-state::before,
  .empty-state::after {
    position: absolute;
    z-index: -1;
    content: '';
    pointer-events: none;
  }

  .empty-state::before {
    inset: 10px;
    border: 1px solid rgb(216 140 60 / 35%);
    clip-path: polygon(0 12px, 12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px));
  }

  .empty-state::after {
    top: 14px;
    right: 24px;
    width: 56px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-copper) 0 35%, transparent 35% 47%, var(--color-link) 47% 58%, transparent 58% 70%, var(--color-copper) 70%);
    box-shadow: 0 0 12px rgb(0 221 235 / 20%);
  }

  .empty-state-core {
    display: block;
    width: 128px;
    max-width: 50%;
    height: 88px;
    margin: 0 auto 1.25rem;
    color: var(--color-line-strong);
    filter: drop-shadow(0 8px 12px rgb(0 0 0 / 28%));
  }

  h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    font-weight: 600;
    line-height: 1.4;
  }

  p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
  }
</style>
