{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/**/*.astro",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "astro.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "_data",
    "_draft",
    "_includes",
    "_javascript",
    "_layouts",
    "_plugins",
    "_posts",
    "_sass",
    "_tabs",
    "assets",
    "purgecss.js",
    "rollup.config.js"
  ]
}
