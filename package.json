{
  "name": "hatrix-blog",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "corepack pnpm check:images && cross-env NODE_USE_ENV_PROXY=1 astro build && corepack pnpm check:protected",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "check:images": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/check-images.ts",
    "check:site": "tsx scripts/check-built-site.ts",
    "check:protected": "tsx scripts/check-protected-output.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "css-tree": "3.2.1",
    "gray-matter": "^4.0.3",
    "hash-wasm": "4.12.0",
    "katex": "^0.18.4",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "parse5": "7.3.0",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sakana": "1.0.8",
    "sharp": "^0.35.4",
    "srcset": "5.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
